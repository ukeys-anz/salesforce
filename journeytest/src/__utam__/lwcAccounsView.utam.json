{
  "root": true,
  "selector": {
    "css": "body"
  },
  "elements": [
    {
      "name": "selectAccountFiler",
      "selector": {
        "css": "button[title='Select a List View']"
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "inputAccountName",
      "selector": {
        "css": "div input[name='Account-search-input']"
      },
      "public": true,
      "type": "editable"
    },
    {
      "name": "refreshAccount",
      "selector": {
        "css": "button[name='refreshButton']"
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "selectElements",
      "selector": {
        "css": "ul[aria-label] li",
        "returnAll": true
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "listView",
      "selector": {
        "css": "div[class='listContent']"
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "accountItem",
      "selector": {
        "css": "table tbody tr th a[title='%s']",
        "args": [
          {
            "name": "accname",
            "type": "string"
          }
        ]
      },
      "public": true,
      "type": "clickable"
    }
  ]
}
