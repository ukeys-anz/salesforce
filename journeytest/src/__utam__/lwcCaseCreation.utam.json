{
  "root": true,
  "selector": {
    "css": "body"
  },
  "elements": [
    {
      "name": "newCase",
      "selector": {
        "css": "a div[title='New']"
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "selectElements",
      "selector": {
        "css": "div a[class='select']",
        "returnAll": true
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "generalEnquiryChk",
      "selector": {
        "css": "input[name='General_Inquiry']"
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "nextButton",
      "selector": {
        "css": "footer button:nth-of-type(2)"
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "channelReceived",
      "selector": {
        "css": "a[class='select']:nth-of-type(2)"
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "tabItem",
      "selector": {
        "css": "li[class='tabItem'] button:nth-of-type(%d)",
        "args": [
          {
            "name": "index",
            "type": "number"
          }
        ]
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "customerDropDown",
      "selector": {
        "css": "li div[title='%s']",
        "args": [
          {
            "name": "customerName",
            "type": "string"
          }
        ]
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "valueDropDown",
      "selector": {
        "css": "li a[title='%s']",
        "args": [
          {
            "name": "itemValue",
            "type": "string"
          }
        ]
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "dualListLeft",
      "selector": {
        "css": "div span[title='%s']",
        "args": [
          {
            "name": "itemValue",
            "type": "string"
          }
        ]
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "dualListLeftItems",
      "selector": {
        "css": "li[lightning-duallistbox_duallistbox]",
        "returnAll": true
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "moveChosen",
      "selector": {
        "css": "button[title='Move selection to Chosen']"
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "saveCase",
      "selector": {
        "css": "button[title='Save']"
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "customerInput",
      "selector": {
        "css": "input[title='Search Accounts']"
      },
      "public": true,
      "type": "editable"
    }
  ]
}
