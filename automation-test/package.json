{
  "name": "salesforce",
  "version": "1.0.1",
  "description": "Salesforce development project - Automation Test",
  "scripts": {
    "delete-cache": "rm -rf ./all-logs & rm -rf ./allure-results",
    "test": "yarn delete-cache & npx wdio wdio.conf.js",
    "result": "yarn result:generate && yarn result:open",
    "result:generate": "npx allure generate allure-results --clean",
    "result:open": "npx allure open",
    "build": "yarn build:utam && rm -rf ./build && yarn build:ts",
    "build:ts": "tsc -b tsconfig.json && prettier --write './src/**/*.{ts,js,json}'",
    "build:utam": "rm -rf ./pageObjects && utam -c utam.config.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.anz/anzx/salesforce.git"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babel/cli": "^7.14.5",
    "@babel/core": "^7.14.6",
    "@babel/eslint-parser": "^7.14.7",
    "@babel/preset-env": "^7.14.7",
    "@babel/register": "^7.14.5",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/faker": "^5.5.7",
    "@types/jsforce": "~1.9.33",
    "@types/mocha": "^9.1.1",
    "@types/node": "^17.0.36",
    "@typescript-eslint/eslint-plugin": "^4.28.3",
    "@typescript-eslint/parser": "^4.28.3",
    "@wdio/allure-reporter": "^7.7.6",
    "@wdio/cli": "^7.20.5",
    "@wdio/local-runner": "^7.16.15",
    "@wdio/mocha-framework": "^7.16.15",
    "@wdio/selenium-standalone-service": "^7.7.4",
    "@wdio/spec-reporter": "^7.16.14",
    "allure-commandline": "^2.13.8",
    "dotenv": "^16.0.0",
    "eslint": "^7.30.0",
    "expect-webdriverio": "^3.1.0",
    "faker": "^5.5.3",
    "global-agent": "^3.0.0",
    "jsforce": "^2.0.0-beta.8",
    "mochawesome": "^6.2.2",
    "prettier": "^2.2.1",
    "salesforce-pageobjects": "^1.1.0",
    "selenium-webdriver": "^4.0.0-beta.4",
    "ts-node": "^10.8.0",
    "tsconfig-paths": "^4.0.0",
    "tsify": "^5.0.4",
    "typescript": "^4.6.3",
    "utam": "^1.0.4",
    "wdio-chromedriver-service": "7.2.8",
    "wdio-utam-service": "^1.0.4",
    "wdio-video-reporter": "~3.1.2",
    "wdio-wait-for": "^2.2.1",
    "webdriverio": "^7.19.7"
  }
}
