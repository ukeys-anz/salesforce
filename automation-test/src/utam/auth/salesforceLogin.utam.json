{
  "root": true,
  "selector": {
    "css": "body"
  },
  "elements": [
    {
      "name": "username",
      "selector": {
        "css": "[id='username']"
      },
      "public": true,
      "type": ["editable"]
    },
    {
      "name": "password",
      "selector": {
        "css": "[id='password']"
      },
      "public": true,
      "type": ["editable"]
    },
    {
      "name": "loginButton",
      "selector": {
        "css": "[id='Login']"
      },
      "public": true,
      "type": ["clickable"]
    }
  ],
  "methods": [
    {
      "name": "login",
      "compose": [
        {
          "element": "username",
          "apply": "setText",
          "args": [
            {
              "type": "string",
              "name": "username"
            }
          ]
        },
        {
          "element": "password",
          "apply": "setText",
          "args": [
            {
              "type": "string",
              "name": "password"
            }
          ]
        },
        {
          "element": "loginButton",
          "apply": "click"
        }
      ]
    }
  ]
}
