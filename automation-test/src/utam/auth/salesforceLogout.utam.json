{
  "root": true,
  "selector": {
    "css": "body"
  },
  "beforeLoad": [
    {
      "apply": "waitFor",
      "args": [
        {
          "type": "function",
          "predicate": [
            {
              "element": "root",
              "apply": "isVisible"
            }
          ]
        }
      ]
    }
  ],
  "elements": [
    {
      "name": "userProfile",
      "selector": {
        "css": "button[class*='branding-userProfile-button']"
      },
      "type": "clickable"
    },
    {
      "name": "logoutLink",
      "selector": {
        "css": "a[class*='logout']"
      },
      "type": "clickable"
    }
  ],
  "methods": [
    {
      "name": "logout",
      "compose": [
        {
          "element": "userProfile",
          "apply": "click"
        },
        {
          "element": "logoutLink",
          "apply": "click"
        }
      ]
    }
  ]
}
