{
  "root": true,
  "selector": {
    "css": "body"
  },
  "beforeLoad": [
    {
      "apply": "waitFor",
      "args": [
        {
          "type": "function",
          "predicate": [
            {
              "element": "root",
              "apply": "isVisible"
            }
          ]
        }
      ]
    }
  ],
  "elements": [
    {
      "name": "standardAppContainer",
      "nullable": true,
      "selector": {
        "css": ".navexStandardManager"
      }
    },
    {
      "name": "consoleAppContainer",
      "nullable": true,
      "selector": {
        "css": ".navexWorkspaceManager"
      }
    },
    {
      "name": "oneAppLauncherMenu",
      "selector": {
        "css": "one-app-launcher-menu"
      },
      "shadow": {
        "elements": [
          {
            "name": "oneAppLauncherSearchBar",
            "selector": {
              "css": "one-app-launcher-search-bar"
            },
            "shadow": {
              "elements": [
                {
                  "name": "oneAppLauncherSearchBarInput",
                  "type": "salesforce-pageobjects/lightning/pageObjects/input",
                  "selector": {
                    "css": "lightning-input"
                  }
                }
              ]
            }
          },
          {
            "name": "appSearchResults",
            "selector": {
              "css": "h3:nth-of-type(1) + div[role='listbox']"
            },
            "elements": [
              {
                "name": "appResult",
                "nullable": true,
                "selector": {
                  "css": "one-app-launcher-menu-item"
                },
                "public": true,
                "type": "anzx-utam-force/pageObjects/oneAppLauncherMenuItem"
              },
              {
                "name": "noAppResultsMessage",
                "nullable": true,
                "selector": {
                  "css": "p"
                }
              }
            ]
          },
          {
            "name": "itemSearchResults",
            "selector": {
              "css": "h3:nth-of-type(2) + div[role='listbox']"
            },
            "elements": [
              {
                "name": "itemResult",
                "nullable": true,
                "selector": {
                  "css": "one-app-launcher-menu-item"
                },
                "public": true,
                "type": "anzx-utam-force/pageObjects/oneAppLauncherMenuItem"
              },
              {
                "name": "noItemResultsMessage",
                "nullable": true,
                "selector": {
                  "css": "p"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "consoleAppLauncher",
      "selector": {
        "css": "[class*='appLauncher'][role='navigation'] button"
      },
      "type": "clickable",
      "public": true
    },
    {
      "name": "currentApp",
      "selector": {
        "css": ".appName span"
      },
      "public": true
    }
  ],
  "methods": [
    {
      "name": "isCurrentApp",
      "compose": [
        {
          "element": "currentApp",
          "apply": "getText",
          "matcher": {
            "type": "stringEquals",
            "args": [
              {
                "name": "appName",
                "type": "string"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "openConsoleAppLauncher",
      "compose": [
        {
          "element": "consoleAppLauncher",
          "apply": "click"
        }
      ]
    },
    {
      "name": "search",
      "compose": [
        {
          "element": "oneAppLauncherSearchBarInput",
          "returnType": "salesforce-pageobjects/lightning/pageObjects/input"
        },
        {
          "chain": true,
          "apply": "setText",
          "args": [
            {
              "name": "searchText",
              "type": "string"
            }
          ]
        }
      ]
    },
    {
      "name": "selectAppAndRedirect",
      "compose": [
        {
          "element": "appResult",
          "apply": "click"
        }
      ]
    },
    {
      "name": "selectItemAndRedirect",
      "compose": [
        {
          "element": "itemResult",
          "apply": "click"
        }
      ]
    },
    {
      "name": "isInStandardApp",
      "compose": [
        {
          "element": "standardAppContainer",
          "apply": "isPresent"
        }
      ]
    },
    {
      "name": "isInConsoleApp",
      "compose": [
        {
          "element": "consoleAppContainer",
          "apply": "isPresent"
        }
      ]
    },
    {
      "name": "getNoAppResultsMessage",
      "compose": [
        {
          "element": "noAppResultsMessage",
          "apply": "getText"
        }
      ]
    },
    {
      "name": "getNoItemResultsMessage",
      "compose": [
        {
          "element": "noItemResultsMessage",
          "apply": "getText"
        }
      ]
    }
  ]
}
