{
  "root": true,
  "selector": {
    "css": "body"
  },
  "beforeLoad": [
    {
      "apply": "waitFor",
      "args": [
        {
          "type": "function",
          "predicate": [
            {
              "element": "root",
              "apply": "isVisible"
            }
          ]
        }
      ]
    }
  ],
  "elements": [
    {
      "name": "standardAppContainer",
      "nullable": true,
      "selector": {
        "css": ".navexStandardManager"
      }
    },
    {
      "name": "consoleAppContainer",
      "nullable": true,
      "selector": {
        "css": ".navexWorkspaceManager"
      }
    },
    {
      "name": "oneAppLauncherMenu",
      "selector": {
        "css": "one-app-launcher-menu"
      },
      "shadow": {
        "elements": [
          {
            "name": "oneAppLauncherSearchBar",
            "selector": {
              "css": "one-app-launcher-search-bar"
            },
            "shadow": {
              "elements": [
                {
                  "name": "oneAppLauncherSearchBarInput",
                  "type": "utam-lightning/pageObjects/input",
                  "selector": {
                    "css": "lightning-input"
                  }
                }
              ]
            }
          },
          {
            "name": "oneApplauncherMenuItem",
            "selector": {
              "css": "one-app-launcher-menu-item"
            },
            "shadow": {
              "elements": [
                {
                  "name": "appLink",
                  "selector": {
                    "css": "[role='option']"
                  },
                  "type": "clickable"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "appLauncher",
      "selector": {
        "css": "[class*='appLauncher'][role='navigation'] button"
      },
      "type": "clickable",
      "public": true
    },
    {
      "name": "menu",
      "selector": {
        "css": "one-app-launcher-menu"
      },
      "shadow": {
        "elements": [
          {
            "name": "searchBar",
            "selector": {
              "css": "one-app-launcher-search-bar"
            },
            "shadow": {
              "elements": [
                {
                  "name": "lightningInput",
                  "selector": {
                    "css": "lightning-input"
                  },
                  "shadow": {
                    "elements": [
                      {
                        "name": "searchInput",
                        "selector": {
                          "css": "input"
                        },
                        "type": "editable",
                        "public": true
                      }
                    ]
                  }
                }
              ]
            }
          },
          {
            "name": "searchItem",
            "selector": {
              "css": "one-app-launcher-menu-item"
            },
            "shadow": {
              "elements": [
                {
                  "name": "searchItemLink",
                  "selector": {
                    "css": "a[role='option']"
                  },
                  "type": "clickable",
                  "public": true
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "currentApp",
      "selector": {
        "css": ".appName span"
      },
      "public": true
    }
  ],
  "methods": [
    {
      "name": "isCurrentApp",
      "compose": [
        {
          "element": "currentApp",
          "apply": "getText",
          "matcher": {
            "type": "stringEquals",
            "args": [
              {
                "name": "appName",
                "type": "string"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "redirectToApp",
      "compose": [
        {
          "element": "appLauncher",
          "apply": "click"
        },
        {
          "apply": "waitFor",
          "args": [
            {
              "type": "function",
              "predicate": [
                {
                  "element": "searchInput",
                  "matcher": {
                    "type": "notNull"
                  }
                }
              ]
            }
          ]
        },
        {
          "element": "searchInput",
          "apply": "clearAndType",
          "args": [
            {
              "name": "appName",
              "type": "string"
            }
          ]
        },
        {
          "apply": "waitFor",
          "args": [
            {
              "type": "function",
              "predicate": [
                {
                  "element": "searchItemLink",
                  "matcher": {
                    "type": "notNull"
                  }
                }
              ]
            }
          ]
        },
        {
          "element": "searchItemLink",
          "apply": "click"
        }
      ]
    },
    {
      "name": "searchAppLwc",
      "compose": [
        {
          "element": "oneAppLauncherSearchBarInput",
          "returnType": "utam-lightning/pageObjects/input"
        },
        {
          "chain": true,
          "apply": "setText",
          "args": [
            {
              "name": "appName",
              "type": "string"
            }
          ]
        }
      ]
    },
    {
      "name": "selectAppLwcAndRedirect",
      "compose": [
        {
          "element": "appLink",
          "apply": "click"
        }
      ]
    },
    {
      "name": "isInStandardApp",
      "compose": [
        {
          "element": "standardAppContainer",
          "apply": "isPresent"
        }
      ]
    },
    {
      "name": "isInConsoleApp",
      "compose": [
        {
          "element": "consoleAppContainer",
          "apply": "isPresent"
        }
      ]
    }
  ]
}
