{
  "root": true,
  "selector": {
    "css": "body"
  },
  "elements": [
    {
      "name": "navMenu",
      "selector": {
        "css": "button[title='Show Navigation Menu']"
      },
      "type": "clickable"
    },
    {
      "name": "navMenuItem",
      "selector": {
        "css": "li a[data-label='%s']",
        "args": [
          {
            "name": "menuItem",
            "type": "string"
          }
        ]
      },
      "type": "clickable"
    }
  ],
  "methods": [
    {
      "name": "redirectToTab",
      "compose": [
        {
          "element": "navMenu",
          "apply": "click"
        },
        {
          "apply": "waitFor",
          "args": [
            {
              "type": "function",
              "predicate": [
                {
                  "element": "navMenuItem",
                  "matcher": {
                    "type": "notNull"
                  }
                }
              ]
            }
          ]
        },
        {
          "element": "navMenuItem",
          "apply": "click"
        }
      ]
    }
  ]
}
