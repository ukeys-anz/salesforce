{
  "shadow": {
    "elements": [
      {
        "name": "balance",
        "selector": {
          "css": "[data-test-id='balance']"
        }
      },
      {
        "name": "lastUpdatedTime",
        "selector": {
          "css": "[data-test-id='last-updated-time']"
        }
      }
    ]
  },
  "methods": [
    {
      "name": "getBalance",
      "compose": [
        {
          "element": "balance",
          "apply": "getText"
        }
      ]
    },
    {
      "name": "getLastUpdatedTime",
      "compose": [
        {
          "element": "lastUpdatedTime",
          "apply": "getText"
        }
      ]
    }
  ]
}
