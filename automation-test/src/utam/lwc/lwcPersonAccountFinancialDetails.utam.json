{
  "shadow": {
    "elements": [
      {
        "name": "refreshButton",
        "selector": {
          "css": "[data-test-id='refresh-button']"
        },
        "type": "clickable"
      },
      {
        "name": "everydayAccount",
        "selector": {
          "css": "c-financial-account[data-test-id='checking-account']"
        },
        "type": "anzx-utam-lwc/pageObjects/lwcFinancialAccount",
        "public": true
      },
      {
        "name": "savingsAccount",
        "selector": {
          "css": "c-financial-account[data-test-id='savings-account']"
        },
        "type": "anzx-utam-lwc/pageObjects/lwcFinancialAccount",
        "public": true
      },
      {
        "name": "financialGoals",
        "type": "anzx-utam-lwc/pageObjects/lwcFinancialGoalsPersonAccount",
        "selector": {
          "css": "c-financial-goals-person-account"
        },
        "public": true
      }
    ]
  },
  "methods": [
    {
      "name": "refresh",
      "compose": [
        {
          "element": "refreshButton",
          "apply": "click"
        }
      ]
    }
  ]
}
