{
  "shadow": {
    "elements": [
      {
        "name": "actionPanel",
        "selector": {
          "css": "lightning-quick-action-panel"
        },
        "elements": [
          {
            "name": "publishButton",
            "type": "salesforce-pageobjects/lightning/pageObjects/button",
            "selector": {
              "css": "lightning-button:nth-of-type(2)"
            }
          }
        ]
      }
    ]
  },
  "methods": [
    {
      "name": "publish",
      "compose": [
        {
          "element": "publishButton",
          "returnType": "salesforce-pageobjects/lightning/pageObjects/button"
        },
        {
          "chain": true,
          "apply": "click"
        }
      ]
    }
  ]
}
