{
  "shadow": {
    "elements": [
      {
        "name": "lightningButton",
        "type": "salesforce-pageobjects/lightning/pageObjects/button",
        "selector": {
          "css": "lightning-button"
        }
      }
    ]
  },
  "elements": [
    {
      "name": "item",
      "selector": {
        "css": "runtime_platform_actions-ribbon-menu-item",
        "returnAll": true
      },
      "type": "clickable",
      "filter": {
        "apply": "getText",
        "findFirst": true,
        "matcher": {
          "type": "stringContains",
          "args": [
            {
              "name": "itemText",
              "type": "string"
            }
          ]
        }
      }
    }
  ],
  "methods": [
    {
      "name": "open",
      "compose": [
        {
          "element": "lightningButton"
        },
        {
          "chain": true,
          "apply": "click"
        }
      ]
    },
    {
      "name": "clickItemByText",
      "compose": [
        {
          "element": "item",
          "apply": "click"
        }
      ]
    }
  ]
}
