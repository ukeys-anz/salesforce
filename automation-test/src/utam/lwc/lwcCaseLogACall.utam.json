{
  "shadow": {
    "elements": [
      {
        "name": "lightningCard",
        "selector": {
          "css": "lightning-card"
        },
        "elements": [
          {
            "name": "lightningLayout",
            "selector": {
              "css": "lightning-layout"
            },
            "elements": [
              {
                "name": "lightningLayoutItem",
                "selector": {
                  "css": "lightning-layout-item"
                },
                "elements": [
                  {
                    "name": "logCallButton",
                    "selector": {
                      "css": "[data-test-id='log-call-button']"
                    },
                    "type": "clickable",
                    "public": true
                  },
                  {
                    "name": "voiceCallSID",
                    "type": "salesforce-pageobjects/lightning/pageObjects/input",
                    "selector": {
                      "css": "[data-test-id='voice-call-sid']"
                    },
                    "public": true
                  },
                  {
                    "name": "authMethod",
                    "type": "salesforce-pageobjects/lightning/pageObjects/combobox",
                    "selector": {
                      "css": "[data-test-id='authentication-method']"
                    },
                    "public": true
                  },
                  {
                    "name": "saveButton",
                    "type": "salesforce-pageobjects/lightning/pageObjects/button",
                    "selector": {
                      "css": "[data-test-id='save-button']"
                    },
                    "public": true
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "methods": [
    {
      "name": "logACall",
      "compose": [
        {
          "element": "logCallButton",
          "apply": "click"
        },
        {
          "element": "voiceCallSID",
          "apply": "setText",
          "args": [
            {
              "name": "callSID",
              "type": "string"
            }
          ]
        },
        {
          "element": "authMethod",
          "returnType": "salesforce-pageobjects/lightning/pageObjects/combobox"
        },
        {
          "chain": true,
          "element": "base",
          "returnType": "salesforce-pageobjects/lightning/pageObjects/baseCombobox"
        },
        {
          "chain": true,
          "apply": "expandForDisabledInput"
        },
        {
          "element": "authMethod",
          "returnType": "salesforce-pageobjects/lightning/pageObjects/combobox"
        },
        {
          "chain": true,
          "element": "base",
          "returnType": "salesforce-pageobjects/lightning/pageObjects/baseCombobox"
        },
        {
          "chain": true,
          "apply": "pickItem",
          "args": [
            {
              "name": "indexStartingOne",
              "type": "number"
            }
          ]
        },
        {
          "element": "saveButton",
          "apply": "click"
        }
      ]
    }
  ]
}
