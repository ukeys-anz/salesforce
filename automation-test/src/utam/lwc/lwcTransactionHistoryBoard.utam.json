{
  "shadow": {
    "elements": [
      {
        "name": "boardBody",
        "selector": {
          "css": "[data-test-id='board-body']"
        },
        "elements": [
          {
            "name": "searchSection",
            "selector": {
              "css": ".search-section"
            },
            "elements": [
              {
                "name": "startDateInput",
                "selector": {
                  "css": "[data-test-id='startDateInput']"
                },
                "type": "salesforce-pageobjects/lightning/pageObjects/input"
              },
              {
                "name": "endDateInput",
                "selector": {
                  "css": "[data-test-id='endDateInput']"
                },
                "type": "salesforce-pageobjects/lightning/pageObjects/input"
              },
              {
                "name": "searchButton",
                "selector": {
                  "css": "lightning-button"
                },
                "type": "salesforce-pageobjects/lightning/pageObjects/button"
              }
            ]
          },
          {
            "name": "transactionHistoryRecordByType",
            "type": "anzx-utam-lwc/pageObjects/lwcTransactionHistoryRecord",
            "selector": {
              "css": "c-transaction-history-record",
              "returnAll": true
            },
            "filter": {
              "apply": "getTransactionType",
              "findFirst": true,
              "matcher": {
                "type": "stringEquals",
                "args": [
                  {
                    "name": "transactionType",
                    "type": "string"
                  }
                ]
              }
            },
            "public": true
          },
          {
            "name": "transactionHistoryRecordsWithDate",
            "type": "anzx-utam-lwc/pageObjects/lwcTransactionHistoryRecord",
            "selector": {
              "css": "c-transaction-history-record",
              "returnAll": true
            },
            "filter": {
              "apply": "getTransactionDateEle",
              "matcher": {
                "type": "notNull"
              }
            },
            "public": true
          },
          {
            "name": "transactionHistoryRecord",
            "type": "anzx-utam-lwc/pageObjects/lwcTransactionHistoryRecord",
            "selector": {
              "css": "c-transaction-history-record"
            },
            "public": true
          },
          {
            "name": "transactionHistoryRecords",
            "type": "anzx-utam-lwc/pageObjects/lwcTransactionHistoryRecord",
            "selector": {
              "css": "c-transaction-history-record",
              "returnAll": true
            },
            "public": true
          },
          {
            "name": "loadMoreButton",
            "public": true,
            "selector": {
              "css": "button[class*='load-more']"
            },
            "type": "clickable"
          }
        ]
      }
    ]
  },
  "methods": [
    {
      "name": "getEndDateSearch",
      "compose": [
        {
          "element": "endDateInput",
          "returnType": "salesforce-pageobjects/lightning/pageObjects/input"
        },
        {
          "chain": true,
          "element": "datepicker",
          "returnType": "salesforce-pageobjects/lightning/pageObjects/datepicker"
        }
      ]
    },
    {
      "name": "loadMore",
      "compose": [
        {
          "element": "loadMoreButton",
          "apply": "click"
        }
      ]
    }
  ]
}
