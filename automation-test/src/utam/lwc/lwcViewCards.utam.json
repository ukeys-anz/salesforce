{
  "shadow": {
    "elements": [
      {
        "name": "lightningCard",
        "selector": {
          "css": "lightning-card"
        },
        "elements": [
          {
            "name": "cardDetailsButton",
            "type": "utam-lightning/pageObjects/button",
            "selector": {
              "css": "[data-test-id='get-card-details-button']"
            }
          },
          {
            "name": "collapseExpandButton",
            "type": "utam-lightning/pageObjects/button",
            "selector": {
              "css": "[data-test-id='collapse-expand-button']"
            }
          },
          {
            "name": "cards",
            "nullable": true,
            "selector": {
              "css": "[data-test-id='card-details']",
              "returnAll": true
            },
            "type": "anzx-utam-lwc/pageObjects/lwcViewCardsDetails",
            "public": true
          },
          {
            "name": "loadMoreButton",
            "nullable": true,
            "selector": {
              "css": "[data-test-id='load-more']"
            },
            "type": "clickable"
          }
        ]
      }
    ]
  },
  "methods": [
    {
      "name": "showDetails",
      "compose": [
        {
          "element": "cardDetailsButton"
        },
        {
          "chain": true,
          "apply": "click"
        }
      ]
    },
    {
      "name": "isInDetailsView",
      "compose": [
        {
          "element": "collapseExpandButton",
          "apply": "isVisible"
        }
      ]
    },
    {
      "name": "hasMoreCards",
      "compose": [
        {
          "element": "loadMoreButton",
          "apply": "isVisible"
        }
      ]
    },
    {
      "name": "loadMore",
      "compose": [
        {
          "element": "loadMoreButton",
          "apply": "click"
        }
      ]
    }
  ]
}
