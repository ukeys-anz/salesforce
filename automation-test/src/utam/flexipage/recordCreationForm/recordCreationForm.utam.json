{
  "root": true,
  "selector": {
    "css": "body"
  },
  "beforeLoad": [
    {
      "apply": "waitFor",
      "args": [
        {
          "type": "function",
          "predicate": [
            {
              "element": "root",
              "apply": "isVisible"
            }
          ]
        }
      ]
    }
  ],
  "elements": [
    {
      "name": "newButton",
      "nullable": true,
      "selector": {
        "css": "a div[title='New']"
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "caseRecordType",
      "nullable": true,
      "selector": {
        "css": "article[class*='cNewCaseAuraWrapper'] span",
        "returnAll": true
      },
      "filter": {
        "apply": "getText",
        "findFirst": true,
        "matcher": {
          "type": "stringEquals",
          "args": [
            {
              "name": "text",
              "type": "string"
            }
          ]
        }
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "nextButton",
      "nullable": true,
      "selector": {
        "css": "footer button:nth-of-type(2)"
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "formSection",
      "selector": {
        "css": ".forcePageBlockSection:nth-of-type(%d)",
        "args": [
          {
            "name": "sectionIndex",
            "type": "number"
          }
        ]
      },
      "elements": [
        {
          "name": "formSectionRow",
          "selector": {
            "css": ".forcePageBlockSectionRow:nth-of-type(%d)",
            "args": [
              {
                "name": "sectionRowIndex",
                "type": "number"
              }
            ]
          },
          "elements": [
            {
              "name": "formSectionRowItem",
              "selector": {
                "css": ".forcePageBlockItem:nth-of-type(%d)",
                "args": [
                  {
                    "name": "sectionRowItemIndex",
                    "type": "number"
                  }
                ]
              },
              "type": "anzx-utam-flexipage/pageObjects/recordCreationFormField"
            }
          ]
        }
      ]
    },
    {
      "name": "fieldByLabel",
      "nullable": true,
      "type": "anzx-utam-flexipage/pageObjects/recordCreationFormField",
      "selector": {
        "css": ".forcePageBlockItem",
        "returnAll": true
      },
      "filter": {
        "apply": "getLabel",
        "findFirst": true,
        "matcher": {
          "type": "stringEquals",
          "args": [
            {
              "name": "label",
              "type": "string"
            }
          ]
        }
      },
      "public": true
    },
    {
      "name": "allFields",
      "nullable": true,
      "type": "anzx-utam-flexipage/pageObjects/recordCreationFormField",
      "selector": {
        "css": ".forcePageBlockItem",
        "returnAll": true
      },
      "public": true
    },
    {
      "name": "picklists",
      "selector": {
        "css": ".desktop > .select-options ul",
        "returnAll": true
      },
      "type": "anzx-utam-flexipage/pageObjects/recordCreationFormPicklist",
      "public": true
    },
    {
      "name": "saveButton",
      "selector": {
        "css": "button[title='Save']"
      },
      "public": true,
      "type": "clickable"
    }
  ],
  "methods": [
    {
      "name": "selectCaseRecordType",
      "compose": [
        {
          "apply": "clickNew"
        },
        {
          "apply": "waitFor",
          "args": [
            {
              "type": "function",
              "predicate": [
                {
                  "element": "caseRecordType",
                  "matcher": {
                    "type": "notNull"
                  }
                }
              ]
            }
          ]
        },
        {
          "element": "caseRecordType",
          "apply": "click"
        },
        {
          "element": "nextButton",
          "apply": "click"
        }
      ]
    },
    {
      "name": "clickNew",
      "compose": [
        {
          "apply": "waitFor",
          "args": [
            {
              "type": "function",
              "predicate": [
                {
                  "element": "newButton",
                  "matcher": {
                    "type": "notNull"
                  }
                }
              ]
            }
          ]
        },
        {
          "element": "newButton",
          "apply": "click"
        }
      ]
    },
    {
      "name": "saveNew",
      "compose": [
        {
          "element": "saveButton",
          "apply": "click"
        }
      ]
    }
  ]
}
