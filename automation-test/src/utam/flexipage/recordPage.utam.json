{
  "root": true,
  "selector": {
    "css": "body"
  },
  "beforeLoad": [
    {
      "apply": "waitFor",
      "args": [
        {
          "type": "function",
          "predicate": [
            {
              "element": "root",
              "apply": "isVisible"
            }
          ]
        }
      ]
    }
  ],
  "elements": [
    {
      "name": "oneRecordHomeFlexipage2",
      "selector": {
        "css": ".active.lafPageHost one-record-home-flexipage2"
      },
      "shadow": {
        "elements": [
          {
            "name": "adgRollup",
            "selector": {
              "css": ".adg-rollup-wrapped"
            },
            "shadow": {
              "elements": [
                {
                  "name": "flexipageModule",
                  "selector": {
                    "css": ".forcegenerated-flexipage-module"
                  },
                  "shadow": {
                    "elements": [
                      {
                        "type": "utam-record-flexipage/pageObjects/recordPageDecorator",
                        "public": true,
                        "name": "decorator",
                        "selector": {
                          "css": "record_flexipage-record-page-decorator"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "knowledgeFlexipage",
      "selector": {
        "css": ".active.lafPageHost .flexipagePage"
      },
      "type": "anzx-utam-flexipage/pageObjects/knowledgeRecordPage"
    }
  ],
  "methods": [
    {
      "name": "getRecordLayoutBroker",
      "compose": [
        {
          "element": "decorator",
          "returnType": "utam-record_flexipage/pageObjects/recordPageDecorator"
        },
        {
          "chain": true,
          "element": "eventBroker",
          "returnType": "utam-records/pageObjects/recordLayoutEventBroker"
        }
      ]
    },
    {
      "name": "getCaseRecordPage",
      "compose": [
        {
          "returnType": "utam-records/pageObjects/recordLayoutEventBroker",
          "apply": "getRecordLayoutBroker"
        },
        {
          "chain": true,
          "returnType": "anzx-utam-flexipage/pageObjects/caseRecordPage",
          "element": "generatedTemplate",
          "args": [
            {
              "type": "pageObject",
              "value": "anzx-utam-flexipage/pageObjects/caseRecordPage"
            }
          ]
        }
      ]
    },
    {
      "name": "getAccountRecordPage",
      "compose": [
        {
          "returnType": "utam-records/pageObjects/recordLayoutEventBroker",
          "apply": "getRecordLayoutBroker"
        },
        {
          "chain": true,
          "returnType": "anzx-utam-flexipage/pageObjects/accountRecordPage",
          "element": "generatedTemplate",
          "args": [
            {
              "type": "pageObject",
              "value": "anzx-utam-flexipage/pageObjects/accountRecordPage"
            }
          ]
        }
      ]
    },
    {
      "name": "getFinancialAccountRecordPage",
      "compose": [
        {
          "returnType": "utam-records/pageObjects/recordLayoutEventBroker",
          "apply": "getRecordLayoutBroker"
        },
        {
          "chain": true,
          "returnType": "anzx-utam-flexipage/pageObjects/financialAccountRecordPage",
          "element": "generatedTemplate",
          "args": [
            {
              "type": "pageObject",
              "value": "anzx-utam-flexipage/pageObjects/financialAccountRecordPage"
            }
          ]
        }
      ]
    },
    {
      "name": "getQualityAssessmentRecordPage",
      "compose": [
        {
          "returnType": "utam-records/pageObjects/recordLayoutEventBroker",
          "apply": "getRecordLayoutBroker"
        },
        {
          "chain": true,
          "returnType": "anzx-utam-flexipage/pageObjects/qualityAssessmentRecordPage",
          "element": "generatedTemplate",
          "args": [
            {
              "type": "pageObject",
              "value": "anzx-utam-flexipage/pageObjects/qualityAssessmentRecordPage"
            }
          ]
        }
      ]
    },
    {
      "name": "getKnowledgeRecordPage",
      "compose": [
        {
          "element": "knowledgeFlexipage",
          "returnType": "anzx-utam-flexipage/pageObjects/knowledgeRecordPage"
        }
      ]
    }
  ]
}
