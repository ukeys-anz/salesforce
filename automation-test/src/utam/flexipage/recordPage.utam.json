{
  "root": true,
  "selector": {
    "css": "one-record-home-flexipage2"
  },
  "shadow": {
    "elements": [
      {
        "name": "adgRollup",
        "selector": {
          "css": ".adg-rollup-wrapped"
        },
        "shadow": {
          "elements": [
            {
              "name": "flexipageModule",
              "selector": {
                "css": ".forcegenerated-flexipage-module"
              },
              "shadow": {
                "elements": [
                  {
                    "type": "utam-record-flexipage/pageObjects/recordPageDecorator",
                    "public": true,
                    "name": "decorator",
                    "selector": {
                      "css": "record_flexipage-record-page-decorator"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "methods": [
    {
      "name": "getRecordLayoutBroker",
      "compose": [
        {
          "element": "decorator",
          "returnType": "utam-record-flexipage/pageObjects/recordPageDecorator"
        },
        {
          "chain": true,
          "element": "eventBroker",
          "returnType": "utam-records/pageObjects/recordLayoutEventBroker"
        }
      ]
    },
    {
      "name": "getCaseRecordPage",
      "compose": [
        {
          "returnType": "utam-records/pageObjects/recordLayoutEventBroker",
          "apply": "getRecordLayoutBroker"
        },
        {
          "chain": true,
          "returnType": "anzx-utam-flexipage/pageObjects/caseRecordPage",
          "element": "generatedTemplate",
          "args": [
            {
              "type": "pageObject",
              "value": "anzx-utam-flexipage/pageObjects/caseRecordPage"
            }
          ]
        }
      ]
    }
  ]
}
