{
  "elements": [
    {
      "name": "stepName",
      "selector": {
        "css": "th"
      }
    },
    {
      "name": "assignedTo",
      "selector": {
        "css": "td:nth-of-type(3)"
      }
    }
  ],
  "methods": [
    {
      "name": "getStepName",
      "compose": [
        {
          "element": "stepName",
          "apply": "getText"
        }
      ]
    },
    {
      "name": "getAssignedTo",
      "compose": [
        {
          "element": "assignedTo",
          "apply": "getText"
        }
      ]
    }
  ]
}
