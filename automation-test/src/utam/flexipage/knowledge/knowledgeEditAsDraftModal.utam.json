{
  "root": true,
  "selector": {
    "css": "body"
  },
  "beforeLoad": [
    {
      "apply": "waitFor",
      "args": [
        {
          "type": "function",
          "predicate": [
            {
              "element": "root",
              "apply": "isVisible"
            }
          ]
        }
      ]
    }
  ],
  "elements": [
    {
      "name": "modalManager",
      "selector": {
        "css": ".uiContainerManager"
      },
      "elements": [
        {
          "name": "modalWrapper",
          "selector": {
            "css": ".active.lafPageHost .oneRecordActionWrapper"
          },
          "elements": [
            {
              "name": "reasonForChangeEditField",
              "selector": {
                "css": ".forcePageBlockSection:nth-of-type(1) .forcePageBlockSectionRow:nth-of-type(2) .forcePageBlockItem:nth-of-type(1) textarea"
              },
              "type": ["clickable", "editable"]
            }
          ]
        },
        {
          "name": "saveButton",
          "selector": {
            "css": ".inlineFooter button[title='Save']"
          },
          "type": "clickable",
          "public": true
        }
      ]
    }
  ],
  "methods": [
    {
      "name": "saveDraft",
      "compose": [
        {
          "element": "saveButton",
          "apply": "click"
        }
      ]
    },
    {
      "name": "editReasonForChangeEdit",
      "compose": [
        {
          "element": "reasonForChangeEditField",
          "apply": "clearAndType",
          "args": [
            {
              "name": "reasonForChangeText",
              "type": "string"
            }
          ]
        }
      ]
    }
  ]
}
