{
  "elements": [
    {
      "name": "header",
      "selector": {
        "css": ".region-header"
      },
      "elements": [
        {
          "name": "actionBar",
          "selector": {
            "css": ".actionsContainer"
          },
          "elements": [
            {
              "name": "actionRibbon",
              "selector": {
                "css": ".oneActionsRibbon"
              },
              "elements": [
                {
                  "name": "actionByTitle",
                  "selector": {
                    "css": "li a",
                    "returnAll": true
                  },
                  "filter": {
                    "apply": "getTitle",
                    "findFirst": true,
                    "matcher": {
                      "type": "stringContains",
                      "args": [
                        {
                          "name": "title",
                          "type": "string"
                        }
                      ]
                    }
                  },
                  "type": "clickable"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "main",
      "selector": {
        "css": ".row-main"
      },
      "elements": [
        {
          "name": "mainSectionTablist",
          "selector": {
            "css": ".flexipageComponent:nth-of-type(1) [role='tablist']"
          },
          "elements": [
            {
              "name": "detailsTabLink",
              "selector": {
                "css": "li:nth-of-type(1)"
              },
              "type": "clickable"
            },
            {
              "name": "approvalHistoryTabLink",
              "selector": {
                "css": "li:nth-of-type(3)"
              },
              "type": "clickable"
            }
          ]
        },
        {
          "name": "mainSectionActiveTabContent",
          "selector": {
            "css": ".tabs__content.active.uiTab"
          },
          "elements": [
            {
              "name": "formSection",
              "selector": {
                "css": ".forcePageBlockSection:nth-of-type(%d)",
                "args": [
                  {
                    "name": "sectionIndex",
                    "type": "number"
                  }
                ]
              },
              "elements": [
                {
                  "name": "formSectionRow",
                  "selector": {
                    "css": ".forcePageBlockSectionRow:nth-of-type(%d)",
                    "args": [
                      {
                        "name": "sectionRowIndex",
                        "type": "number"
                      }
                    ]
                  },
                  "elements": [
                    {
                      "name": "formSectionRowItem",
                      "selector": {
                        "css": ".forcePageBlockItem:nth-of-type(%d)",
                        "args": [
                          {
                            "name": "sectionRowItemIndex",
                            "type": "number"
                          }
                        ]
                      },
                      "elements": [
                        {
                          "name": "displayText",
                          "selector": {
                            "css": ".is-read-only span"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "name": "approvalHistoryRelatedList",
              "selector": {
                "css": ".forceRelatedListContainer"
              },
              "elements": [
                {
                  "name": "approvalHistoryApproveButton",
                  "selector": {
                    "css": "a[title='Approve']"
                  },
                  "type": "clickable"
                },
                {
                  "name": "hisotryList",
                  "selector": {
                    "css": "tbody"
                  },
                  "elements": [
                    {
                      "name": "histories",
                      "type": "anzx-utam-flexipage/pageObjects/knowledgeApprovalHistory",
                      "selector": {
                        "css": "tr",
                        "returnAll": true
                      },
                      "public": true
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "categoryViewer",
          "selector": {
            "css": "[data-component-id='forceKnowledge_articleDataCategoryViewer']"
          },
          "elements": [
            {
              "name": "categoryMenuButton",
              "selector": {
                "css": "a[role='button']"
              },
              "type": "clickable"
            },
            {
              "name": "categoryEditButton",
              "selector": {
                "css": "a[title='Edit']"
              },
              "type": "clickable"
            }
          ]
        }
      ]
    },
    {
      "name": "articleCategoriesEditorModal",
      "selector": {
        "css": ".forceKnowledgeArticleDataCategoryChooser"
      },
      "type": "anzx-utam-flexipage/pageObjects/articleCategoriesEditorModal"
    }
  ],
  "methods": [
    {
      "name": "clickHeaderButtonByTitle",
      "compose": [
        {
          "element": "actionByTitle",
          "apply": "click"
        }
      ]
    },
    {
      "name": "openDetailTab",
      "compose": [
        {
          "element": "detailsTabLink",
          "apply": "click"
        }
      ]
    },
    {
      "name": "openApprovalHistoryTab",
      "compose": [
        {
          "element": "approvalHistoryTabLink",
          "apply": "click"
        }
      ]
    },
    {
      "name": "clickApproveButton",
      "compose": [
        {
          "element": "approvalHistoryApproveButton",
          "apply": "click"
        }
      ]
    },
    {
      "name": "getFieldOutputText",
      "compose": [
        {
          "element": "displayText",
          "apply": "getText"
        }
      ]
    },
    {
      "name": "openCategoriesEditor",
      "compose": [
        {
          "element": "categoryMenuButton",
          "apply": "click"
        },
        {
          "apply": "waitForVisible",
          "element": "categoryEditButton"
        },
        {
          "element": "categoryEditButton",
          "apply": "click"
        }
      ]
    }
  ]
}
