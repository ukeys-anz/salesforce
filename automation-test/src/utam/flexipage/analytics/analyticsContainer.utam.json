{
  "root": true,
  "exposeRootElement": true,
  "selector": {
    "css": "body"
  },
  "elements": [
    {
      "name": "waveAppRoot",
      "selector": {
        "css": ".wave-app-root"
      },
      "elements": [
        {
          "name": "homeLeftNav",
          "selector": {
            "css": ".home-left-nav"
          },
          "elements": [
            {
              "name": "browseMenu",
              "selector": {
                "css": "h1:nth-of-type(2) + ul"
              },
              "elements": [
                {
                  "name": "MenuItemByTitle",
                  "selector": {
                    "css": "li a",
                    "returnAll": true
                  },
                  "type": "clickable",
                  "filter": {
                    "apply": "getText",
                    "findFirst": true,
                    "matcher": {
                      "type": "stringContains",
                      "args": [
                        {
                          "name": "itemTitle",
                          "type": "string"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "containerFinder",
          "selector": {
            "css": ".container.finder"
          },
          "elements": [
            {
              "name": "searchContainer",
              "selector": {
                "css": ".search-container"
              },
              "elements": [
                {
                  "name": "navItemByTitle",
                  "selector": {
                    "css": "li",
                    "returnAll": true
                  },
                  "filter": {
                    "apply": "getText",
                    "findFirst": true,
                    "matcher": {
                      "type": "stringContains",
                      "args": [
                        {
                          "name": "navItemTitle",
                          "type": "string"
                        }
                      ]
                    }
                  },
                  "public": true,
                  "type": "clickable"
                }
              ]
            },
            {
              "name": "contentContainer",
              "selector": {
                "css": ".content-container"
              },
              "elements": [
                {
                  "name": "rowByTitle",
                  "nullable": true,
                  "selector": {
                    "css": "tr.datarow td.title",
                    "returnAll": true
                  },
                  "filter": {
                    "apply": "getText",
                    "findFirst": true,
                    "matcher": {
                      "type": "stringContains",
                      "args": [
                        {
                          "name": "rowTitle",
                          "type": "string"
                        }
                      ]
                    }
                  },
                  "public": true
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "methods": [
    {
      "name": "clickMenuItemByTitle",
      "compose": [
        {
          "element": "MenuItemByTitle",
          "apply": "click"
        }
      ]
    },
    {
      "name": "clickNavItemByTitle",
      "compose": [
        {
          "element": "navItemByTitle",
          "apply": "click"
        }
      ]
    }
  ]
}
