{
  "root": true,
  "selector": {
    "css": "body"
  },
  "beforeLoad": [
    {
      "apply": "waitFor",
      "args": [
        {
          "type": "function",
          "predicate": [
            {
              "element": "root",
              "apply": "isVisible"
            }
          ]
        }
      ]
    }
  ],
  "elements": [
    {
      "name": "modalBody",
      "selector": {
        "css": ".modal-body"
      },
      "elements": [
        {
          "name": "searchBox",
          "selector": {
            "css": "input[title*='Search']"
          },
          "type": ["clickable", "editable"]
        },
        {
          "name": "modalFooter",
          "selector": {
            "css": ".modal-footer"
          },
          "elements": [
            {
              "name": "saveButton",
              "selector": {
                "css": "button:nth-of-type(2)"
              },
              "type": "clickable",
              "public": true
            }
          ]
        }
      ]
    },
    {
      "name": "searchResult",
      "selector": {
        "css": ".listContent li a",
        "returnAll": true
      },
      "type": "clickable",
      "filter": {
        "apply": "getText",
        "findFirst": true,
        "matcher": {
          "type": "stringContains",
          "args": [
            {
              "name": "username",
              "type": "string"
            }
          ]
        }
      }
    }
  ],
  "methods": [
    {
      "name": "search",
      "compose": [
        {
          "element": "searchBox",
          "apply": "clearAndType",
          "args": [
            {
              "name": "searchTerm",
              "type": "string"
            }
          ]
        }
      ]
    },
    {
      "name": "clickSearchBox",
      "compose": [
        {
          "element": "searchBox",
          "apply": "click"
        }
      ]
    },
    {
      "name": "clickResult",
      "compose": [
        {
          "element": "searchResult",
          "apply": "click"
        }
      ]
    },
    {
      "name": "save",
      "compose": [
        {
          "element": "saveButton",
          "apply": "click"
        }
      ]
    }
  ]
}
