{
  "root": true,
  "selector": {
    "css": "body"
  },
  "beforeLoad": [
    {
      "apply": "waitFor",
      "args": [
        {
          "type": "function",
          "predicate": [
            {
              "element": "root",
              "apply": "isVisible"
            }
          ]
        }
      ]
    }
  ],
  "elements": [
    {
      "name": "newCase",
      "selector": {
        "css": "a div[title='New']"
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "caseRecordType",
      "selector": {
        "css": "article[class*='cNewCaseAuraWrapper'] span",
        "returnAll": true
      },
      "filter": {
        "apply": "getText",
        "findFirst": true,
        "matcher": {
          "type": "stringEquals",
          "args": [
            {
              "name": "text",
              "type": "string"
            }
          ]
        }
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "nextButton",
      "selector": {
        "css": "footer button:nth-of-type(2)"
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "lookupResult",
      "selector": {
        "css": "div[class*='lookup__menu uiAbstractList'] ul[role='presentation'] li[class='lookup__item  default uiAutocompleteOption forceSearchInputLookupDesktopOption']:nth-of-type(%d)",
        "args": [
          {
            "name": "resultIndex",
            "type": "number"
          }
        ]
      },
      "type": "clickable"
    },
    {
      "name": "formSection",
      "selector": {
        "css": ".forcePageBlockSection:nth-of-type(%d)",
        "args": [
          {
            "name": "sectionIndex",
            "type": "number"
          }
        ]
      },
      "elements": [
        {
          "name": "formSectionRow",
          "selector": {
            "css": ".forcePageBlockSectionRow:nth-of-type(%d)",
            "args": [
              {
                "name": "sectionRowIndex",
                "type": "number"
              }
            ]
          },
          "elements": [
            {
              "name": "formSectionRowItem",
              "selector": {
                "css": ".forcePageBlockItem:nth-of-type(%d)",
                "args": [
                  {
                    "name": "sectionRowItemIndex",
                    "type": "number"
                  }
                ]
              },
              "elements": [
                {
                  "name": "picklist",
                  "selector": {
                    "css": "a[role='button']"
                  },
                  "type": "clickable"
                },
                {
                  "name": "textarea",
                  "selector": {
                    "css": "textarea[role='textbox']"
                  },
                  "type": "editable"
                },
                {
                  "name": "lookup",
                  "selector": {
                    "css": "input[role='combobox']"
                  },
                  "type": ["editable", "clickable"]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "picklistItemsLists",
      "selector": {
        "css": ".desktop > .select-options ul",
        "returnAll": true
      },
      "type": "anzx-utam-console/pageObjects/coachesWorkbenchCaseCreationFormPicklist",
      "public": true
    },
    {
      "name": "saveCase",
      "selector": {
        "css": "button[title='Save']"
      },
      "public": true,
      "type": "clickable"
    }
  ],
  "methods": [
    {
      "name": "selectCaseRecordType",
      "compose": [
        {
          "apply": "waitFor",
          "args": [
            {
              "type": "function",
              "predicate": [
                {
                  "element": "newCase",
                  "matcher": {
                    "type": "notNull"
                  }
                }
              ]
            }
          ]
        },
        {
          "element": "newCase",
          "apply": "click"
        },
        {
          "apply": "waitFor",
          "args": [
            {
              "type": "function",
              "predicate": [
                {
                  "element": "caseRecordType",
                  "matcher": {
                    "type": "notNull"
                  }
                }
              ]
            }
          ]
        },
        {
          "element": "caseRecordType",
          "apply": "click"
        },
        {
          "element": "nextButton",
          "apply": "click"
        }
      ]
    },
    {
      "name": "selectPicklist",
      "compose": [
        {
          "element": "picklist",
          "apply": "click"
        }
      ]
    },
    {
      "name": "editTextarea",
      "compose": [
        {
          "element": "textarea",
          "apply": "clearAndType",
          "args": [
            {
              "name": "text",
              "type": "string"
            }
          ]
        }
      ]
    },
    {
      "name": "searchAndSelectLookup",
      "compose": [
        {
          "element": "lookup",
          "apply": "clearAndType",
          "args": [
            {
              "name": "searchTerm",
              "type": "string"
            }
          ]
        },
        {
          "element": "lookup",
          "apply": "click"
        },
        {
          "apply": "waitForVisible",
          "args": [
            {
              "type": "function",
              "predicate": [
                {
                  "element": "lookupResult",
                  "matcher": {
                    "type": "notNull"
                  }
                }
              ]
            }
          ]
        },
        {
          "element": "lookupResult",
          "apply": "click"
        }
      ]
    },
    {
      "name": "saveNew",
      "compose": [
        {
          "element": "saveCase",
          "apply": "click"
        }
      ]
    }
  ]
}
