{
  "root": true,
  "selector": {
    "css": "one-record-home-flexipage2"
  },
  "beforeLoad": [
    {
      "apply": "waitFor",
      "args": [
        {
          "type": "function",
          "predicate": [
            {
              "element": "root",
              "apply": "isPresent"
            },
            {
              "element": "root",
              "apply": "containsElement",
              "args": [
                {
                  "type": "locator",
                  "value": {
                    "css": ".adg-rollup-wrapped"
                  }
                },
                {
                  "value": true
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "shadow": {
    "elements": [
      {
        "name": "adgRollup",
        "selector": {
          "css": ".adg-rollup-wrapped"
        },
        "shadow": {
          "elements": [
            {
              "name": "flexipageModule",
              "selector": {
                "css": ".forcegenerated-flexipage-module"
              },
              "shadow": {
                "elements": [
                  {
                    "type": "utam-record-flexipage/pageObjects/recordPageDecorator",
                    "public": true,
                    "name": "decorator",
                    "selector": {
                      "css": "record_flexipage-record-page-decorator"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "methods": [
    {
      "name": "getRecordHomeTemplateDesktop2",
      "compose": [
        {
          "element": "decorator",
          "returnType": "utam-record-flexipage/pageObjects/recordPageDecorator"
        },
        {
          "chain": true,
          "element": "eventBroker",
          "returnType": "utam-records/pageObjects/recordLayoutEventBroker"
        },
        {
          "chain": true,
          "apply": "waitForTemplate",
          "returnType": "utam-records/pageObjects/recordLayoutEventBroker"
        },
        {
          "chain": true,
          "returnType": "anzx-utam-coachesWorkbench/pageObjects/coachesWorkbenchAccountRecordHomeTemplateDesktop2",
          "element": "generatedTemplate",
          "args": [
            {
              "type": "pageObject",
              "value": "anzx-utam-coachesWorkbench/pageObjects/coachesWorkbenchAccountRecordHomeTemplateDesktop2"
            }
          ]
        }
      ]
    },
    {
      "name": "getFinancialDetails",
      "compose": [
        {
          "apply": "getRecordHomeTemplateDesktop2",
          "returnType": "anzx-utam-coachesWorkbench/pageObjects/coachesWorkbenchAccountRecordHomeTemplateDesktop2"
        },
        {
          "chain": true,
          "element": "financialDetails",
          "returnType": "anzx-utam-lwc/pageObjects/lwcPersonAccountFinancialDetails"
        }
      ]
    },
    {
      "name": "getChatterPanel",
      "compose": [
        {
          "apply": "getRecordHomeTemplateDesktop2",
          "returnType": "anzx-utam-coachesWorkbench/pageObjects/coachesWorkbenchAccountRecordHomeTemplateDesktop2"
        },
        {
          "chain": true,
          "element": "chatterPanel",
          "returnType": "anzx-utam-force/pageObjects/chatterPanel"
        }
      ]
    }
  ]
}
