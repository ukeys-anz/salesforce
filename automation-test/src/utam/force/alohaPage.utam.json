{
  "shadow": {
    "elements": [
      {
        "name": "bodyEditorContainer",
        "type": "frame",
        "selector": {
          "css": "iframe[title='Body Text Editor Container']"
        }
      }
    ]
  },
  "methods": [
    {
      "name": "enterBodyTextEditorContainerIframe",
      "compose": [
        {
          "element": "document",
          "apply": "enterFrame",
          "args": [
            {
              "type": "elementReference",
              "value": "bodyEditorContainer"
            },
            {
              "type": "rootPageObject",
              "value": "anzx-utam-flexipage/pageObjects/bodyTextEditorContainer"
            }
          ]
        }
      ]
    }
  ]
}
