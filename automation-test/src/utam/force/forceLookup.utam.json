{
  "type": "clickable",
  "shadow": {
    "elements": [
      {
        "name": "ownerName",
        "selector": {
          "css": ".slds-grid slot"
        }
      },
      {
        "name": "recordHoverableLink",
        "selector": {
          "css": "records-hoverable-link"
        },
        "shadow": {
          "elements": [
            {
              "name": "recordLink",
              "selector": {
                "css": "a"
              },
              "type": "clickable"
            }
          ]
        }
      }
    ]
  },
  "methods": [
    {
      "name": "getOwnerNameText",
      "compose": [
        {
          "element": "ownerName",
          "apply": "getText"
        }
      ]
    },
    {
      "name": "openLookupLink",
      "compose": [
        {
          "element": "recordLink",
          "apply": "click"
        }
      ]
    }
  ]
}
