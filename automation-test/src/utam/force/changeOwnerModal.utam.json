{
  "root": true,
  "selector": {
    "css": "body"
  },
  "beforeLoad": [
    {
      "apply": "waitFor",
      "args": [
        {
          "type": "function",
          "predicate": [
            {
              "element": "root",
              "apply": "isVisible"
            }
          ]
        }
      ]
    }
  ],
  "elements": [
    {
      "name": "modalHeader",
      "selector": {
        "css": ".modal-header"
      }
    },
    {
      "name": "modalBody",
      "selector": {
        "css": ".modal-body"
      },
      "elements": [
        {
          "name": "ownerMenuButton",
          "selector": {
            "css": "a.entityMenuTrigger"
          },
          "type": "clickable"
        },
        {
          "name": "searchBox",
          "selector": {
            "css": "input[title*='Search']"
          },
          "type": ["clickable", "editable"]
        },
        {
          "name": "searchResult",
          "selector": {
            "css": ".listContent li a div[title='%s']",
            "args": [
              {
                "name": "resultTitle",
                "type": "string"
              }
            ]
          },
          "type": "clickable"
        }
      ]
    },
    {
      "name": "modalFooter",
      "selector": {
        "css": ".modal-footer"
      },
      "elements": [
        {
          "name": "changeOwnerButton",
          "selector": {
            "css": "button[name='change owner']"
          },
          "type": "clickable",
          "public": true
        }
      ]
    },
    {
      "name": "ownerMenuList",
      "selector": {
        "css": "div.entityMenuList"
      },
      "elements": [
        {
          "name": "ownerType",
          "selector": {
            "css": "a[title='%s']",
            "args": [
              {
                "name": "ownerType",
                "type": "string"
              }
            ]
          },
          "type": "clickable",
          "public": true
        }
      ]
    }
  ],
  "methods": [
    {
      "name": "clickOwnerTypeDropDown",
      "compose": [
        {
          "element": "ownerMenuButton",
          "apply": "click"
        }
      ]
    },
    {
      "name": "selectOwnerType",
      "compose": [
        {
          "element": "ownerType",
          "apply": "click"
        }
      ]
    },
    {
      "name": "clickSearchBox",
      "compose": [
        {
          "element": "searchBox",
          "apply": "click"
        }
      ]
    },
    {
      "name": "search",
      "compose": [
        {
          "element": "searchBox",
          "apply": "clearAndType",
          "args": [
            {
              "name": "username",
              "type": "string"
            }
          ]
        }
      ]
    },
    {
      "name": "selectUser",
      "compose": [
        {
          "element": "searchResult",
          "apply": "click"
        }
      ]
    },
    {
      "name": "save",
      "compose": [
        {
          "element": "changeOwnerButton",
          "apply": "click"
        }
      ]
    }
  ]
}
