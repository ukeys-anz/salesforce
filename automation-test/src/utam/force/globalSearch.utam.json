{
  "root": true,
  "selector": {
    "css": "body"
  },
  "beforeLoad": [
    {
      "apply": "waitFor",
      "args": [
        {
          "type": "function",
          "predicate": [
            {
              "element": "root",
              "apply": "isVisible"
            }
          ]
        }
      ]
    }
  ],
  "elements": [
    {
      "name": "globalSearchButton",
      "selector": {
        "css": ".slds-global-header__item--search"
      },
      "type": "clickable",
      "public": true
    },
    {
      "name": "globalSearchPanel",
      "selector": {
        "css": "div.forceSearchAssistantDialog"
      },
      "elements": [
        {
          "name": "lightningInput",
          "public": true,
          "type": "salesforce-pageobjects/lightning/pageObjects/input",
          "selector": {
            "css": "lightning-input"
          }
        },
        {
          "name": "searchResultsList",
          "type": "anzx-utam-force/pageObjects/globalSearchResultsList",
          "selector": {
            "css": "search_dialog-instant-results-list"
          }
        }
      ]
    }
  ],
  "methods": [
    {
      "name": "search",
      "compose": [
        {
          "element": "globalSearchButton",
          "apply": "click"
        },
        {
          "element": "lightningInput",
          "apply": "setText",
          "args": [
            {
              "type": "string",
              "name": "searchTerm"
            }
          ]
        },
        {
          "element": "searchResultsList",
          "returnType": "anzx-utam-force/pageObjects/globalSearchResultsList"
        }
      ]
    }
  ]
}
