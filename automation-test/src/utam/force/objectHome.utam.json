{
  "root": true,
  "selector": {
    "css": "body"
  },
  "beforeLoad": [
    {
      "apply": "waitFor",
      "args": [
        {
          "type": "function",
          "predicate": [
            {
              "element": "root",
              "apply": "isVisible"
            }
          ]
        }
      ]
    }
  ],
  "elements": [
    {
      "name": "listViewPicker",
      "selector": {
        "css": ".forceListViewPicker"
      },
      "elements": [
        {
          "name": "listViewSelector",
          "selector": {
            "css": "[title='Select a List View']"
          },
          "type": "clickable"
        }
      ]
    },
    {
      "name": "listViewPickerPanel",
      "selector": {
        "css": ".listViewPickerPanel"
      },
      "elements": [
        {
          "name": "listViewSearchBar",
          "selector": {
            "css": "input"
          },
          "type": ["clickable", "editable"]
        },
        {
          "name": "listViewList",
          "selector": {
            "css": "[role='listbox']"
          },
          "elements": [
            {
              "name": "listView",
              "selector": {
                "css": "a"
              },
              "type": "clickable"
            },
            {
              "name": "listViews",
              "selector": {
                "css": "a",
                "returnAll": true
              },
              "type": "clickable",
              "public": true
            }
          ]
        }
      ]
    }
  ],
  "methods": [
    {
      "name": "searchListView",
      "compose": [
        {
          "element": "listViewSelector",
          "apply": "click"
        },
        {
          "element": "listViewSearchBar",
          "apply": "clearAndType",
          "args": [
            {
              "name": "listViewName",
              "type": "string"
            }
          ]
        },
        {
          "element": "listViewSearchBar",
          "apply": "click"
        }
      ]
    },
    {
      "name": "openListView",
      "compose": [
        {
          "element": "listView",
          "apply": "click"
        }
      ]
    }
  ]
}
