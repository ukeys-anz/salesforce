{
  "root": true,
  "selector": {
    "css": "body"
  },
  "beforeLoad": [
    {
      "apply": "waitFor",
      "args": [
        {
          "type": "function",
          "predicate": [
            {
              "element": "root",
              "apply": "isVisible"
            }
          ]
        }
      ]
    }
  ],
  "elements": [
    {
      "name": "listViewPicker",
      "selector": {
        "css": ".forceListViewPicker"
      },
      "type": "clickable",
      "elements": [
        {
          "name": "listViewSelector",
          "selector": {
            "css": "[title='Select a List View']"
          },
          "type": "clickable",
          "public": true
        }
      ]
    },
    {
      "name": "listViewPickerPanel",
      "selector": {
        "css": ".listViewPickerPanel"
      },
      "elements": [
        {
          "name": "listViewSearchBar",
          "selector": {
            "css": "input"
          },
          "type": ["clickable", "editable"]
        },
        {
          "name": "listViewList",
          "selector": {
            "css": "[role='listbox']"
          },
          "elements": [
            {
              "name": "listView",
              "selector": {
                "css": "a"
              },
              "type": "clickable"
            },
            {
              "name": "listViews",
              "selector": {
                "css": "a",
                "returnAll": true
              },
              "type": "clickable",
              "public": true
            }
          ]
        }
      ]
    },
    {
      "name": "firstRow",
      "selector": {
        "css": "tbody tr th span a"
      },
      "type": "clickable",
      "nullable": true,
      "public": true
    },
    {
      "name": "linkByRecordId",
      "selector": {
        "css": "a[data-recordid='%s']",
        "args": [
          {
            "name": "recordId",
            "type": "string"
          }
        ]
      },
      "public": true,
      "type": "clickable"
    },
    {
      "name": "listViewByIndex",
      "selector": {
        "css": "li:nth-child(%d) > a",
        "args": [
          {
            "name": "index",
            "type": "number"
          }
        ]
      },
      "type": "clickable"
    }
  ],
  "methods": [
    {
      "name": "openListViewPicker",
      "compose": [
        {
          "element": "listViewPicker",
          "apply": "click"
        }
      ]
    },
    {
      "name": "searchListView",
      "compose": [
        {
          "element": "listViewSelector",
          "apply": "click"
        },
        {
          "apply": "waitFor",
          "args": [
            {
              "type": "function",
              "predicate": [
                {
                  "element": "listViewSearchBar",
                  "apply": "isVisible"
                }
              ]
            }
          ]
        },
        {
          "element": "listViewSearchBar",
          "apply": "clearAndType",
          "args": [
            {
              "name": "listViewName",
              "type": "string"
            }
          ]
        },
        {
          "element": "listViewSearchBar",
          "apply": "click"
        }
      ]
    },
    {
      "name": "openListView",
      "compose": [
        {
          "element": "listView",
          "apply": "click"
        }
      ]
    },
    {
      "name": "openRecordById",
      "compose": [
        {
          "element": "linkByRecordId",
          "apply": "click"
        }
      ]
    },
    {
      "name": "openListViewByIndex",
      "compose": [
        {
          "apply": "openListViewPicker"
        },
        {
          "element": "listViewByIndex",
          "apply": "waitForVisible"
        },
        {
          "element": "listViewByIndex",
          "apply": "click"
        }
      ]
    },
    {
      "name": "openFirstRow",
      "compose": [
        {
          "apply": "waitFor",
          "args": [
            {
              "type": "function",
              "predicate": [
                {
                  "element": "firstRow",
                  "apply": "isVisible"
                }
              ]
            }
          ]
        },
        {
          "element": "firstRow",
          "apply": "click"
        }
      ]
    }
  ]
}
