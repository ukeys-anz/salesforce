{
  "shadow": {
    "elements": [
      {
        "name": "changeOwnerButton",
        "selector": {
          "css": "lightning-button-icon.change-owner-trigger"
        },
        "type": ["clickable"],
        "public": true
      },
      {
        "name": "lookup",
        "selector": {
          "css": "force-lookup"
        },
        "type": "anzx-utam-force/pageObjects/forceLookup"
      }
    ]
  },
  "methods": [
    {
      "name": "clickButton",
      "compose": [
        {
          "element": "changeOwnerButton",
          "apply": "click"
        }
      ]
    },
    {
      "name": "getOwnerName",
      "compose": [
        {
          "element": "lookup",
          "apply": "getOwnerNameText",
          "returnType": "string"
        }
      ]
    },
    {
      "name": "openForceLookUpLink",
      "compose": [
        {
          "element": "lookup",
          "apply": "openLookupLink"
        }
      ]
    }
  ]
}
