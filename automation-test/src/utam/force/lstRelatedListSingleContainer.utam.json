{
  "shadow": {
    "elements": [
      {
        "name": "lafProgressiveContainer",
        "selector": {
          "css": "laf-progressive-container"
        },
        "elements": [
          {
            "name": "lstRelatedListSingleAppBuilderMapper",
            "selector": {
              "css": "lst-related-list-single-app-builder-mapper"
            },
            "shadow": {
              "elements": [
                {
                  "name": "lstRelatedListViewManager",
                  "selector": {
                    "css": "lst-related-list-view-manager"
                  },
                  "shadow": {
                    "elements": [
                      {
                        "name": "lstCommonListInternal",
                        "selector": {
                          "css": "lst-common-list-internal"
                        },
                        "shadow": {
                          "elements": [
                            {
                              "name": "lstListViewManagerHeader",
                              "selector": {
                                "css": "lst-list-view-manager-header"
                              },
                              "shadow": {
                                "elements": [
                                  {
                                    "name": "actionsRibbon",
                                    "type": "salesforce-pageobjects/action/pageObjects/actionsRibbon",
                                    "selector": {
                                      "css": "runtime_platform_actions-actions-ribbon"
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "name": "lstPrimaryDisplayManager",
                              "selector": {
                                "css": "lst-primary-display-manager"
                              },
                              "shadow": {
                                "elements": [
                                  {
                                    "name": "lstPrimaryDisplay",
                                    "selector": {
                                      "css": "lst-primary-display"
                                    },
                                    "shadow": {
                                      "elements": [
                                        {
                                          "name": "lstPrimaryDisplayGrid",
                                          "selector": {
                                            "css": "lst-primary-display-grid"
                                          },
                                          "shadow": {
                                            "elements": [
                                              {
                                                "name": "lstCustomizedDatatable",
                                                "selector": {
                                                  "css": "lst-customized-datatable"
                                                },
                                                "shadow": {
                                                  "elements": [
                                                    {
                                                      "name": "listViewTableBody",
                                                      "selector": {
                                                        "css": "tbody"
                                                      },
                                                      "elements": [
                                                        {
                                                          "name": "listViewRowByIndex",
                                                          "type": "anzx-utam-force/pageObjects/listViewRow",
                                                          "selector": {
                                                            "css": "tr:nth-of-type(%d)",
                                                            "args": [
                                                              {
                                                                "name": "rowIndex",
                                                                "type": "number"
                                                              }
                                                            ]
                                                          },
                                                          "public": true
                                                        }
                                                      ]
                                                    }
                                                  ]
                                                }
                                              }
                                            ]
                                          }
                                        },
                                        {
                                          "name": "lstPrimaryDisplayCard",
                                          "selector": {
                                            "css": "lst-primary-display-card"
                                          },
                                          "shadow": {
                                            "elements": [
                                              {
                                                "name": "lstCustomizedTemplateList",
                                                "selector": {
                                                  "css": "lst-customized-template-list"
                                                },
                                                "shadow": {
                                                  "elements": [
                                                    {
                                                      "name": "itemByIndex",
                                                      "type": "anzx-utam-force/pageObjects/lstTemplateListItemFactory",
                                                      "selector": {
                                                        "css": "lst-template-list-item-factory:nth-of-type(%d)",
                                                        "args": [
                                                          {
                                                            "name": "itemInde",
                                                            "type": "number"
                                                          }
                                                        ]
                                                      },
                                                      "public": true
                                                    }
                                                  ]
                                                }
                                              }
                                            ]
                                          }
                                        }
                                      ]
                                    }
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "methods": [
    {
      "name": "clickButtonByTitle",
      "compose": [
        {
          "element": "actionsRibbon",
          "returnType": "salesforce-pageobjects/action/pageObjects/actionsRibbon"
        },
        {
          "chain": true,
          "element": "actionRendererWithTitle",
          "args": [
            {
              "name": "titleString",
              "type": "string"
            }
          ],
          "returnType": "salesforce-pageobjects/action/pageObjects/actionRenderer"
        },
        {
          "chain": true,
          "apply": "clickButton"
        }
      ]
    },
    {
      "name": "clickDropdownButtonByTitle",
      "args": [
        {
          "name": "buttonTitle",
          "type": "string"
        }
      ],
      "compose": [
        {
          "element": "actionsRibbon",
          "returnType": "salesforce-pageobjects/action/pageObjects/actionsRibbon"
        },
        {
          "chain": true,
          "apply": "getDropdownButton",
          "returnType": "salesforce-pageobjects/lightning/pageObjects/buttonMenu"
        },
        {
          "chain": true,
          "apply": "clickButton"
        },
        {
          "element": "actionsRibbon",
          "returnType": "salesforce-pageobjects/action/pageObjects/actionsRibbon"
        },
        {
          "chain": true,
          "element": "actionRendererWithTitle",
          "args": [
            {
              "name": "buttonTitle",
              "type": "argumentReference"
            }
          ],
          "returnType": "salesforce-pageobjects/action/pageObjects/actionRenderer"
        },
        {
          "chain": true,
          "element": "ribbonMenuItem",
          "returnType": "salesforce-pageobjects/action/pageObjects/ribbonMenuItem"
        },
        {
          "chain": true,
          "apply": "clickLinkItem"
        }
      ]
    }
  ]
}
