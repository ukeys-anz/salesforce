{
  "root": true,
  "selector": {
    "css": "body"
  },
  "beforeLoad": [
    {
      "apply": "waitFor",
      "args": [
        {
          "type": "function",
          "predicate": [
            {
              "element": "root",
              "apply": "isVisible"
            }
          ]
        }
      ]
    }
  ],
  "elements": [
    {
      "name": "modal",
      "selector": {
        "css": ".uiContainerManager"
      },
      "elements": [
        {
          "name": "deleteButton",
          "nullable": true,
          "selector": {
            "css": "[title='Delete']"
          },
          "type": "clickable",
          "public": true
        },
        {
          "name": "modalDetail",
          "nullable": true,
          "selector": {
            "css": ".detail"
          },
          "public": true
        }
      ]
    }
  ],
  "methods": [
    {
      "name": "userHasNoPermissionToDeleteChatterPost",
      "compose": [
        {
          "element": "deleteButton",
          "apply": "click"
        },
        {
          "apply": "waitFor",
          "args": [
            {
              "type": "function",
              "predicate": [
                {
                  "element": "modalDetail",
                  "apply": "isVisible"
                }
              ]
            }
          ]
        },
        {
          "element": "modalDetail",
          "apply": "getText",
          "matcher": {
            "type": "stringEquals",
            "args": [
              {
                "value": "You do not have permission to delete this comment"
              }
            ]
          }
        }
      ]
    }
  ]
}
