{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "webdriverIO-build/",
    "moduleResolution": "Node",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "baseUrl": "../node_modules",
    "types": [
      "node",
      "mocha",
      "@wdio/mocha-framework",
      "@wdio/sync",
      "expect-webdriverio"
    ],
    "target": "es6"
  },
  "include": [
    "webdriverIO/**/*.ts",
    "webdriverIO/**/*.js",
    "webdriverIO/**/*.d.ts"
  ]
}
