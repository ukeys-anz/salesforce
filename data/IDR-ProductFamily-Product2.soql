SELECT Id, Name, IDR_ANZ_com_Product_Category__c, IDR_ANZ_com_Unique_Product_Indicator__c, IDR_Workbasket__c,
(SELECT Id, Name, IsActive, ANZ_Product_Code__c, IDR_Product_or_Service_Line__c, IDR_Product_or_Service_Category__c,
IDR_Product_or_Service_Type__c, IDR_Workbasket__c
FROM Products__r
WHERE NOT(ANZ_Product_Code__c LIKE 'ANZ%' OR ANZ_Product_Code__c LIKE 'test%')
ORDER BY ANZ_Product_Code_Num__c)
FROM Product_Family__c
ORDER BY Name