{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "./build",
    "moduleResolution": "Node",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "baseUrl": "./node_modules",
    "types": [
      "node",
      "mocha",
      "@wdio/mocha-framework",
      "expect-webdriverio",
      "webdriverio/sync"
    ],
    "target": "es6"
  },
  "include": ["./suite/**/*.ts", "./suite/**/*.js", "./suite/**/*.d.ts"]
}
