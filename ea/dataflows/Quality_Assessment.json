{
  "nodes": {
    "augmentQualityAssessment": {
      "action": "augment",
      "parameters": {
        "leftKey": ["RecordTypeId"],
        "operation": "LookupSingleValue",
        "relationship": "RecordType",
        "rightKey": ["Id"],
        "rightSelect": ["DeveloperName", "Name"]
      },
      "sources": ["digestQualityAssessment", "digestRecordType"]
    },
    "digestCase": {
      "action": "sobjectDigest",
      "parameters": {
        "fields": [
          { "name": "Id" },
          { "name": "CaseNumber" },
          { "name": "Status" },
          { "name": "Type" }
        ],
        "object": "Case"
      }
    },
    "computeRating": {
      "action": "computeExpression",
      "parameters": {
        "computedFields": [
          {
            "label": "Score %",
            "name": "Score_p",
            "precision": 10,
            "saqlExpression": "Score__c/100",
            "scale": 2,
            "type": "Numeric"
          },
          {
            "label": "Met",
            "name": "Met_Expectations",
            "precision": 10,
            "saqlExpression": "case when 'Rating__c' == \"Met Expectations\" then 1 else 0 end",
            "scale": 2,
            "type": "Numeric"
          },
          {
            "label": "Did Not Meet",
            "name": "Did_Not_Meet",
            "precision": 10,
            "saqlExpression": "case when 'Rating__c' == \"Did Not Meet Expectations\" then 1 else 0 end",
            "scale": 2,
            "type": "Numeric"
          },
          {
            "label": "Exceeded",
            "name": "Exceeded_Expectations",
            "precision": 10,
            "saqlExpression": "case when 'Rating__c' == \"Exceeded Expectations\" then 1 else 0 end",
            "scale": 2,
            "type": "Numeric"
          }
        ],
        "mergeWithSource": true
      },
      "sources": ["augmentCase"]
    },
    "digestUser": {
      "action": "sobjectDigest",
      "parameters": {
        "fields": [
          { "name": "Id" },
          { "name": "UserRoleId" },
          { "name": "Name" },
          { "name": "FirstName" }
        ],
        "object": "User"
      }
    },
    "digestQualityAssessment": {
      "action": "sobjectDigest",
      "parameters": {
        "fields": [
          { "name": "CreatedDate" },
          { "name": "CreatedById" },
          { "name": "Rating__c" },
          { "name": "Score__c" },
          { "name": "Interaction_Type__c" },
          { "name": "Advice_Outcome__c" },
          { "name": "Compliance_Outcome__c" },
          { "name": "Status__c" },
          { "name": "Related_Case__c" },
          { "name": "Name" },
          { "name": "Issue_Type__c" },
          { "name": "Subsequent_Issue_Type__c" },
          { "name": "Evaluation_Type__c" },
          { "name": "Interaction_Date_Time__c" },
          { "name": "RecordTypeId" },
          { "name": "Interaction_Owner__c" }
        ],
        "object": "Quality_Assessment__c"
      }
    },
    "digestUserRole": {
      "action": "sobjectDigest",
      "parameters": {
        "fields": [{ "name": "Id" }, { "name": "Name" }],
        "object": "UserRole"
      }
    },
    "augmentUser": {
      "action": "augment",
      "parameters": {
        "leftKey": ["UserRoleId"],
        "operation": "LookupSingleValue",
        "relationship": "User",
        "rightKey": ["Id"],
        "rightSelect": ["Name"]
      },
      "sources": ["digestUser", "digestUserRole"]
    },
    "digestRecordType": {
      "action": "sobjectDigest",
      "parameters": {
        "fields": [
          { "name": "DeveloperName" },
          { "name": "Name" },
          { "name": "Id" }
        ],
        "object": "RecordType"
      }
    },
    "registerQualityAssessment": {
      "action": "register",
      "parameters": {
        "label": "Quality Assessment",
        "name": "Quality_Assessment"
      },
      "sources": ["computeRating"]
    },
    "augmentUserQA": {
      "action": "augment",
      "parameters": {
        "leftKey": ["Interaction_Owner__c"],
        "operation": "LookupSingleValue",
        "relationship": "Owner",
        "rightKey": ["Id"],
        "rightSelect": ["FirstName", "Name", "User.Name"]
      },
      "sources": ["augmentQualityAssessment", "augmentUser"]
    },
    "augmentCase": {
      "action": "augment",
      "parameters": {
        "leftKey": ["Related_Case__c"],
        "operation": "LookupSingleValue",
        "relationship": "Case",
        "rightKey": ["Id"],
        "rightSelect": ["CaseNumber", "Status", "Type"]
      },
      "sources": ["augmentUserQA", "digestCase"]
    }
  }
}
