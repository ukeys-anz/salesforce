{
  "nodes": {
    "RemoveDateFlags": {
      "action": "sliceDataset",
      "parameters": {
        "fields": [
          { "name": "RemoveDataFlag" },
          { "name": "days_since_snapshot" }
        ],
        "mode": "drop"
      },
      "sources": ["Filter1Year"]
    },
    "Products": {
      "action": "sobjectDigest",
      "parameters": {
        "fields": [
          { "name": "ProductCode" },
          { "name": "Name" },
          { "name": "Id" }
        ],
        "object": "Product2"
      }
    },
    "CalcHasBeenTransferred": {
      "action": "computeExpression",
      "parameters": {
        "computedFields": [
          {
            "defaultValue": "false",
            "label": "Has Been Transferred",
            "name": "HasBeenTransferred",
            "saqlExpression": "case \nwhen 'Case.CountOfTransfers' > 1\nthen \"true\"\nelse \"false\"\nend",
            "type": "Text"
          }
        ],
        "mergeWithSource": true
      },
      "sources": ["AppendCount"]
    },
    "AppendCount": {
      "action": "augment",
      "parameters": {
        "leftKey": ["Id"],
        "operation": "LookupMultiValue",
        "relationship": "Case",
        "rightKey": ["CaseId"],
        "rightSelect": ["CountOfTransfers"]
      },
      "sources": ["IncludeComplaintsOnly", "CalcCountOfTransfers"]
    },
    "CaseDuration": {
      "action": "computeExpression",
      "parameters": {
        "computedFields": [
          {
            "defaultValue": "0",
            "label": "CaseDuration_epoch",
            "name": "CaseDuration_epoch",
            "precision": 10,
            "saqlExpression": "(CreatedDate_sec_epoch - ClosedDate_sec_epoch)",
            "scale": 0,
            "type": "Numeric"
          },
          {
            "defaultValue": "0",
            "label": "CaseDuration_Hours",
            "name": "CaseDuration_Hours",
            "precision": 10,
            "saqlExpression": "(CreatedDate_sec_epoch - ClosedDate_sec_epoch)/60",
            "scale": 1,
            "type": "Numeric"
          }
        ],
        "mergeWithSource": true
      },
      "sources": ["CalcHasBeenTransferred"]
    },
    "MergeUserInfo": {
      "action": "augment",
      "parameters": {
        "leftKey": ["OwnerId"],
        "operation": "LookupSingleValue",
        "relationship": "UserInfo",
        "rightKey": ["Id"],
        "rightSelect": ["EmployeeNumber", "FirstName", "LastName"]
      },
      "sources": ["MergeEsclationList", "digest_User"]
    },
    "GenerateDaysSinceSnap": {
      "action": "computeExpression",
      "parameters": {
        "computedFields": [
          {
            "label": "days_since_snapshot",
            "name": "days_since_snapshot",
            "precision": 8,
            "saqlExpression": "date_diff(\"day\", toDate('Snapshot_Date_sec_epoch'),  now() )",
            "scale": 1,
            "type": "Numeric"
          }
        ],
        "mergeWithSource": true
      },
      "sources": ["Append_LatestSnapshot"]
    },
    "Extract_Existing_Data": {
      "action": "dataset",
      "parameters": { "name": "CMOS_Cases" }
    },
    "CaseDigest": {
      "action": "sobjectDigest",
      "parameters": {
        "fields": [
          { "name": "CaseNumber" },
          { "name": "CaseNumber__c" },
          { "name": "ContactId" },
          { "name": "CreatedById" },
          { "name": "CreatedDate" },
          { "name": "Fraud_Complicit_in_Fraud__c" },
          { "name": "Fraud_Customer_Event_Age__c" },
          { "name": "Fraud_Repeat_Victim__c" },
          { "name": "Fraud_Total_Customer_Loss__c" },
          { "name": "Fraud_Total_Falcon_Recalled__c" },
          { "name": "Fraud_Total_Fraud_Received__c" },
          { "name": "Fraud_Total_Fraud_Value__c" },
          { "name": "Fraud_Total_Recipient_Loss__c" },
          { "name": "Fraud_Total_Recovered__c" },
          { "name": "Fraud_Total_Reimbursed__c" },
          { "name": "Fraud_Total_Scam_Value__c" },
          { "name": "ClosedDate" },
          { "name": "Id" },
          { "name": "IsClosed" },
          { "name": "IsDeleted" },
          { "name": "IsEscalated" },
          { "name": "IsOwner__c" },
          { "name": "Origin" },
          { "name": "OwnerId" },
          { "name": "SLA_Status__c" },
          { "name": "Subject" },
          { "name": "Sub_Type__c" },
          { "name": "Type" },
          { "name": "Product__c" },
          { "name": "ProductId" },
          { "name": "Status" },
          { "name": "IDR_Date_Received__c" },
          { "name": "RecordTypeId" },
          { "name": "IDR_Financial_Compensation__c" },
          { "name": "IDR_Escalation_Reason__c" }
        ],
        "object": "Case"
      }
    },
    "digest_User": {
      "action": "sobjectDigest",
      "parameters": {
        "fields": [
          { "name": "Id" },
          { "name": "FirstName" },
          { "name": "LastName" },
          { "name": "EmployeeNumber" }
        ],
        "object": "User"
      }
    },
    "RecordType": {
      "action": "sobjectDigest",
      "parameters": {
        "fields": [
          { "name": "Name" },
          { "name": "Id" },
          { "name": "DeveloperName" }
        ],
        "object": "RecordType"
      }
    },
    "CountOfTransfers": {
      "action": "sobjectDigest",
      "parameters": {
        "fields": [
          { "name": "DataType" },
          { "name": "Field" },
          { "name": "CaseId" },
          { "name": "NewValue" },
          { "name": "OldValue" }
        ],
        "object": "CaseHistory",
        "passthroughFilter": "Field='Owner'"
      }
    },
    "Append_LatestSnapshot": {
      "action": "append",
      "parameters": { "enableDisjointedSchemaMerge": true },
      "sources": ["Snapshot_Text_Date", "Filter_Duplicate_Snapshot_Dates"]
    },
    "CasesOutput": {
      "action": "register",
      "parameters": { "label": "CMOS Cases", "name": "CMOS_Cases" },
      "sources": ["RemoveDateFlags"]
    },
    "MergeOnBoardingData": {
      "action": "augment",
      "parameters": {
        "leftKey": ["UserInfo.EmployeeNumber"],
        "operation": "LookupSingleValue",
        "relationship": "Onboarding",
        "rightKey": ["Salary_ID"],
        "rightSelect": [
          "Role",
          "Region",
          "State_Province",
          "Team_Branch",
          "Team_Code",
          "District",
          "Country",
          "Business"
        ]
      },
      "sources": ["MergeUserInfo", "digest_cmos_onboarding_csv"]
    },
    "FilterEscalationPickList": {
      "action": "filter",
      "parameters": { "filter": "EntityParticleId:EQ:Case.00N2N00000AA4RW" },
      "sources": ["PullPicklist"]
    },
    "snapshot_date": {
      "action": "computeExpression",
      "parameters": {
        "computedFields": [
          {
            "format": "yyyy-MM-dd",
            "isYearEndFiscalYear": true,
            "label": "Snapshot_Date",
            "name": "Snapshot_Date",
            "saqlExpression": "toDate(date_to_string(now(),\"yyyy-MM-dd\"),\"yyyy-MM-dd\")",
            "type": "Date"
          }
        ],
        "mergeWithSource": true
      },
      "sources": ["CaseDuration"]
    },
    "MergeEsclationList": {
      "action": "augment",
      "parameters": {
        "leftKey": ["IDR_Escalation_Reason__c"],
        "operation": "LookupSingleValue",
        "relationship": "Escalation",
        "rightKey": ["Value"],
        "rightSelect": ["Label"]
      },
      "sources": ["JoinRecordType", "FilterEscalationPickList"]
    },
    "digest_cmos_onboarding_csv": {
      "action": "dataset",
      "parameters": { "name": "CMOS_OnBoarding" }
    },
    "MergeCaseProduct": {
      "action": "augment",
      "parameters": {
        "leftKey": ["ProductId"],
        "operation": "LookupSingleValue",
        "relationship": "Product",
        "rightKey": ["Id"],
        "rightSelect": ["Name", "Id"]
      },
      "sources": ["CaseDigest", "Products"]
    },
    "MergeIssuePicklist": {
      "action": "augment",
      "parameters": {
        "leftKey": ["Type"],
        "operation": "LookupSingleValue",
        "relationship": "Picklist.Type",
        "rightKey": ["Label"],
        "rightSelect": ["Value", "Label"]
      },
      "sources": ["MergeCaseProduct", "FilterCaseTypes"]
    },
    "IncludeComplaintsOnly": {
      "action": "filter",
      "parameters": {
        "saqlFilter": "'Record.DeveloperName' in [\"Customer_Complaint\"]"
      },
      "sources": ["MergeOnBoardingData"]
    },
    "FilterOwnerOnly": {
      "action": "filter",
      "parameters": { "filter": "Field:EQ:Owner" },
      "sources": ["CountOfTransfers"]
    },
    "Filter_Duplicate_Snapshot_Dates": {
      "action": "filter",
      "parameters": { "filter": "RemoveDataFlag:EQ:false" },
      "sources": ["Compute_De_Dupe_Snapshot_Flag"]
    },
    "CalcCountOfTransfers": {
      "action": "computeExpression",
      "parameters": {
        "computedFields": [
          {
            "defaultValue": "0",
            "label": "Count Of Transfers",
            "name": "CountOfTransfers",
            "precision": 8,
            "saqlExpression": "1",
            "scale": 0,
            "type": "Numeric"
          }
        ],
        "mergeWithSource": true
      },
      "sources": ["FilterOwnerOnly"]
    },
    "PullPicklist": {
      "action": "sobjectDigest",
      "parameters": {
        "fields": [
          { "name": "DurableId" },
          { "name": "Label" },
          { "name": "Value" },
          { "name": "EntityParticleId" }
        ],
        "object": "PicklistValueInfo",
        "passthroughFilter": "EntityParticleId = 'Case.Type' OR EntityParticleId = 'Case.00N2N00000AA4RW'",
        "runtime": { "enablePKChunking": false }
      }
    },
    "Snapshot_Text_Date": {
      "action": "computeExpression",
      "parameters": {
        "computedFields": [
          {
            "label": "Snapshot_Text_Date",
            "name": "Snapshot_Text_Date",
            "saqlExpression": "toString(toDate('Snapshot_Date_sec_epoch'),\"yyyy-MM-dd\")",
            "type": "Text"
          }
        ],
        "mergeWithSource": true
      },
      "sources": ["snapshot_date"]
    },
    "FilterCaseTypes": {
      "action": "filter",
      "parameters": { "filter": "EntityParticleId:EQ:Case.Type" },
      "sources": ["PullPicklist"]
    },
    "JoinRecordType": {
      "action": "augment",
      "parameters": {
        "leftKey": ["RecordTypeId"],
        "operation": "LookupSingleValue",
        "relationship": "Record",
        "rightKey": ["Id"],
        "rightSelect": ["Name", "DeveloperName"]
      },
      "sources": ["MergeIssuePicklist", "RecordType"]
    },
    "Compute_De_Dupe_Snapshot_Flag": {
      "action": "computeExpression",
      "parameters": {
        "computedFields": [
          {
            "label": "RemoveDataFlag",
            "name": "RemoveDataFlag",
            "saqlExpression": "case when 'Snapshot_Text_Date' == date_to_string(now(),\"yyyy-MM-dd\") || 'Snapshot_Text_Date' == \"1900-01-01\" then \"true\" else \"false\" end",
            "type": "Text"
          }
        ],
        "mergeWithSource": true
      },
      "sources": ["Extract_Existing_Data"]
    },
    "Filter1Year": {
      "action": "filter",
      "parameters": { "saqlFilter": "'days_since_snapshot' < 365" },
      "sources": ["GenerateDaysSinceSnap"]
    }
  }
}
