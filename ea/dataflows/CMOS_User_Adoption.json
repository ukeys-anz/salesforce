{
  "nodes": {
    "RemoveDateFlags": {
      "action": "sliceDataset",
      "parameters": {
        "fields": [
          { "name": "days_since_snapshot" },
          { "name": "RemoveDataFlag" }
        ],
        "mode": "drop"
      },
      "sources": ["Filter1Year"]
    },
    "sfdcDigest_User": {
      "action": "sobjectDigest",
      "parameters": {
        "fields": [
          { "name": "EmployeeNumber" },
          { "name": "Id" },
          { "name": "FirstName" },
          { "name": "LastLoginDate" },
          { "name": "LastName" },
          { "name": "UserRoleId" },
          { "name": "ManagerId" },
          { "name": "IsActive" },
          { "name": "CompanyName" },
          { "name": "MediumPhotoUrl" }
        ],
        "object": "User"
      }
    },
    "augment_division_detail": {
      "action": "augment",
      "parameters": {
        "leftKey": ["EmployeeNumber"],
        "operation": "LookupSingleValue",
        "relationship": "Onboard",
        "rightKey": ["Salary_ID"],
        "rightSelect": [
          "Access_Level",
          "State_Province",
          "Team_Code",
          "First_Name",
          "Role",
          "Team_Branch",
          "Last_Name",
          "Salary_ID",
          "Country",
          "Region",
          "District",
          "Business",
          "Division"
        ]
      },
      "sources": ["augment_User", "digest_cmos_onboarding_csv"]
    },
    "augment_User": {
      "action": "augment",
      "parameters": {
        "leftKey": ["ManagerId"],
        "relationship": "ManagerId",
        "rightKey": ["Id"],
        "rightSelect": [
          "FirstName",
          "LastName",
          "EmployeeNumber",
          "IsActive",
          "CompanyName",
          "MediumPhotoUrl"
        ]
      },
      "sources": ["augment_User_UserRole", "sfdcDigest_User"]
    },
    "snapshot_date": {
      "action": "computeExpression",
      "parameters": {
        "computedFields": [
          {
            "firstDayOfWeek": 1,
            "format": "yyyy-MM-dd",
            "isYearEndFiscalYear": true,
            "label": "Snapshot_Date",
            "name": "Snapshot_Date",
            "saqlExpression": "toDate(date_to_string(now(),\"yyyy-MM-dd\"),\"yyyy-MM-dd\")",
            "type": "Date"
          }
        ],
        "mergeWithSource": true
      },
      "sources": ["DaysSinceLogin"]
    },
    "digest_cmos_onboarding_csv": {
      "action": "dataset",
      "parameters": { "name": "CMOS_OnBoarding" }
    },
    "GenerateDaysSinceSnap": {
      "action": "computeExpression",
      "parameters": {
        "computedFields": [
          {
            "defaultValue": "0",
            "label": "days_since_snapshot",
            "name": "days_since_snapshot",
            "precision": 8,
            "saqlExpression": "date_diff(\"day\", toDate('Snapshot_Date_sec_epoch'),  now() )",
            "scale": 2,
            "type": "Numeric"
          }
        ],
        "mergeWithSource": true
      },
      "sources": ["Append_LatestSnapshot"]
    },
    "DaysSinceLogin": {
      "action": "computeExpression",
      "parameters": {
        "computedFields": [
          {
            "defaultValue": "0",
            "label": "DaysSinceLogin",
            "name": "DaysSinceLogin",
            "precision": 10,
            "saqlExpression": "case when LastLoginDate_sec_epoch != 0 \nthen date_diff(\"day\", toDate(LastLoginDate_sec_epoch), now() )\nelse\n0\nend",
            "scale": 1,
            "type": "Numeric"
          }
        ],
        "mergeWithSource": true
      },
      "sources": ["augment_division_detail"]
    },
    "Extract_Existing_Data": {
      "action": "dataset",
      "parameters": { "name": "CMOS_Historic_User_Data" }
    },
    "Reg_CMOS_Historical_User_Data": {
      "action": "register",
      "parameters": {
        "label": "CMOS Historical User Data",
        "name": "CMOS_Historic_User_Data"
      },
      "sources": ["RemoveDateFlags"]
    },
    "Filter_Duplicate_Snapshot_Dates": {
      "action": "filter",
      "parameters": { "filter": "RemoveDataFlag:EQ:false" },
      "sources": ["Compute_De_Dupe_Snapshot_Flag"]
    },
    "sfdcDigest_UserRole": {
      "action": "sobjectDigest",
      "parameters": {
        "fields": [{ "name": "Name" }, { "name": "Id" }],
        "object": "UserRole"
      }
    },
    "augment_User_UserRole": {
      "action": "augment",
      "parameters": {
        "leftKey": ["UserRoleId"],
        "relationship": "UserRoleId",
        "rightKey": ["Id"],
        "rightSelect": ["Name"]
      },
      "sources": ["sfdcDigest_User", "sfdcDigest_UserRole"]
    },
    "Snap_To_Date": {
      "action": "computeExpression",
      "parameters": {
        "computedFields": [
          {
            "label": "Snapshot_Text_Date",
            "name": "Snapshot_Text_Date",
            "saqlExpression": "toString(toDate('Snapshot_Date_sec_epoch'),\"yyyy-MM-dd\")",
            "type": "Text"
          }
        ],
        "mergeWithSource": true
      },
      "sources": ["snapshot_date"]
    },
    "Compute_De_Dupe_Snapshot_Flag": {
      "action": "computeExpression",
      "parameters": {
        "computedFields": [
          {
            "label": "RemoveDataFlag",
            "name": "RemoveDataFlag",
            "saqlExpression": "case when 'Snapshot_Text_Date' == date_to_string(now(),\"yyyy-MM-dd\") || 'Snapshot_Text_Date' == \"1900-01-01\" then \"true\" else \"false\" end",
            "type": "Text"
          }
        ],
        "mergeWithSource": true
      },
      "sources": ["Extract_Existing_Data"]
    },
    "Append_LatestSnapshot": {
      "action": "append",
      "parameters": { "enableDisjointedSchemaMerge": true },
      "sources": ["Filter_Duplicate_Snapshot_Dates", "Snap_To_Date"]
    },
    "Filter1Year": {
      "action": "filter",
      "parameters": { "saqlFilter": "'days_since_snapshot' < 365" },
      "sources": ["GenerateDaysSinceSnap"]
    }
  }
}
