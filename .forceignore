force-app/main/default/profiles/Trial Customer Portal User.profile-meta.xml
Trial Customer Portal User.profile
#force-app/main/default/profiles/Admin.profile-meta.xml

# SFDX based permissions that are only available in Production
force-app/main/default/permissionsets/SFDX_Full_Dev_Hub_Access.permissionset

