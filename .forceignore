# List files or directories below to ignore them when running force:source:push, force:source:pull, and force:source:status
# More information: https://developer.salesforce.com/docs/atlas.en-us.sfdx_dev.meta/sfdx_dev/sfdx_dev_exclude_source.htm
#

package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest
**/__tests__/**

# Avoid weird conflicts and deployment errors
**appMenu
**appSwitcher
**profileSessionSettings
**profilePasswordPolicies

# Profiles not to pull nor push
# 2 entries per profile as per https://developer.salesforce.com/docs/atlas.en-us.sfdx_dev.meta/sfdx_dev/sfdx_dev_exclude_source.htm
force-app/main/default/profiles/Trial Customer Portal User.profile-meta.xml
Trial Customer Portal User.profile
#force-app/main/default/profiles/Admin.profile-meta.xml

# SFDX based permissions that are only available in Production
force-app/main/default/permissionsets/SFDX_Full_Dev_Hub_Access.permissionset

# Ignore all .md files (like README.md, not custom metadata types)
**.md
!**.md-meta.xml

# Ignoring sharing rules for now until the dx issue is fixed https://github.com/forcedotcom/cli/issues/136
# The sharing rule calculations makes scratch org creation to timeout with error sharing operation already in progress
#force-app/main/default/sharingRules/Case.sharingRules-meta.xml
force-app/main/default/sharingRules/User.sharingRules-meta.xml

# Don't pull because delegated authenticaton (and therefore IsSsoEnabled permission) cannot currently be enabled in scratch orgs
Enforce_SSO.permissionset

# Add this report because this will cause unexpected error in scratch orgs
force-app/main/default/reports/Knowledge_Reports/New_Knowledge_Article_with_Votes_I9l.report-meta.xml

# Obscure setting that is introduced each time a Health Check (Baseline Hardening) is run and actioned
SingleSignOn.settings

#myTrailhead profile since identity license is not in scratch orgs
force-app/main/default/profiles/ANZx Trailblazer User.profile-meta.xml

#auth provider to make the build pass and we do the manual deployment later
force-app/main/default/authproviders/Azure_AD_Custom_OIDC.authprovider-meta.xml
