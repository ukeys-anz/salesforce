  public virtual with sharing class RepaymentSummary extends CalloutModel {
    // Total Interest Payable for the loan taken from CAP Loan Repayments Summary
    @AuraEnabled
    public FabricType.FabricMoney totalInterestPayable { get; set; }

    // Required for repayments details from CAP Loan Repayments
    @AuraEnabled
    public String firstInterestDueDate { get; set; }

    // Required for repayments details from CAP Loan Repayments
    @AuraEnabled
    public String firstPrincipalDueDate { get; set; }

    // Amount of final P&I repayment taken from CAP Loan Repayments
    @AuraEnabled
    public FabricType.FabricMoney finalRepaymentAmount { get; set; }

    // The current loan amount used for CAP Repayment calculation.
    // This is a sum of the current payoff quote, any advanced to date amount, uncleared balances and additional funds requested.
    @AuraEnabled
    public FabricType.FabricMoney repaymentCalculationLoanAmount { get; set; }
