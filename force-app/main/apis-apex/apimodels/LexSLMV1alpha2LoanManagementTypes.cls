  // Repayments Details calculated for the Loan
  // https://github.com/anzx/apis/blob/-/anz/lexapis/lex/service/loanmanagement/v1alpha2/loanmanagement_types.proto#L553-L604
  public virtual with sharing class Repayments extends CalloutModel {
    // [Output] Unique ID for this calculation
    @AuraEnabled
    public String id { get; set; }

    // Repayment Type for the Loan Facility Config, e.g. P&I or Interest Only
    // OPTIONAL if the existing loan facility is retained (e.g, top-ups)
    // REQUIRED for new loan facility creation (e.g, refinancing).
    // Enum values:
    //   REPAYMENT_TYPE_UNSPECIFIED        = 0
    //   REPAYMENT_TYPE_PRINCIPAL_INTEREST = 1
    //   REPAYMENT_TYPE_INTEREST_ONLY      = 2
    @AuraEnabled
    public String type { get; set; }

    // Repayment Frequency
    // OPTIONAL if the existing loan facility is retained (e.g, top-ups)
    // REQUIRED for new loan facility creation (e.g, refinancing).
    // Enum values:
    //   REPAYMENT_FREQUENCY_UNSPECIFIED = 0
    //   REPAYMENT_FREQUENCY_WEEKLY      = 1
    //   REPAYMENT_FREQUENCY_FORTNIGHTLY = 2
    //   REPAYMENT_FREQUENCY_MONTHLY     = 3
    //   REPAYMENT_FREQUENCY_QUARTERLY   = 4
    //   REPAYMENT_FREQUENCY_HALF_YEARLY = 5
    //   REPAYMENT_FREQUENCY_YEARLY      = 6
    //   REPAYMENT_FREQUENCY_SEASONAL    = 7
    @AuraEnabled
    public String repaymentFrequency { get; set; }

    // Nominated Repayment Account
    // REQUIRED for new loan facility creation (e.g., refinancing).
    // - If the new loan facility includes P&I:
    // -- Set customer’s DLP account for principal repayments for the P&I term in initial_loan_term_details.from_account.
    // - If the new loan facility includes IO:
    // -- Set customer’s account for interest payments for the initial IO term in initial_loan_term_details.from_account.
    // -- Set customer’s DLP account for the subsequent repayments in subsequent_loan_term_details.from_account.
    // OPTIONAL if the existing loan facility is retained (e.g., top-ups).
    @AuraEnabled
    public String fromAccount { get; set; }

    // Repayment amount as displayed in the Letter of Offer.
    // initial_loan_term_details.amount:
    // - REQUIRED if the new loan facility includes P&I: Set repayment amount for the P&I term.
    // - OPTIONAL if the new loan facility includes IO: CAP internally calculates the interest amount for the initial IO term, so omit it.
    // subsequent_loan_term_details.amount:
    // - REQUIRED if the new loan facility includes IO: Set subsequent repayment amount for the rollover P&I term.
    @AuraEnabled
    public FabricType.FabricMoney amount { get; set; }

    // The total number of repayments for this term
    // This is Optional will only be populated for previews of proposed loan account changes.
    // For IO this will be taken from numOfInitialInterestPayments from CAP Loan Repayments
    // For P&I this will be taken from numOfPayments from CAP Loan Repayments
    @AuraEnabled
    public Integer numberOfRepayments { get; set; }
  }

  // https://github.com/anzx/apis/blob/-/anz/lexapis/lex/service/loanmanagement/v1alpha2/loanmanagement_types.proto#L1119-L1142
  public virtual with sharing class RestructureLoanApplication extends CalloutModel {
    // The Loans to be updated as part of the Loan Application
    // Currently we only expect a single LoanAccount to be restructured so one update_mask is sufficient
    // Once we allow updates to multiple loan accounts we will need to revisit this, and possibly:
    // - Change repeated LoanAccount to a map OR
    // - Bind a LoanAccount item together with it's respective field mask
    // Note, in the future we will move towards using LoanAccountPatch message instead of 2 separate fields for `loan_account` and `update_mask`
    @AuraEnabled
    public List<LoanAccount> loanAccount { get; set; }

    // The list of mutable fields to update on LoanAccount. Fields not listed will be ignored on input.
    // Fields are specified relative to the loan account
    // (e.g. `product_type`, `term_months`; *not* `request.product_type`, `request.term_months`).
    // Note that fields `name` and `account` are used to identify the loan account to be updated (restructured).
    // @AuraEnabled
    // public GoogleProtobuf_field_mask.FieldMask updateMask {get;set;}

    // The resulting Loan Application created for this Restructure.
    @AuraEnabled
    public String loanApplication { get; set; }

    // Preview of this loan account change
    @AuraEnabled
    public LoanAccountPreview preview { get; set; }
  }

