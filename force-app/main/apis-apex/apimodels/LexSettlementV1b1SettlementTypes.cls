    //   TYPE_GENERATE_LOO_DOCUMENT              = 3
    //   TYPE_GENERATE_MORTGAGE_DOCUMENT         = 4
    //   TYPE_ACCEPT_LOAN_OFFER                  = 5
    //   TYPE_ACCEPT_MORTGAGE_CONTRACT           = 6
    //   TYPE_UPLOAD_WITNESS_DOCUMENT            = 7
    //   TYPE_UPLOAD_BUILDING_INSURANCE_DOCUMENT = 8
    //   TYPE_SET_DRAWDOWN_ACCOUNT               = 9
    //   TYPE_CREATE_REPAYMENT_PREFERENCE        = 10
    //   TYPE_CREATE_RELEASE_AUTHORITY           = 11
    //   TYPE_VERIFY_BUILDING_INSURANCE_DOCUMENT = 12
    //   TYPE_CONFIRM_DRAWDOWN_ACCOUNT           = 13
    //   TYPE_CONFIRM_REPAYMENT_PREFERENCE       = 14
    //   TYPE_GENERATE_SIGNED_LOO_DOCUMENT       = 15
    //   TYPE_GENERATE_SIGNED_MORTGAGE_DOCUMENT  = 16
    //   TYPE_SET_LOAN_OFFSET_ACCOUNT            = 17
    //   TYPE_CONFIRM_LOAN_OFFSET_ACCOUNT        = 18
    //   TYPE_REVERIFY_KYC                       = 19
    @AuraEnabled
    public String type { get; set; }

    // Task Category
    // Enum values:
    //   CATEGORY_UNSPECIFIED              = 0
    //   CATEGORY_DOCUMENT                 = 1
    //   CATEGORY_ACCOUNT                  = 2
    //   CATEGORY_CUSTOMER_ACKNOWLEDGEMENT = 3
    @AuraEnabled
    public String category { get; set; }

    // [Output] Task Category
    // Enum values:
    //   STATE_UNSPECIFIED = 0
    //   STATE_PENDING     = 1
    //   STATE_COMPLETED   = 2
    @AuraEnabled
    public String state { get; set; }

    // [Output] The time the task was created
    @AuraEnabled
    public String createTime { get; set; }

    // [Output] List of Roles and specific Parties that are eligible to complete the Task
    // May have multiple records where several roles and/or parties are eligible to complete this task
    @AuraEnabled
    public List<TaskEligibility> eligibleToComplete { get; set; }

    // [Output] The time the task was completed
    @AuraEnabled
    public String completeTime { get; set; }

    // [Output] The party the task was completed by
    @AuraEnabled
    public PartyIdentifier completedBy { get; set; }
  }

