{
  "fieldConfig": {
    "title": "",
    "schema": [
      {
        "fieldLabel": "Accepted By",
        "fieldColumn": "partyId",
        "isRecordLink": true,
        "attributes": {
          "apexController": "GenericQueryController",
          "params": {
            "controller": "AccountQueryController",
            "method": "getAccountByOcvId",
