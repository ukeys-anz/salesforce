        "fieldColumn": "type",
        "isEnum": true,
        "enumValues": {
          "TYPE_UNSPECIFIED": "Unspecified",
          "TYPE_UPLOAD_LOO_DOCUMENT": "Upload Loo Document",
          "TYPE_UPLOAD_MORTGAGE_DOCUMENT": "Upload Mortgage Document",
          "TYPE_GENERATE_LOO_DOCUMENT": "Generate Loo Document",
          "TYPE_GENERATE_MORTGAGE_DOCUMENT": "Generate Mortgage Document",
          "TYPE_ACCEPT_LOAN_OFFER": "Accept Loan Offer",
          "TYPE_ACCEPT_MORTGAGE_CONTRACT": "Accept Mortgage Contract",
          "TYPE_UPLOAD_BUILDING_INSURANCE_DOCUMENT": "Upload Building Insurance Document",
          "TYPE_SET_DRAWDOWN_ACCOUNT": "Set Drawdown Account",
          "TYPE_CREATE_REPAYMENT_PREFERENCE": "Create Repayment Preference",
          "TYPE_CREATE_RELEASE_AUTHORITY": "Create Relese Authority",
          "TYPE_VERIFY_BUILDING_INSURANCE_DOCUMENT": "Verify Building Insurance Document",
          "TYPE_CONFIRM_DRAWDOWN_ACCOUNT": "Confirm Drawdown Account",
          "TYPE_CONFIRM_REPAYMENT_PREFERENCE": "Confirm Repayment Preference",
          "TYPE_GENERATE_SIGNED_LOO_DOCUMENT": "Generate Signed Loo Document",
          "TYPE_GENERATE_SIGNED_MORTGAGE_DOCUMENT": "Generate Signed Mortgage Document",
          "TYPE_SET_LOAN_OFFSET_ACCOUNT": "Set Loan Offset Account",
          "TYPE_CONFIRM_LOAN_OFFSET_ACCOUNT": "Confirm Loan Offset Account",
          "TYPE_REVERIFY_KYC": "Reverify KYC"
        }
      },
      {
        "fieldtype": "lightning-formatted-text",
        "fieldLabel": "Completed Date",
        "fieldColumn": "completeTime",
        "isDate": true
      },
      {
        "fieldLabel": "Completed By",
        "fieldColumn": "completedBy.id",
        "isRecordLink": true,
        "attributes": {
          "apexController": "GenericQueryController",
          "params": {
            "controller": "AccountQueryController",
            "method": "getAccountByOcvId",
            "args": {
              "ocvId": "{completedBy.id}"
            }
          },
          "objectName": "Account",
          "recordName": "Name",
          "fields": ["Name", "OCV_ID__c"]
        }
      }
    ],
    "layoutconfig": {
      "layout": {
        "horizontalAlign": "spread",
        "verticalAlign": "end",
        "pull-to-boundary": "medium"
      },
      "layoutitem": {
        "flexibility": "auto",
        "padding": "around-small",
        "size": "6"
      }
    }
  },
  "tableConfig": [
    {
      "title": "Eligible To Complete",
      "dataPath": "eligibleToComplete",
      "columns": [
        {
          "type": "text",
          "label": "Role",
          "fieldName": "role",
          "hideDefaultActions": true,
          "cellAttributes": {
            "alignment": "left"
          },
          "sortable": true,
          "isEnum": true,
          "enumValues": {
            "ROLE_UNSPECIFIED": "Unspecified",
            "ROLE_APPLICANT": "Customer",
            "ROLE_LEX_SYSTEM": "Settlement System",
            "ROLE_COACH": "Coach"
          }
        },
        {
          "type": "text",
          "label": "Loan Applicant",
          "fieldName": "party.id",
          "hideDefaultActions": true,
          "cellAttributes": {
            "alignment": "left"
          },
          "sortable": true
        }
      ]
    }
