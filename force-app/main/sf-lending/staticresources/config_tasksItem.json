{
  "cardTitle": "Customer Action",
  "fieldConfig": {
    "title": "",
    "schema": [
      {
        "fieldtype": "lightning-formatted-text",
        "fieldLabel": "Status",
        "fieldColumn": "state",
        "isEnum": true,
        "enumValues": {
          "STATE_UNSPECIFIED": "Unspecified",
          "STATE_PENDING": "Pending",
          "STATE_COMPLETED": "Completed"
        }
      },
      {
        "fieldtype": "lightning-formatted-text",
        "fieldLabel": "Category",
        "fieldColumn": "category",
        "isEnum": true,
        "enumValues": {
          "CATEGORY_UNSPECIFIED": "Unspecified",
          "CATEGORY_DOCUMENT": "Document",
          "CATEGORY_ACCOUNT": "Account",
          "CATEGORY_CUSTOMER_ACKNOWLEDGEMENT": "Customer Acknowledgement"
        }
      },
      {
        "fieldtype": "lightning-formatted-text",
        "fieldLabel": "Created Date",
        "fieldColumn": "createTime",
        "isDate": true
      },
      {
        "fieldtype": "lightning-formatted-text",
