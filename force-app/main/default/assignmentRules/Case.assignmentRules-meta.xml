<?xml version="1.0" encoding="UTF-8"?>
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>Case Allocation Rule</fullName>
        <active>true</active>
        <ruleEntry>
            <assignedTo>Digital_Fraud_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>
            AND(                  
                OR(
                    ISNEW(),
                    ISCHANGED(Submitted__c)
                  )
                &amp;&amp; Submitted__c = true,
                OR(
                    RecordType.DeveloperName = &quot;NPP_Dispute&quot;,
                    RecordType.DeveloperName = &quot;BPAY_Dispute&quot;
                ),              
                ISPICKVAL(
                    Dispute_Reason__c, &quot;Unauthorised Transaction&quot;
                )                 
            )
            </formula>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Support_Coach_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>
            AND(
                OR(
                    ISNEW(),
                    ISCHANGED(Submitted__c)
                )
                &amp;&amp; Submitted__c = true,
                OR(
                    RecordType.DeveloperName = &quot;NPP_Dispute&quot;,
                    RecordType.DeveloperName = &quot;BPAY_Dispute&quot;
                ),             
                NOT(
                    ISPICKVAL(Dispute_Reason__c, &quot;Unauthorised Transaction&quot;)
                )
            )
            </formula>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Support_Coach_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>
            AND(                     
                OR(
                    ISNEW(),
                    ISCHANGED(Submitted__c)
                   )
                &amp;&amp; Submitted__c = true,
                OR(
                    RecordType.DeveloperName = &quot;Direct_Debit_Dispute&quot;,
                    RecordType.DeveloperName = &quot;Direct_Entry_Dispute&quot;
                  )
                )
            </formula>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Support_Coach_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>
            AND(
                    ISNEW(),
                    RecordType.DeveloperName = &quot;General_Inquiry&quot;,
                    OR (
                        AND (
                            
                            ISPICKVAL(Type, &quot;Cards&quot;),
                            OR(
                                INCLUDES(Sub_Type__c, &quot;VAU Opt-In&quot;),
                                INCLUDES(Sub_Type__c, &quot;VAU Opt-Out&quot;),
                                INCLUDES(Sub_Type__c, &quot;Merchant Refund&quot;)
                            )
                        ),
                        AND (
                            ISPICKVAL(Type, &quot;Money&quot;),
                            OR(
                                INCLUDES(Sub_Type__c, &quot;ATM Cash Deposit Dispute&quot;),
                                INCLUDES(Sub_Type__c, &quot;ATM Cheque Deposit Dispute&quot;)
                            )
                        ),
                        AND (

                            ISPICKVAL(Type, &quot;PayID Issue/Dispute&quot;),
                            OR(
                                INCLUDES(Sub_Type__c, &quot;PayID technical issue&quot;),
                                INCLUDES(Sub_Type__c, &quot;Email PayID already registered&quot;),
                                INCLUDES(Sub_Type__c, &quot;Mobile PayID already registered&quot;)
                            )
                        )
                    )
                    )
            </formula>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Card_Dispute_General_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>
            AND(
                OR(
                    ISNEW(),
                    ISCHANGED(Submitted__c)
                  )
                &amp;&amp; Submitted__c = true,
                OR(
                    RecordType.DeveloperName = &quot;ATM_Dispute&quot;,
                    RecordType.DeveloperName = &quot;Card_Dispute&quot;
                  ),
                NOT(ISPICKVAL(Dispute_Reason__c, &quot;Didn&apos;t authorise transaction&quot;)),
                NOT(ISPICKVAL(Dispute_Reason__c, &quot;Fraudulent transaction&quot;)),
                NOT(ISPICKVAL(Dispute_Reason__c, &quot;Unauthorised transaction&quot;))
                )
            </formula>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Card_Dispute_Fraud_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>
            AND(
                OR(
                    ISNEW(),
                    ISCHANGED(Submitted__c)
                    )
                &amp;&amp; Submitted__c = true,
                OR(
                    RecordType.DeveloperName = &quot;ATM_Dispute&quot;,
                    RecordType.DeveloperName = &quot;Card_Dispute&quot;
                  ),
                OR(
                    ISPICKVAL(Dispute_Reason__c, &quot;Didn&apos;t authorise transaction&quot;),
                    ISPICKVAL(Dispute_Reason__c, &quot;Fraudulent transaction&quot;),
                    ISPICKVAL(Dispute_Reason__c, &quot;Unauthorised transaction&quot;)
                  )
                )
            </formula>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Coach_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>
                AND(
                    ISNEW(),
                    RecordType.DeveloperName = &quot;General_Inquiry_CMOS&quot;,   
                    ISPICKVAL(Origin, &quot;ANZ Plus Web&quot;),
                    OR(
                        ISPICKVAL(IDR_Product_Category__c, &quot;Cheque/Savings accounts&quot;),
                        ISPICKVAL(IDR_Product_Category__c, &quot;Not product related&quot;),
                        ISPICKVAL(IDR_Product_Category__c, &quot;ANZ Plus&quot;)
                    ),
                    ANZx_Customer__c = true
                )
            </formula>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>BOH_Coach_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>
                AND(
                    ISNEW(),
                    RecordType.DeveloperName = &quot;General_Inquiry_CMOS&quot;,   
                    ISPICKVAL(Origin, &quot;ANZ Plus Web&quot;),
                    ISPICKVAL(IDR_Product_Category__c, &quot;Home loans&quot;),
                    ANZx_Customer__c = true
                )
            </formula>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Pending_KYC_QA</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>
            AND(
                ISNEW(),
                RecordType.DeveloperName = &quot;KYC_QA&quot;
            )
            </formula>
        </ruleEntry>
        <ruleEntry>
            <formula>AND(NOT(ISNEW()), RecordType.DeveloperName = &quot;KYC_QA&quot;)</formula>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>COB_ID_Ops_Assistance_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>AND( ISNEW(), RecordType.DeveloperName = &quot;ID_Ops_Assistance&quot; )</formula>
        </ruleEntry>
        <ruleEntry>
            <formula>AND(NOT(ISNEW()), RecordType.DeveloperName = &quot;ID_Ops_Assistance&quot;)</formula>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>No_CAD_Credit_Referral_Case_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>
                AND(ISNEW(), RecordType.DeveloperName = &quot;Credit_Referral&quot;, Case_Authority_Level__c = &quot;NO CAD&quot;)
            </formula>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>CAD_Credit_Referral_Case_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>
                AND(ISNEW(), RecordType.DeveloperName = &quot;Credit_Referral&quot;, Case_Authority_Level__c != &quot;NO CAD&quot;)
            </formula>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Digital_Fraud_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>AND(ISNEW(), RecordType.DeveloperName = &quot;General_Inquiry&quot;,  ISPICKVAL(Type,&quot;Fraud&quot;),  BOH_Fraud_Case__c = TRUE)</formula>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>BOH_Coach_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>
                AND(
                    ISNEW(), 
                    RecordType.DeveloperName = &quot;ANZx_Complaint&quot;,
                    ISPICKVAL(Origin, &quot;ANZ Plus App&quot;),
                    ISPICKVAL(IDR_Product_Category__c,&quot;Home loans&quot; ),
                    ANZx_Customer__c = true 
                )
            </formula>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Coach_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>
                AND( 
                    ISNEW(), 
                    RecordType.DeveloperName = &quot;ANZx_Complaint&quot;,
                    ISPICKVAL(Origin, &quot;ANZ Plus App&quot;),
                    ANZx_Customer__c = true 
                )
            </formula>
        </ruleEntry>
    </assignmentRule>
</AssignmentRules>
