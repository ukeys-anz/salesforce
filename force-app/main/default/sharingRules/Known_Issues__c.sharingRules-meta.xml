<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Share_Known_Issues_with_ANZ_Users</fullName>
        <accessLevel>Read</accessLevel>
        <description>Sharing known issues records, read only for creating express cmos complaints</description>
        <label>Share Known Issues with ANZ Users</label>
        <sharedTo>
            <roleAndSubordinates>ANZ</roleAndSubordinates>
        </sharedTo>
        <criteriaItems>
            <field>Is_Active__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Share_Known_Issues_with_ANZx_Users</fullName>
        <accessLevel>Read</accessLevel>
        <description>Sharing known issues records, read only for creating non customer complaints</description>
        <label>Share Known Issues with ANZx Users</label>
        <sharedTo>
            <roleAndSubordinates>ANZx</roleAndSubordinates>
        </sharedTo>
        <criteriaItems>
            <field>Is_Active__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
