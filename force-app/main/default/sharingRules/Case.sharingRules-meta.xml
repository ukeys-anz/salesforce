<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>CRI_RT_Complaints_PG_AllIDRUsers_RW</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Grant read and write access on complaint records for all IDR users</description>
        <label>CRI_RT-Complaints_PG-AllIDRUsers-RW</label>
        <sharedTo>
            <group>All_IDR_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Customer Complaint,Non-Customer Complaint</value>
        </criteriaItems>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>CRI_RT_SI_PG_AllIDRUsers_RO</fullName>
        <accessLevel>Read</accessLevel>
        <description>Grant read access on systemic issue records for CMOS users</description>
        <label>CRI_RT-SI_PG-AllIDRUsers-RO</label>
        <sharedTo>
            <group>All_IDR_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Systemic Issue</value>
        </criteriaItems>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>CRI_RT_SI_PG_SiTeam_RW</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Grant read and write access on systemic issue records for SI team members</description>
        <label>CRI_RT-SI_PG-SiTeam-RW</label>
        <sharedTo>
            <group>Systemic_Issue_Team</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Systemic Issue</value>
        </criteriaItems>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Fraud_RTs_FraudXAgents_RW</fullName>
        <accessLevel>Edit</accessLevel>
        <description>All Cases having Fraud related record types are to be shared with FraudX Agents with Read/Write access.</description>
        <label>Fraud_RTs-FraudXAgents-RW</label>
        <sharedTo>
            <role>FraudX_Agent</role>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Fraud,Scam,Identity,Recipient/Mule</value>
        </criteriaItems>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>GeneralEnquiry_RT_FraudXAgents_RO</fullName>
        <accessLevel>Read</accessLevel>
        <description>All Cases having &quot;General Enquiry&quot; record type are to be shared with FraudX Agents with Read-Only access.</description>
        <label>GeneralEnquiry_RT-FraudXAgents-RO</label>
        <sharedTo>
            <role>FraudX_Agent</role>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>General Inquiry</value>
        </criteriaItems>
