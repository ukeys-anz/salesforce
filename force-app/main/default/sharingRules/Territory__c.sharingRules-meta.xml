<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>ANZ_Mobile_Lending_Support_Team_Territory_Sharing</fullName>
        <accessLevel>Edit</accessLevel>
        <description>This sharing rule is used to share territory (Edit Access) records with ANZ Mobile Lending Support Team members</description>
        <label>ANZ Mobile Lending Support Team Territory Sharing</label>
        <sharedTo>
            <role>ANZ_Mobile_Lending_Support_Team</role>
        </sharedTo>
        <criteriaItems>
            <field>CreatedById</field>
            <operation>notEqual</operation>
            <value/>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
