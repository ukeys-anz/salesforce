<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Customer_Action_Extra_Care_Hub_Read_Only</fullName>
        <accessLevel>Read</accessLevel>
        <description>This sharing setting is used to provide Customer Actions Read only access to Extra Care Hub users</description>
        <label>Customer Action Extra Care Hub Read Only</label>
        <sharedTo>
            <group>ANZx_Read_Only_Group</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Customer Action,Loan Offer Acceptance,Mortgage Contract Acceptance</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Customer_Action_Read_Only</fullName>
        <accessLevel>Read</accessLevel>
        <description>Read only for anzx roles</description>
        <label>Customer Action Read Only</label>
        <sharedTo>
            <roleAndSubordinatesInternal>ANZx</roleAndSubordinatesInternal>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Customer Action,Loan Offer Acceptance,Mortgage Contract Acceptance</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Settlement_Role_Read_Write</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Access for settlement officer and settlement lead</description>
        <label>Settlement Role Read/Write</label>
        <sharedTo>
            <roleAndSubordinatesInternal>Settlement_Officer_Lead</roleAndSubordinatesInternal>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Customer Action,Loan Offer Acceptance,Mortgage Contract Acceptance</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Customer_Notification_Action_Access</fullName>
        <accessLevel>Read</accessLevel>
        <description>This sharing rule will give access to Customer Notification Action type customer action</description>
        <label>Customer Notification Action Access</label>
        <sharedTo>
            <allInternalUsers/>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Customer Notification Action</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
