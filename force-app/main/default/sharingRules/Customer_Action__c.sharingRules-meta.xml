<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Customer_Action_Extra_Care_Hub_Read_Only</fullName>
        <accessLevel>Read</accessLevel>
        <description>This sharing setting is used to provide Customer Actions Read only access to Extra Care Hub users</description>
        <label>Customer Action Extra Care Hub Read Only</label>
        <sharedTo>
            <group>ANZx_Read_Only_Group</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Customer Action,Loan Offer Acceptance,Mortgage Contract Acceptance</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Customer_Action_Read_Only</fullName>
        <accessLevel>Read</accessLevel>
        <description>Read only for anzx roles</description>
        <label>Customer Action Read Only</label>
        <sharedTo>
            <roleAndSubordinates>ANZx</roleAndSubordinates>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Customer Action,Loan Offer Acceptance,Mortgage Contract Acceptance</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Financial_Account_Signatory_Update</fullName>
        <accessLevel>Edit</accessLevel>
        <description>To share the Customer Action record created for Number of Signatory update</description>
        <label>Financial Account Signatory Update</label>
        <sharedTo>
            <group>Update_Signatory_Customer_Action_Sharing</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Pending Financial Account Updates</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Settlement_Role_Read_Write</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Access for settlement officer and settlement lead</description>
        <label>Settlement Role Read/Write</label>
        <sharedTo>
            <roleAndSubordinates>Settlement_Officer_Lead</roleAndSubordinates>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Customer Action,Loan Offer Acceptance,Mortgage Contract Acceptance</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
