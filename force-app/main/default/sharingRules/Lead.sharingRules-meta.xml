<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>ANZX_Leads_RW</fullName>
        <accessLevel>Edit</accessLevel>
        <description>All Leads having ANZX Leads record type are to be shared with Coaches, Coach Leads, Support Coaches and Business Admins with Read/Write access.</description>
        <label>ANZX_Leads_Coaches_RW</label>
        <sharedTo>
            <group>Lead_Read_Write_Roles</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>ANZX Leads</value>
        </criteriaItems>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>ANZX_Leads_QA_RO</fullName>
        <accessLevel>Read</accessLevel>
        <description>All Leads having ANZX Leads record type are to be shared with Quality Analysts with Read/Only access.</description>
        <label>ANZX_Leads_QA_RO</label>
        <sharedTo>
            <role>Quality_Analyst</role>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>ANZX Leads</value>
        </criteriaItems>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>CCRM_Lead_Read_Only_Sharing_Rule</fullName>
        <accessLevel>Read</accessLevel>
        <label>CCRM Lead Read Only Sharing Rule</label>
        <sharedTo>
            <roleAndSubordinates>Commercial_Banking</roleAndSubordinates>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Commercial CRM Lead</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>CCRM_LeadEditAccessToCLO</fullName>
        <accessLevel>Edit</accessLevel>
        <description>All CCRM Leads will be accessible to CLO in Edit Mode</description>
        <label>CCRM_LeadEditAccessToCLO</label>
        <sharedTo>
            <roleAndSubordinates>Commercial_Lending_Operations</roleAndSubordinates>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Commercial CRM Lead</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingOwnerRules>
        <fullName>CCRM_SBB_NBC_Lead_Read_Write_Sharing</fullName>
        <accessLevel>Edit</accessLevel>
        <description>It will provide the Read/Write access on Lead for SBB NBC User.</description>
        <label>CCRM SBB NBC Lead Read Write Sharing</label>
        <sharedTo>
            <roleAndSubordinates>Small_Business_Banking_NBC</roleAndSubordinates>
        </sharedTo>
        <sharedFrom>
            <roleAndSubordinates>Small_Business_Banking_NBC</roleAndSubordinates>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>MLCRM_Support_Team_Lead_Sharing</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Sharing rule to open up access from ML Support Team to ML Team.</description>
        <label>MLCRM Support Team Lead Sharing</label>
        <sharedTo>
            <role>ANZ_Mobile_Lending_Team</role>
        </sharedTo>
        <sharedFrom>
            <role>ANZ_Mobile_Lending_Support_Team</role>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>MLCRM_ANZ_Mobile_Lending_Team_Self_Lead_Sharing</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Sharing rule to open up access from ML Team to peer users with role ANZ Mobile Lending Team assigned</description>
        <label>MLCRM ANZ Mobile Lending Team Self Lead Sharing</label>
        <sharedTo>
            <role>ANZ_Mobile_Lending_Team</role>
        </sharedTo>
        <sharedFrom>
            <role>ANZ_Mobile_Lending_Team</role>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>MLCRM_Support_Team_Lead_Self_Sharing</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Sharing rule to open up access from ML Team to peer users with role ANZ Mobile Lending Support Team assigned</description>
        <label>MLCRM Support Team Lead Self Sharing</label>
        <sharedTo>
            <role>ANZ_Mobile_Lending_Support_Team</role>
        </sharedTo>
        <sharedFrom>
            <role>ANZ_Mobile_Lending_Support_Team</role>
        </sharedFrom>
    </sharingOwnerRules>
</SharingRules>
