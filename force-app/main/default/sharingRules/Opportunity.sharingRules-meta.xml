<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>CCRM_Opportunity_Sharing_Rule</fullName>
        <accessLevel>Read</accessLevel>
        <label>CCRM Opportunity Sharing Rule</label>
        <sharedTo>
            <group>BB_SBB_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Commercial Opportunity</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingOwnerRules>
        <fullName>Opportunity_Sharing_for_ANZ_User_Role</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Opportunity Sharing for ANZ User Role</label>
        <sharedTo>
            <role>ANZ</role>
        </sharedTo>
        <sharedFrom>
            <roleAndSubordinates>ANZ</roleAndSubordinates>
        </sharedFrom>
    </sharingOwnerRules>
</SharingRules>
