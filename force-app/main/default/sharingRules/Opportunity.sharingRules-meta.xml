        <label>MLCRM Share Opportunities</label>
        <sharedTo>
            <roleAndSubordinates>ANZ_Mobile_Lending_Support_Team</roleAndSubordinates>
        </sharedTo>
        <sharedFrom>
            <roleAndSubordinates>ANZ_Mobile_Lending_Team</roleAndSubordinates>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>MLCRM_BusinessAdmin_RW_Sharing_Opportunities</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Sharing rule to open up access from ML Team to Business Admin Role users.</description>
        <label>MLCRM Business Admin RW Sharing Opportunities</label>
        <sharedTo>
            <role>Business_Admin</role>
        </sharedTo>
        <sharedFrom>
            <roleAndSubordinates>ANZ_Mobile_Lending_Team</roleAndSubordinates>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
