        <sharedTo>
            <role>ANZ_Mobile_Lending_Team</role>
        </sharedTo>
        <sharedFrom>
            <role>ANZ_Mobile_Lending_Team</role>
        </sharedFrom>
    </sharingOwnerRules>
</SharingRules>
