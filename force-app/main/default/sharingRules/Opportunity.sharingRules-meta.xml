<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>CCRM_Opportunity_Read_Only_Sharing_Rule</fullName>
        <accessLevel>Read</accessLevel>
        <label>CCRM Opportunity Read Only Sharing Rule</label>
        <sharedTo>
            <roleAndSubordinates>Commercial_Banking</roleAndSubordinates>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Commercial Opportunity</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>CCRM_Opportunity_CLO_Sharing_Rule</fullName>
        <accessLevel>Edit</accessLevel>
        <label>CCRM Opportunity CLO Sharing Rule</label>
        <sharedTo>
            <roleAndSubordinates>Commercial_Lending_Operations</roleAndSubordinates>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Commercial Opportunity</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingOwnerRules>
        <fullName>MLCRM_Share_Opportunities</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Sharing rule to open up access from ML Team to ANZ Support Team with ML Group.</description>
        <label>MLCRM Share Opportunities</label>
        <sharedTo>
            <roleAndSubordinates>ANZ_Mobile_Lending_Support_Team</roleAndSubordinates>
        </sharedTo>
        <sharedFrom>
            <roleAndSubordinates>ANZ_Mobile_Lending_Team</roleAndSubordinates>
        </sharedFrom>
    </sharingOwnerRules>
</SharingRules>
