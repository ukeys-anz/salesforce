        <label>MLCRM Support Team Opportunities Sharing</label>
        <sharedTo>
            <role>ANZ_Mobile_Lending_Team</role>
        </sharedTo>
        <sharedFrom>
            <roleAndSubordinates>ANZ_Mobile_Lending_Support_Team</roleAndSubordinates>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>MLCRM_Support_Team_Opportunities_Self_Sharing</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Sharing rule to open up access from ANZ Mobile Lending Support Team to peer users with role ANZ Mobile Lending Support Team assigned</description>
        <label>MLCRM Support Team Opportunities Self Sharing</label>
        <sharedTo>
            <roleAndSubordinates>ANZ_Mobile_Lending_Support_Team</roleAndSubordinates>
        </sharedTo>
        <sharedFrom>
            <roleAndSubordinates>ANZ_Mobile_Lending_Support_Team</roleAndSubordinates>
