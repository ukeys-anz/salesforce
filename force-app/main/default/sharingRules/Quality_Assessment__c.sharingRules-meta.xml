<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>ANZX_QA_RW</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Sharing rule to share edit access for Quality_Assessment__c to Roles : Quality &amp; Capability Lead, Quality Analyst, and Business_Admin.</description>
        <label>ANZX_QA_RW</label>
        <sharedTo>
            <group>QA_Read_Write_Roles</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Get Help,Join</value>
        </criteriaItems>
    </sharingCriteriaRules>
