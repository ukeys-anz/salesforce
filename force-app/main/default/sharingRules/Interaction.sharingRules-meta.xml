<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Interaction_Business_Admin_Read_Write_Sharing_Rule</fullName>
        <accessLevel>Edit</accessLevel>
        <description>This sharing rule provides read/write access to the business admin role for Interaction object</description>
        <label>Interaction Business Admin Read/Write Sharing Rule</label>
        <sharedTo>
            <role>Business_Admin</role>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
