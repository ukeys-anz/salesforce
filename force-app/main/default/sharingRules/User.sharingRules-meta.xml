<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingOwnerRules>
        <fullName>Grant_Read_Access_within_ANZx</fullName>
        <accessLevel>Read</accessLevel>
        <description>Allow all ANZx users to see other ANZx users</description>
        <label>Grant Read Access within ANZx</label>
        <sharedTo>
            <roleAndSubordinates>ANZx</roleAndSubordinates>
        </sharedTo>
        <sharedFrom>
            <roleAndSubordinates>ANZx</roleAndSubordinates>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>Grant_Read_Access_on_Engineer_User_Records_for_Engineers</fullName>
        <accessLevel>Read</accessLevel>
        <description>Rule to provide &apos;Read&apos; access to all Engineer User records for Engineers.</description>
        <label>Grant Read Access on Engineer User Records for Engineers</label>
        <sharedTo>
            <role>Engineer</role>
        </sharedTo>
        <sharedFrom>
            <role>Engineer</role>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>OWN_RO_ANZUsers_RO_ANZUsers_RO</fullName>
        <accessLevel>Read</accessLevel>
        <description>Necessary for IDR users to transfer complaints to other IDR users</description>
        <label>OWN_RO-ANZUsers_RO-ANZUsers_RO</label>
        <sharedTo>
            <roleAndSubordinates>ANZ</roleAndSubordinates>
        </sharedTo>
        <sharedFrom>
            <roleAndSubordinates>ANZ</roleAndSubordinates>
        </sharedFrom>
    </sharingOwnerRules>
</SharingRules>