<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Grant_Read_Access_on_Aem_Integration_users</fullName>
        <accessLevel>Read</accessLevel>
        <description>Rule to provide Read access on AEM Integration User</description>
        <label>Grant Read Access on Aem Integration users</label>
        <sharedTo>
            <roleAndSubordinates>ANZ_Mobile_Lending</roleAndSubordinates>
        </sharedTo>
        <criteriaItems>
            <field>Username</field>
            <operation>startsWith</operation>
            <value>aem.user</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Grant_Read_Access_on_OCV_Integration_users</fullName>
        <accessLevel>Read</accessLevel>
        <description>Rule to provide ‘Read’ access to all OCV Integration User records.</description>
        <label>Grant Read Access on OCV Integration users</label>
        <sharedTo>
            <roleAndSubordinates>ANZ</roleAndSubordinates>
        </sharedTo>
        <criteriaItems>
            <field>Username</field>
            <operation>startsWith</operation>
            <value>ocvintegration.user</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingOwnerRules>
        <fullName>Grant_Read_Access_within_ANZx</fullName>
        <accessLevel>Read</accessLevel>
        <description>Allow all ANZx users to see other ANZx users</description>
        <label>Grant Read Access within ANZx</label>
        <sharedTo>
            <roleAndSubordinates>ANZx</roleAndSubordinates>
        </sharedTo>
        <sharedFrom>
            <roleAndSubordinates>ANZx</roleAndSubordinates>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>Grant_ANZ_user_access_to_GCP_integration_user</fullName>
        <accessLevel>Read</accessLevel>
        <description>This sharing rule grants Loan App GCP Integration User read access to users</description>
        <label>Grant ANZ user access to GCP integration user</label>
        <sharedTo>
            <group>Loan_App_GCP_Integration_User</group>
        </sharedTo>
        <sharedFrom>
            <roleAndSubordinates>ANZ_Mobile_Lending</roleAndSubordinates>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>Grant_Read_Access_on_Engineer_User_Records_for_Engineers</fullName>
        <accessLevel>Read</accessLevel>
        <description>Rule to provide &apos;Read&apos; access to all Engineer User records for Engineers.</description>
        <label>Grant Read Access on Engineer User Records for Engineers</label>
        <sharedTo>
            <role>Engineer</role>
        </sharedTo>
        <sharedFrom>
            <role>Engineer</role>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>OWN_RO_ANZUsers_RO_ANZUsers_RO</fullName>
        <accessLevel>Read</accessLevel>
        <description>Necessary for IDR users to transfer complaints to other IDR users</description>
        <label>OWN_RO-ANZUsers_RO-ANZUsers_RO</label>
        <sharedTo>
            <roleAndSubordinates>ANZ</roleAndSubordinates>
        </sharedTo>
        <sharedFrom>
            <roleAndSubordinates>ANZ</roleAndSubordinates>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>Grant_Read_Access_on_Content_Writer_User_Records_for_Content_Writers</fullName>
        <accessLevel>Read</accessLevel>
        <description>Rule to provide ‘Read’ access to all Content Writer User records for Content Writers.</description>
        <label>Grant Read Access on Content Writer User Records for Content Writers</label>
        <sharedTo>
            <role>Content_Writer</role>
        </sharedTo>
        <sharedFrom>
            <role>Content_Writer</role>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>Grant_Users_Read_Access_to_NLP_Public_Group</fullName>
        <accessLevel>Read</accessLevel>
        <description>This sharing rule is to give read access to the NLP Public Group, in particular to the NLP Integration User, which has no role</description>
        <label>Grant Users Read Access to NLP Public Group</label>
        <sharedTo>
            <roleAndSubordinates>ANZ</roleAndSubordinates>
        </sharedTo>
        <sharedFrom>
            <group>NLP_Public_Group</group>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>ANZ_Role_To_AEM_Group</fullName>
        <accessLevel>Read</accessLevel>
        <label>ANZ Role To AEM Group</label>
        <sharedTo>
            <group>AEM_Integration_User_group</group>
        </sharedTo>
        <sharedFrom>
            <roleAndSubordinates>ANZ_Mobile_Lending</roleAndSubordinates>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>Grant_RBM_users_access_to_Broker_Integration_Users</fullName>
        <accessLevel>Read</accessLevel>
        <description>This sharing rule grants Broker Integration Users read access to RBM users&apos;s</description>
        <label>Grant RBM users access to Broker Integration Users</label>
        <sharedTo>
            <group>Broker_Integration_Users</group>
        </sharedTo>
        <sharedFrom>
            <role>Residential_Broker_Manager</role>
        </sharedFrom>
    </sharingOwnerRules>
</SharingRules>
