<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Broker_Profile_Admin_Edit_Each_Others_Records</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Broker Profile Admin users should be able to Read/Write Broker Relations owned by each other.</description>
        <label>Broker Profile Admin Edit Each Others Records</label>
        <sharedTo>
            <role>Broker_Profile_Admin</role>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Broker Set</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
