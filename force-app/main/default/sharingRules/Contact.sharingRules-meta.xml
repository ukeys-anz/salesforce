<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Commercial_Broker_Contacts_Read_Only_Access</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share Contact records with Broker record type to Commercial Banking</description>
        <label>Commercial Broker Contacts Read Only Access</label>
        <sharedTo>
            <roleAndSubordinates>Commercial_Banking</roleAndSubordinates>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Broker</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Display_Contacts</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Display Contacts</label>
        <sharedTo>
            <roleAndSubordinates>ANZ</roleAndSubordinates>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Organisation,Individual,Business</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Residential_Broker_Manager_Edit_Broker_Contact</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Grant Residential Broker Manager Read/Write access to Broker Profile (Contacts)</description>
        <label>Residential Broker Manager Edit Broker Contact</label>
        <sharedTo>
            <role>Residential_Broker_Manager</role>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Broker</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
