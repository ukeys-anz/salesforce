<?xml version="1.0" encoding="UTF-8"?>
<DuplicateRule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionOnInsert>Allow</actionOnInsert>
    <actionOnUpdate>Allow</actionOnUpdate>
    <alertText>Looks like there was more than one record having the same OCV ID as this record. Please make sure you have selected the correct one.</alertText>
    <description>Identifies Person Accounts with the same OCV ID</description>
    <duplicateRuleFilter>
        <booleanFilter xsi:nil="true"/>
        <duplicateRuleFilterItems>
            <field>Username</field>
            <operation>notContain</operation>
            <sortOrder>1</sortOrder>
            <table>User</table>
            <value>ocvintegration.user</value>
        </duplicateRuleFilterItems>
    </duplicateRuleFilter>
    <duplicateRuleMatchRules>
        <matchingRule>Match_Person_Accounts_with_Similar_OCV_ID</matchingRule>
        <matchRuleSObjectType>PersonAccount</matchRuleSObjectType>
        <objectMapping xsi:nil="true"/>
    </duplicateRuleMatchRules>
    <isActive>true</isActive>
    <masterLabel>Person Accounts with Similar OCV IDs</masterLabel>
    <operationsOnInsert>Alert</operationsOnInsert>
    <operationsOnUpdate>Alert</operationsOnUpdate>
    <securityOption>EnforceSharingRules</securityOption>
    <sortOrder>2</sortOrder>
</DuplicateRule>
