<aura:component implements="lightning:isUrlAddressable" access="global">
  <lightning:workspaceAPI aura:id="interactionWorkspaceAPI" />
  <aura:attribute name="anyRecordId" type="String" default="false" />
  <aura:attribute
    name="recordTypeDeveloperName"
    type="String"
    default="false"
  />
  <aura:handler name="init" value="{!this}" action="{!c.init}" />
  <c:customDatatableWithFilter
    anyRecordId="{!v.anyRecordId}"
    recordTypeDeveloperName="{!v.recordTypeDeveloperName}"
  ></c:customDatatableWithFilter>
</aura:component>
