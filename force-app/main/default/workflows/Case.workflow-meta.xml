<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <fieldUpdates>
        <fullName>Case_SLA_Start</fullName>
        <description>Update the Stopped field when the status isn&apos;t On Hold</description>
        <field>IsStopped</field>
        <literalValue>0</literalValue>
        <name>Case SLA Start</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Case_SLA_Stop</fullName>
        <description>Update the Stopped field when pausing sla</description>
        <field>IsStopped</field>
        <literalValue>1</literalValue>
        <name>Case SLA Stop</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>EscalationtoAmber</fullName>
        <field>Milestone_Sla__c</field>
        <literalValue>Warning</literalValue>
        <name>EscalationtoAmber</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>EscalationtoRed</fullName>
        <field>Milestone_Sla__c</field>
        <literalValue>Critical</literalValue>
        <name>EscalationtoRed</name>
