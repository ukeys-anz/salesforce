    <rules>
        <fullName>Assign Case to CRC Queue</fullName>
        <active>false</active>
        <criteriaItems>
            <field>Case.RecordTypeId</field>
            <operation>equals</operation>
            <value>Customer Complaint,Non-Customer Complaint</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Status</field>
            <operation>equals</operation>
            <value>Escalated</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.IDR_Escalated_to__c</field>
            <operation>equals</operation>
            <value>1</value>
        </criteriaItems>
        <description>Update case owner to CRC queue if case is escalated and Escalated to is CRC. This is moved out of trigger because of order of execution issue. Though this update is happening in afterUpdate trigger the validation rules were getting executed.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Case - Pause SLA</fullName>
        <actions>
            <name>Case_SLA_Stop</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case.Status</field>
            <operation>equals</operation>
            <value>On Hold</value>
        </criteriaItems>
        <description>This rule pauses the case SLA when the status of the case is On Hold</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Case - Start SLA</fullName>
        <actions>
            <name>Case_SLA_Start</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case.Status</field>
            <operation>notEqual</operation>
            <value>On Hold</value>
        </criteriaItems>
        <description>Start the SLA after the status has shifted from On Hold</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
