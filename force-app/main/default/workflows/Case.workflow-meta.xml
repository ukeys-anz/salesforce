    <rules>
        <fullName>Case - Pause SLA</fullName>
        <actions>
            <name>Case_SLA_Stop</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case.Status</field>
            <operation>equals</operation>
            <value>On Hold</value>
        </criteriaItems>
        <description>This rule pauses the case SLA when the status of the case is On Hold</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Case - Start SLA</fullName>
        <actions>
            <name>Case_SLA_Start</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case.Status</field>
            <operation>notEqual</operation>
            <value>On Hold</value>
        </criteriaItems>
        <description>Start the SLA after the status has shifted from On Hold</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Copy Case Number</fullName>
        <actions>
            <name>Copy_Case_Number</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case.CaseNumber__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <description>Copy CaseNumber to CaseNumber__c custom field. This is moved out of trigger because of owner change issues.</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
