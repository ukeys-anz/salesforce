<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR03_Email_Required_ANZX_Leads</fullName>
    <active>true</active>
    <description>Email field is required when creating ANZX Leads.</description>
    <errorConditionFormula>AND(
$Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false,
RecordType.DeveloperName = &apos;ANZX_Leads&apos;,
ISBLANK( Email ) 
)</errorConditionFormula>
    <errorDisplayField>Email</errorDisplayField>
    <errorMessage>An email address is required.</errorMessage>
</ValidationRule>
