<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CCRM_New_Lead_Check</fullName>
    <active>true</active>
    <description>Validation to check Leads getting created with Status only as NEW.</description>
    <errorConditionFormula>AND(
        ISNEW(),
        $Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false,
        RecordType.DeveloperName = &apos;CCRM_Lead&apos;,
        NOT(ISPICKVAL(PRIORVALUE(Status), &quot;New&quot;))
    )</errorConditionFormula>
    <errorDisplayField>Status</errorDisplayField>
    <errorMessage>Lead can only be created with New status.</errorMessage>
</ValidationRule>
