<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR02_Mobile_Phone_Required_ANZX_Leads</fullName>
    <active>true</active>
    <description>MobilePhone field is required when creating ANZX Leads.</description>
    <errorConditionFormula>AND(
$Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false,
RecordType.DeveloperName = &apos;ANZX_Leads&apos;,
ISBLANK( MobilePhone ) 
)</errorConditionFormula>
    <errorDisplayField>MobilePhone</errorDisplayField>
    <errorMessage>A mobile number is required.</errorMessage>
</ValidationRule>
