<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CCRM_Firstname_Check</fullName>
    <active>true</active>
    <description>CCRM Check if firstname is provided.  It is a mandatory field in source system.</description>
    <errorConditionFormula>AND(
        $Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false,
        RecordType.DeveloperName = &apos;CCRM_Lead&apos;,
        ISBLANK( FirstName )
    )</errorConditionFormula>
    <errorDisplayField>FirstName</errorDisplayField>
    <errorMessage>First Name is a mandatory field.</errorMessage>
</ValidationRule>
