<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR01_URL_HTTP_VALIDATION</fullName>
    <active>true</active>
    <errorConditionFormula>NOT( BEGINS(Release_Notes__c  , &quot;http&quot;))</errorConditionFormula>
    <errorDisplayField>Release_Notes__c</errorDisplayField>
    <errorMessage>The Release Notes must begin with &quot;https://&quot; or &quot;http://&quot;</errorMessage>
</ValidationRule>
