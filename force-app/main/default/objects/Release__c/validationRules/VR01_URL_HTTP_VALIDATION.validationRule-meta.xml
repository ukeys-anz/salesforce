<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR01_URL_HTTP_VALIDATION</fullName>
    <active>true</active>
    <errorConditionFormula>$Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false &amp;&amp;
        (NOT(ISBLANK(Release_Notes__c) || BEGINS(Release_Notes__c  , "http")) ||
        NOT(ISBLANK(Release_Image__c) || BEGINS(Release_Image__c  , "http")))</errorConditionFormula>
    <errorMessage>The Release Notes and Release Image must begin with &quot;https://&quot; or &quot;http://&quot;</errorMessage>
</ValidationRule>
