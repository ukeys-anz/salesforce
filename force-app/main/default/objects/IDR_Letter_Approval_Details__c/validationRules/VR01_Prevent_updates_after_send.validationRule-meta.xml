<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR01_Prevent_updates_after_send</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    $Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false,
    OR(
        ISPICKVAL(IDR_Letter_Approval__r.IDR_Status__c , &quot;Sent&quot;),
        AND(ISPICKVAL(IDR_Letter_Approval__r.IDR_Status__c , &quot;Approved&quot;),  
            IDR_Letter_Approval__r.Customer_Data_updated__c ) 
    )
)</errorConditionFormula>
    <errorMessage>You cannot edit the letter detail after the letter has been Approved/Sent</errorMessage>
</ValidationRule>
