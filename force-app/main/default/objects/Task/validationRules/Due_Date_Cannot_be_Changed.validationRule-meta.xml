<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Due_Date_Cannot_be_Changed</fullName>
    <active>true</active>
    <description>Coach Nudge Task&apos;s due date cannot be changed manually</description>
    <errorConditionFormula>AND(  RecordType.Name == &apos;Coach Nudge&apos;, ISCHANGED( ActivityDate ) )</errorConditionFormula>
    <errorDisplayField>ActivityDate</errorDisplayField>
    <errorMessage>Due Date cannot be changed manually</errorMessage>
</ValidationRule>
