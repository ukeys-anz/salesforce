<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR01_Restrict_Modification_to_IDR_System</fullName>
    <active>true</active>
    <description>Do not allow any changes to IDR system task once this has been completed.</description>
    <errorConditionFormula>$Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false &amp;&amp; RecordType.DeveloperName = &apos;IDR_System_Task&apos; &amp;&amp; (Text(PRIORVALUE(Status)) = &apos;Completed&apos; || Text(PRIORVALUE(Status)) = &apos;Expired&apos;)</errorConditionFormula>
    <errorMessage>You are not authorized to make updates to this record.</errorMessage>
</ValidationRule>
