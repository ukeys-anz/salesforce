<?xml version="1.0" encoding="UTF-8"?>
<ListView xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CompletedTasks</fullName>
    <booleanFilter>(1 AND 2 AND 3) OR (4 AND 5)</booleanFilter>
    <columns>SUBJECT</columns>
    <columns>WHO_NAME</columns>
    <columns>WHAT_NAME</columns>
    <columns>DUE_DATE</columns>
    <columns>STATUS</columns>
    <columns>PRIORITY</columns>
    <columns>CORE.USERS.ALIAS</columns>
    <columns>LAST_UPDATE</columns>
    <columns>UPDATEDBY_USER.ALIAS</columns>
    <filters>
        <field>IS_CLOSED</field>
        <operation>equals</operation>
        <value>1</value>
    </filters>
    <filters>
        <field>IS_RECURRENCE</field>
        <operation>equals</operation>
        <value>0</value>
    </filters>
    <filters>
        <field>LAST_UPDATE</field>
        <operation>equals</operation>
        <value>TODAY,LAST_N_DAYS:30</value>
    </filters>
    <filters>
        <field>STATUS</field>
        <operation>equals</operation>
        <value>Expired</value>
    </filters>
    <filters>
        <field>DUE_DATE</field>
        <operation>lessThan</operation>
        <value>LAST_N_DAYS:14</value>
    </filters>
    <filterScope>Mine</filterScope>
    <label>Recently Completed Tasks</label>
    <sharedTo>
        <roleAndSubordinates>Commercial_Banking</roleAndSubordinates>
        <roleAndSubordinates>Banker_Line_Manager</roleAndSubordinates>
        <roleAndSubordinates>Capability_Quality_C_Q_Team</roleAndSubordinates>
        <roleAndSubordinates>Customer_Resolution_Leadership</roleAndSubordinates>
        <roleAndSubordinates>Data_Analyst</roleAndSubordinates>
        <roleAndSubordinates>IDR_Content_Writer</roleAndSubordinates>
        <roleAndSubordinates>Systemic_Issue_Team</roleAndSubordinates>
        <roleAndSubordinates>Tech_Support</roleAndSubordinates>
        <roleAndSubordinates>ANZx</roleAndSubordinates>
        <roleAndSubordinates>Engineer</roleAndSubordinates>
        <roleAndSubordinates>SVP_Customer_Experience</roleAndSubordinates>
    </sharedTo>
</ListView>
