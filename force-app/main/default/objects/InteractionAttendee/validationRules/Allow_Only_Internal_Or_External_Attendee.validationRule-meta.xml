<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Allow_Only_Internal_Or_External_Attendee</fullName>
    <active>true</active>
    <description>Prevents creating an Interaction Attendee record when Attendee Type is &apos;Customer&apos; for RBM Interaction.</description>
    <errorConditionFormula>AND(
    NOT(
        ISPICKVAL(AttendeeType, &apos;Internal&apos;) || ISPICKVAL(AttendeeType, &apos;External&apos;)
    ),
    Interaction.RecordType.DeveloperName = &quot;RBM_Broker_Interaction&quot;
)</errorConditionFormula>
    <errorDisplayField>AttendeeType</errorDisplayField>
    <errorMessage>Attendee type must be either &apos;Internal&apos; or &apos;External&apos; for RBM interactions.</errorMessage>
</ValidationRule>
