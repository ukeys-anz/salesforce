<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Restrict_Optional_Note_Edit_For_RBM_Type</fullName>
    <active>true</active>
    <description>Prevents edit Optional Notes for RBM Interaction Record Type</description>
    <errorConditionFormula>AND(RecordType.DeveloperName = &quot;RBM_Broker_Interaction&quot;, NOT(ISNEW()), ISCHANGED(Optional_Notes__c))</errorConditionFormula>
    <errorDisplayField>Optional_Notes__c</errorDisplayField>
    <errorMessage>Optional Notes cannot be edited</errorMessage>
</ValidationRule>
