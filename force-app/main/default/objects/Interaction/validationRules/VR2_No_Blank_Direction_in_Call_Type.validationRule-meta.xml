<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR2_No_Blank_Direction_in_Call_Type</fullName>
    <active>true</active>
    <description>Direction field is required when creating call for interaction.</description>
    <errorConditionFormula>AND(
$Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false,
Record_Type__c = &apos;Call&apos;,
(ISPICKVAL(InteractionType, &apos;Call&apos;)),
ISPICKVAL(Direction__c, &apos;&apos;) 
)</errorConditionFormula>
    <errorDisplayField>Direction__c</errorDisplayField>
    <errorMessage>This type of channel interaction requires a direction to be selected before you can save it.</errorMessage>
</ValidationRule>
