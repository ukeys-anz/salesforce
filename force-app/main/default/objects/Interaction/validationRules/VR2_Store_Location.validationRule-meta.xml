<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR2_Store_Location</fullName>
    <active>true</active>
    <description>Id of the location is required when Channel is Store</description>
    <errorConditionFormula>AND(
$Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false,
Record_Type__c = &apos;General&apos;,
ISPICKVAL(InteractionType, &apos;Store&apos;),
ISBLANK(LocationId)
)</errorConditionFormula>
    <errorDisplayField>InteractionType</errorDisplayField>
    <errorMessage>Location is required when the Channel is &apos;Store&apos;.</errorMessage>
</ValidationRule>
