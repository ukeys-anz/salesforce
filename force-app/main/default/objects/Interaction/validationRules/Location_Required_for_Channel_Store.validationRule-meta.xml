<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Location_Required_for_Channel_Store</fullName>
    <active>true</active>
    <description>Location field is required when the Channel is chosen as Store.</description>
    <errorConditionFormula>ISPICKVAL(Channel_Booked__c,&apos;Store&apos;)  &amp;&amp;  ISBLANK(ContactRequestId__c) &amp;&amp;  ISBLANK(LocationId)</errorConditionFormula>
    <errorDisplayField>LocationId</errorDisplayField>
    <errorMessage>Please select store location.</errorMessage>
</ValidationRule>
