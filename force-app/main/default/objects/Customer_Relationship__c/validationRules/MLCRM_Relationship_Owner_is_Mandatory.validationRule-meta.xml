<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MLCRM_Relationship_Owner_is_Mandatory</fullName>
    <active>true</active>
    <description>This validation rule is used to Prevent if Owner is Blank</description>
    <errorConditionFormula>AND(
$Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false,
NOT($Profile.Name = &quot;System Administrator&quot;),
ISNULL(OwnerId)
)</errorConditionFormula>
    <errorDisplayField>OwnerId</errorDisplayField>
    <errorMessage>Relationship Owner is mandatory</errorMessage>
</ValidationRule>
