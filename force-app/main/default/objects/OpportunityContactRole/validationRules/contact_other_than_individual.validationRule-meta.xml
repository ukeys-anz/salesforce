<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>contact_other_than_individual</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
$Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false,
Contact.Account.RecordType.DeveloperName &lt;&gt; &apos;PersonAccount&apos;,
Opportunity.RecordType.DeveloperName = &apos;MLCRM_Opportunity&apos;
)</errorConditionFormula>
    <errorMessage>Organisation or CLG contacts cannot be added as a Contact Role</errorMessage>
</ValidationRule>