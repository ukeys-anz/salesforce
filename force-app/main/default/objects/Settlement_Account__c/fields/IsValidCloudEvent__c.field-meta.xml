<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IsValidCloudEvent__c</fullName>
    <businessStatus>Active</businessStatus>
    <complianceGroup>Integrity - Accurate;Privacy - Non Personal Information;Source - Salesforce</complianceGroup>
    <description>Formula boolean field to indicate if the Settlement Account is valid to trigger the
        Cloud Event</description>
    <externalId>false</externalId>
    <formula>AND(
        NOT(ISBLANK(Settlement__r.Loan_Application_Number__c)),
        NOT(ISBLANK(Settlement__r.Loan_Application_Number__r.Sync_Status__c)),
        NOT(INCLUDES(Settlement__r.Loan_Application_Number__r.Sync_Status__c, &quot;Blocked&quot;)),
        INCLUDES(Settlement__r.Loan_Application_Number__r.Sync_Status__c, &quot;Broker Org&quot;)
        )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>IsValidCloudEvent</label>
    <securityClassification>Internal</securityClassification>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
