<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RAG__c</fullName>
    <businessStatus>Active</businessStatus>
    <complianceGroup>Privacy_Non_Personal_Information;Source_Salesforce;Integrity_Trusted</complianceGroup>
    <description>This formula displays a green, yellow, or red flag image to indicate case RAG status.</description>
    <externalId>false</externalId>
    <formula>IMAGE(
	CASE(RAG_Status__c,
						&apos;Red&apos;, &quot;/img/samples/flag_red.gif&quot;,
						&apos;Amber&apos;, &quot;/img/samples/flag_yellow.gif&quot;,
						&apos;Green&apos;, &quot;/img/samples/flag_green.gif&quot;,
						&quot;/s.gif&quot;
					) , 
	&quot;RAG Status Flag&quot;
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>RAG</label>
    <required>false</required>
    <securityClassification>Internal</securityClassification>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
