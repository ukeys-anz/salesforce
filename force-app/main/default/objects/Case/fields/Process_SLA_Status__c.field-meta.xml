<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Process_SLA_Status__c</fullName>
    <businessStatus>Active</businessStatus>
    <complianceGroup>Integrity - Trusted;Privacy - Non Personal Information;Source - Salesforce</complianceGroup>
    <description>Formula to show SLA Status + Icon on ListViews and Standard Related Lists.</description>
    <externalId>false</externalId>
    <formula>CASE(
    TEXT(SLA_Status__c),
    &quot;Warning&quot;, IMAGE(&quot;/resource/copAlertIcons/alertWarning1.svg&quot;, &quot;Warning&quot;, 26, 26),
    &quot;Warning 2&quot;, IMAGE(&quot;/resource/copAlertIcons/alertWarning2.svg&quot;, &quot;Warning 2&quot;, 26, 26),
    &quot;Breached&quot;, IMAGE(&quot;/resource/copAlertIcons/alertViolation.svg&quot;, &quot;Breached&quot;, 26, 26),
    TEXT(SLA_Status__c)
)</formula>
    <label>SLA Status</label>
    <required>false</required>
    <securityClassification>Internal</securityClassification>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
