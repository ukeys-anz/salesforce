<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Case_Age_in_Days__c</fullName>
    <businessStatus>Active</businessStatus>
    <complianceGroup>Integrity_Accurate;Privacy_Non_Personal_Information;Source_Salesforce</complianceGroup>
    <description>Age of the case (in days) since e.g. it was first identified by ANZ.</description>
    <externalId>false</externalId>
    <formula>CASE(RecordType.DeveloperName,&apos;Systemic_Issue&apos;, TODAY() - SI_First_Identified_Date__c,&apos;Customer_Complaint&apos;, TODAY() -  DATEVALUE(IDR_Date_Received__c),&apos;Non_Customer_Complaint&apos;, TODAY() -  DATEVALUE(IDR_Date_Received__c),TODAY() - DATEVALUE(CreatedDate))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Age in days</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <securityClassification>Internal</securityClassification>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
