<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR17_Card_Expiry_Date_must_be_4_digits</fullName>
    <active>true</active>
    <description>Card Expiry Date must be 4 digits</description>
    <errorConditionFormula>AND($Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false, NOT(REGEX(Card_Expiry_Date__c,&quot;[0-9]{4}&quot;)),
 RecordType.DeveloperName = &quot;Card_Dispute&quot;,
NOT(ISBLANK(Card_Expiry_Date__c) )
)</errorConditionFormula>
    <errorDisplayField>Card_Expiry_Date__c</errorDisplayField>
    <errorMessage>Card Expiry Date must be 4 digits MMYY.</errorMessage>
</ValidationRule>
