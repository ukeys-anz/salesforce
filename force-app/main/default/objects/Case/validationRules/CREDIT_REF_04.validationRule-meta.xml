<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CREDIT_REF_04</fullName>
    <active>true</active>
    <description>Credit Referral case cannot be created with Errored outcome.</description>
    <errorConditionFormula>AND(
 NOT($Setup.Salesforce_Library_Settings__c.Disable_VRs__c),
 RecordType.DeveloperName = &quot;Credit_Referral&quot;,
 ISNEW(),
 Assessment_Outcome__c  = &quot;Errored&quot;
)</errorConditionFormula>
    <errorMessage>Credit Referral case cannot be created with Errored outcome.</errorMessage>
</ValidationRule>
