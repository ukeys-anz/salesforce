<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_001_Credit_Assess_Expiry_Date_Lapsed</fullName>
    <active>true</active>
    <errorConditionFormula>AND(RecordType.DeveloperName = &apos;credit_referral&apos;,  DATEVALUE(Loan_Application__r.Expiry_Date__c) &lt; today())</errorConditionFormula>
    <errorMessage>The credit referral case cannot be finalised with an approved assessment outcome because the Credit Assessment is expired.</errorMessage>
</ValidationRule>
