<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CREDIT_REF_05</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT($Setup.Salesforce_Library_Settings__c.Disable_VRs__c),
RecordType.DeveloperName = &quot;Credit_Referral&quot;,
ISNEW(),
Loan_Application__c = Null
)</errorConditionFormula>
    <errorMessage>You cannot create a Credit Referral Case without a Loan Application.</errorMessage>
</ValidationRule>
