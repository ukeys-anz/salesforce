<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR08_Validate_Financial_Account</fullName>
    <active>true</active>
    <description>To stop users from selecting another customer&#39;s financial account</description>
    <errorConditionFormula>AND(
    $Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false,
    RecordType.DeveloperName = &#39;General_Inquiry&#39;,
    NOT(ISBLANK(FinServ__FinancialAccount__c)),
    FinServ__FinancialAccount__r.FinServ__PrimaryOwner__c  &lt;&gt;  AccountId,
    FinServ__FinancialAccount__r.FinServ__JointOwner__c  &lt;&gt;  AccountId
)</errorConditionFormula>
    <errorDisplayField>FinServ__FinancialAccount__c</errorDisplayField>
    <errorMessage>Please select a financial account associated with the same account you selected</errorMessage>
</ValidationRule>
