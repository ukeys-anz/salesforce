<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR06_Restrict_Level_IDR_Users</fullName>
    <active>true</active>
    <description>If user is of Level 2 or Level 3 restrict access to edit fields if the user is not the owner or manager of the record owner</description>
    <errorConditionFormula>$Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false &amp;&amp; 
!ISNEW() &amp;&amp; 
($Permission.IDR_Level_2 || $Permission.IDR_Level_3)&amp;&amp;
(RecordType.DeveloperName = &apos;Non_Customer_Complaint&apos; ||
  RecordType.DeveloperName = &apos;Customer_Complaint&apos;) &amp;&amp;
(!isChanged(IDR_Additional_Correspondence_reviewed__c)) &amp;&amp;
(!isChanged(IDR_Document_Count__c)) &amp;&amp;
(
  (!isChanged(OwnerId) &amp;&amp; !($User.Id = OwnerId || 
    Is_Owner_s_Line_Manager_Me__c))||
  (isChanged(OwnerId) &amp;&amp; !(PRIORVALUE(OwnerId)=$User.Id || 
    PRIORVALUE(Is_Owner_s_Line_Manager_Me__c))) ||
  (isChanged(Status) &amp;&amp; ISPICKVAL(Status, &apos;Re-opened&apos;))
)</errorConditionFormula>
    <errorMessage>You are not authorized to make updates to this field.</errorMessage>
</ValidationRule>
