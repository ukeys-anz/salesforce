<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IDR_Mandate_Details_Provided_ProdM</fullName>
    <active>true</active>
    <description>Evidence that this complaint has been passed onto the product manufacture must be included in this CMOS complaint record.</description>
    <errorConditionFormula>$Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false &amp;&amp; !ISNEW() &amp;&amp;
(RecordType.DeveloperName = &apos;Non_Customer_Complaint&apos; || RecordType.DeveloperName = &apos;Customer_Complaint&apos;) &amp;&amp;
IsClosed &amp;&amp;
TEXT(IDR_Complaint_Remedy__c) = &apos;3&apos; &amp;&amp;
NOT(Provided_details_to_Product_Manufacturer__c)</errorConditionFormula>
    <errorDisplayField>Provided_details_to_Product_Manufacturer__c</errorDisplayField>
    <errorMessage>Details of the complaint have not been acknowledged by the product manufacturer</errorMessage>
</ValidationRule>
