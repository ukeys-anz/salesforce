<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SI_RestrictOwnerChange</fullName>
    <active>true</active>
    <description>Restrict SI Case owner change for SI business unit team</description>
    <errorConditionFormula>AND(
NOT(ISNEW()),
$Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false, $Permission.IDR_SIBU, 
ISCHANGED( OwnerId )
)</errorConditionFormula>
    <errorMessage>You are not authorised to make this change.</errorMessage>
</ValidationRule>
