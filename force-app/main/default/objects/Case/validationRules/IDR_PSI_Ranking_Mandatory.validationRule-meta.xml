<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IDR_PSI_Ranking_Mandatory</fullName>
    <active>true</active>
    <description>PSI Ranking must be completed before the status of the case can be updated to Closed.</description>
    <errorConditionFormula>AND(
  $Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false,
  RecordType.DeveloperName = &apos;Systemic_Issue&apos;,
  ISPICKVAL(Status, &quot;Closed&quot;),
  ISBLANK(TEXT(SI_PSI_Ranking__c)
  )  
)</errorConditionFormula>
    <errorMessage>PSI Ranking is Required.</errorMessage>
</ValidationRule>
