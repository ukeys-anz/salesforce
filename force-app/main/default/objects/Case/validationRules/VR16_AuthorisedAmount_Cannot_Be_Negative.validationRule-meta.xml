<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR16_AuthorisedAmount_Cannot_Be_Negative</fullName>
    <active>true</active>
    <description>Authorised Amount Cannot Be Negative</description>
    <errorConditionFormula>AND($Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false, Amount_Of_Authorised_Transaction__c &lt; 0)</errorConditionFormula>
    <errorDisplayField>Amount_Of_Authorised_Transaction__c</errorDisplayField>
    <errorMessage>Amount of authorised transaction cannot be negative. Please enter a valid amount.</errorMessage>
</ValidationRule>
