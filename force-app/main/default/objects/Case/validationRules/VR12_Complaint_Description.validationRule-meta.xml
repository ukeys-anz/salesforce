<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR12_Complaint_Description</fullName>
    <active>true</active>
    <description>Validate the Case.Description field for complaints</description>
    <errorConditionFormula>AND(
        $Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false,
        OR(RecordType.DeveloperName = &apos;Customer_Complaint&apos;,
            RecordType.DeveloperName = &apos;Non_Customer_Complaint&apos;
        ),
        LEN(Description) &gt; 3000
	)</errorConditionFormula>
    <errorDisplayField>Description</errorDisplayField>
    <errorMessage>Description must be less than 3,000 characters.</errorMessage>
</ValidationRule>
