<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DISPUTE_IMT_VR1</fullName>
    <active>true</active>
    <description>Description field is blank then do not allow to create and update the record</description>
    <errorConditionFormula>AND(
$Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false,
RecordType.DeveloperName = &apos;IMT_Dispute&apos;,
ISBLANK(Description),
NOT(ISPICKVAL(Origin, &apos;App&apos;))
)</errorConditionFormula>
    <errorMessage>Please provide Description of Issue.</errorMessage>
</ValidationRule>
