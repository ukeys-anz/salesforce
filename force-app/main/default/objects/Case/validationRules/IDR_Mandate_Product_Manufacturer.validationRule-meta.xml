<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IDR_Mandate_Product_Manufacturer</fullName>
    <active>true</active>
    <description>If complaint remedy is Product Manufacturer then a Product Manufacturer must be selected</description>
    <errorConditionFormula>$Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false &amp;&amp; !ISNEW() &amp;&amp;
(RecordType.DeveloperName = &apos;Non_Customer_Complaint&apos; || RecordType.DeveloperName = &apos;Customer_Complaint&apos;) &amp;&amp;
(TEXT(Status) = &apos;Closed&apos; || TEXT(Status) = &apos;Resolved&apos;) &amp;&amp; 
TEXT(IDR_Complaint_Remedy__c) = &apos;3&apos; &amp;&amp; (
ISBLANK(TEXT(IDR_Product_Manufacturer__c)) || 
NOT(Provided_details_to_Product_Manufacturer__c)
)</errorConditionFormula>
    <errorMessage>Please select a Product Manufacturer and acknowledge that the complaint details have been provided</errorMessage>
</ValidationRule>
