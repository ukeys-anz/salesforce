<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IDR_Avoidable_Escalation_Required</fullName>
    <active>true</active>
    <description>If Avoidable Escalation Reason is filled in, enforce the checkbox being required</description>
    <errorConditionFormula>AND(
$Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false,
OR(
RecordType.DeveloperName = &apos;Customer_Complaint&apos;,
RecordType.DeveloperName = &apos;Non_Customer_Complaint&apos;),
!ISPICKVAL(IDR_Avoidable_Escalation__c, &apos;Yes&apos;),
!ISBLANK(TEXT(IDR_Avoidable_Escalation_Reason__c))
)</errorConditionFormula>
    <errorDisplayField>IDR_Avoidable_Escalation__c</errorDisplayField>
    <errorMessage>&apos;Avoidable Escalation?&apos; is required to be ticked if an Avoidable Escalation Reason is given.</errorMessage>
</ValidationRule>
