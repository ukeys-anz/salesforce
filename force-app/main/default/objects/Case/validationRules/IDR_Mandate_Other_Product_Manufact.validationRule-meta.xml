<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IDR_Mandate_Other_Product_Manufact</fullName>
    <active>true</active>
    <description>If there is other thiird party manufacturer then only the name of the product manufacturer must be added and it cannot be blank</description>
    <errorConditionFormula>$Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false &amp;&amp; !ISNEW() &amp;&amp;
(RecordType.DeveloperName = &apos;Non_Customer_Complaint&apos; || RecordType.DeveloperName = &apos;Customer_Complaint&apos;) &amp;&amp;
(TEXT(Status) = &apos;Closed&apos;) &amp;&amp; ((
TEXT(IDR_Product_Manufacturer__c) = &apos;Other&apos; &amp;&amp;
ISBLANK(Name_of_product_manufacturer__c)
)||(
TEXT(IDR_Product_Manufacturer__c) != &apos;Other&apos; &amp;&amp;
ISCHANGED(Name_of_product_manufacturer__c)
))</errorConditionFormula>
    <errorDisplayField>Name_of_product_manufacturer__c</errorDisplayField>
    <errorMessage>Name of product manufacturer needs to be updated only if the the product manufacturer is not other</errorMessage>
</ValidationRule>
