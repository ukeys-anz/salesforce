<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR14_Other_Instituion_Selected_To</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
$Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false,
RecordType.DeveloperName = &apos;Identity&apos;,
ISPICKVAL(Fraud_Funds_to_Institution__c, &quot;Other&quot;) =
ISBLANK(Fraud_Funds_to_Institution_Other__c)
)</errorConditionFormula>
    <errorDisplayField>Fraud_Funds_to_Institution_Other__c</errorDisplayField>
    <errorMessage>This field cannot be used unless Funds to Institution is set to Other</errorMessage>
</ValidationRule>
