<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR15_Amount_Credit_Cannot_Be_Negative</fullName>
    <active>true</active>
    <description>Amount Credit Cannot Be Negative</description>
    <errorConditionFormula>AND($Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false, Amount_Of_Credit_Due__c &lt; 0)</errorConditionFormula>
    <errorDisplayField>Amount_Of_Credit_Due__c</errorDisplayField>
    <errorMessage>Amount credit due cannot be negative. Please enter a valid amount.</errorMessage>
</ValidationRule>
