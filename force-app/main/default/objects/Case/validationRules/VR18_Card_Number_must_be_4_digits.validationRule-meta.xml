<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR18_Card_Number_must_be_4_digits</fullName>
    <active>true</active>
    <description>Card Number must be 4 digits</description>
    <errorConditionFormula>AND($Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false, NOT(REGEX(Card_Number__c ,&quot;[0-9]{4}&quot;)),
RecordType.DeveloperName = &quot;Card_Dispute&quot;,
NOT(ISBLANK(Card_Number__c))
)</errorConditionFormula>
    <errorDisplayField>Card_Number__c</errorDisplayField>
    <errorMessage>Card Number must be last 4 digits of the card used.</errorMessage>
</ValidationRule>
