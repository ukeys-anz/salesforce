<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>EventTimestampMustBeOlder</fullName>
    <active>true</active>
    <description>EventTimestamp must be older for Account Closure Case</description>
    <errorConditionFormula>AND(
NOT( $Setup.Salesforce_Library_Settings__c.Disable_VRs__c ),
RecordType.DeveloperName = &quot;Account_Closure&quot;,
NOT(ISNULL(EventTimestamp__c)),
(VALUE(EventTimestamp__c)  &lt;   VALUE(PRIORVALUE(EventTimestamp__c) )))</errorConditionFormula>
    <errorDisplayField>EventTimestamp__c</errorDisplayField>
    <errorMessage>Case data is being overwritten with stale data.</errorMessage>
</ValidationRule>
