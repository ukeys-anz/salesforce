<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Broker_Enquiry_Closed_Case_Update</fullName>
    <active>true</active>
    <description>This validation will prevent RBM from updating closed cases.</description>
    <errorConditionFormula>AND( $UserRole.DeveloperName =&apos;Residential_Broker_Manager&apos;,
RecordType.DeveloperName = &apos;Broker_Enquiry&apos;,
IsClosed = true,
Not(isnew()))</errorConditionFormula>
    <errorMessage>RBM is not allowed to edit closed cases</errorMessage>
</ValidationRule>
