<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>UpdateTimeCannotBeOlder</fullName>
    <active>true</active>
    <errorConditionFormula>AND($Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false , Last_Updated_Date__c &lt;  PRIORVALUE(Last_Updated_Date__c))</errorConditionFormula>
    <errorDisplayField>Last_Updated_Date__c</errorDisplayField>
    <errorMessage>Last Updated Date cannot be older than the current value</errorMessage>
</ValidationRule>
