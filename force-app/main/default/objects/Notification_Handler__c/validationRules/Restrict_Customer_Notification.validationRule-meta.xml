<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Restrict_Customer_Notification</fullName>
    <active>true</active>
    <errorConditionFormula>AND($Setup.Salesforce_Library_Settings__c.Disable_VRs__c = false,
 Case__r.RecordType.DeveloperName != &apos;Customer_Complaint&apos;,
 Case__r.RecordType.DeveloperName != &apos;ANZx_Complaint&apos;,   	
 ISBLANK(Case__r.IDR_NC_Email__c ),
 ISBLANK(Case__r.IDR_NC_Mobile__c))</errorConditionFormula>
    <errorMessage>Please make sure that it is either a customer/anzx complaint or mobile/email is populated</errorMessage>
</ValidationRule>
