        <locationX>182</locationX>
        <locationY>252</locationY>
        <rules>
            <name>First_Contacted_is_8_days_ago</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CustomerFirstContacted</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>TodayLess8Days</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Profile_Update</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_ID_Ops_Followup_Queue</targetReference>
            </connector>
            <label>First Contacted is 8 days ago</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>CustomerFirstContacted</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.Customer_First_Contacted__c})</expression>
    </formulas>
    <formulas>
        <name>TodayLess8Days</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} - 8</expression>
    </formulas>
