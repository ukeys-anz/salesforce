    <recordLookups>
        <name>Get_A_Z_Reviews</name>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Opportunity_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Customer__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>accountRecord.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>CreatedDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>TwoYearsAgoDate</elementReference>
            </value>
        </filters>
        <label>Get A-Z Reviews</label>
        <limit>
            <numberValue>15.0</numberValue>
        </limit>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <object>A_Z_Review__c</object>
        <outputReference>A_Z_ReviewRecords</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Business_Details__c</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <recordLookups>
        <name>Get_A_Z_Reviews_for_CLG</name>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Opportunity_Records_for_CLG</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CLGCustomer__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>accountRecord.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>CreatedDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>TwoYearsAgoDate</elementReference>
            </value>
        </filters>
        <label>Get A-Z Reviews for CLG</label>
        <limit>
            <numberValue>15.0</numberValue>
        </limit>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <object>A_Z_Review__c</object>
        <outputReference>A_Z_ReviewRecords</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Business_Details__c</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <recordLookups>
        <name>Get_Account_Record_Type</name>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Extra_Care_Permission</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>accountRecord.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <label>Get Account Record Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
