    <decisions>
        <name>Check_Extra_Care_Permission</name>
        <defaultConnector>
            <targetReference>Get_Opportunity_Record_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Extra Care Access</defaultConnectorLabel>
        <description>Does user have Extra Care permission?</description>
        <label>Check Extra Care Permission</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <rules>
            <name>Has_Extra_Care_Access</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.ExtracareReadOnly</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Extra_Care_Data</targetReference>
            </connector>
            <label>Has Extra Care Access</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_PB_User</name>
        <defaultConnector>
            <targetReference>Interaction_Records_Start</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <label>Check for PB User ?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <rules>
            <name>PB_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.Commercial_Segment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PB</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Customer_Relationship_Records</targetReference>
            </connector>
            <label>PB User</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_the_Customer_Record_Type</name>
        <defaultConnector>
            <targetReference>Interaction_Records_Start</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other</defaultConnectorLabel>
        <label>Check the Customer Record Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <rules>
            <name>CLG</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Record_Type.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CLG</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Interaction_Records_for_CLG</targetReference>
            </connector>
            <label>CLG</label>
        </rules>
        <rules>
            <name>Organisation_Individual</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Record_Type.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Business_Account</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Record_Type.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>IndustriesIndividual</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Record_Type.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PersonAccount</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Interaction_Records_of_Organisation</targetReference>
            </connector>
            <label>Organisation/Individual</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Flow_disabled</name>
        <defaultConnector>
            <targetReference>Get_Account_Record_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <description>To check the flow is disabled for User/Profile using Salesforce_Library_Settings__c Custom setting</description>
        <label>Is Flow disabled?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <rules>
            <name>Disabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.Salesforce_Library_Settings__c.Disable_Flows__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Disabled</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_No_of_Interaction_20</name>
        <defaultConnector>
            <targetReference>Loop_Intearctions</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <label>Is No. of Interaction &lt;= 20 ?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>interactionCount</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>20.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Interaction_Data</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Customer Relationship records are fetched for Summary</description>
    <environments>Default</environments>
    <formulas>
        <name>GenerationTimeDate</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.CurrentDateTime}</expression>
    </formulas>
    <formulas>
        <name>ThreeMonthsAgoDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 90</expression>
    </formulas>
    <formulas>
        <name>TwoYearsAgoDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 730</expression>
    </formulas>
    <interviewLabel>Fetch Client Interaction for Prompt {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fetch Client Interaction for Prompt</label>
