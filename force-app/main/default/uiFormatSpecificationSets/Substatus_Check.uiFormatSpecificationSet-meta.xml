<?xml version="1.0" encoding="UTF-8"?>
<UiFormatSpecificationSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <field>Case.Status</field>
    <formatType>ICON</formatType>
    <masterLabel>Substatus Check</masterLabel>
    <sobjectType>Case</sobjectType>
    <uiFormatSpecifications>
        <formatProperties>{&quot;icon&quot;:&quot;loading_spinner&quot;,&quot;iconColor&quot;:&quot;gray&quot;}</formatProperties>
        <formatType>ICON</formatType>
        <order>1</order>
        <visibilityRule>
            <criteria>
                <leftValue>{!Record.API_Sub_Status__c}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>Processing</rightValue>
            </criteria>
        </visibilityRule>
    </uiFormatSpecifications>
    <uiFormatSpecifications>
        <formatProperties>{&quot;icon&quot;:&quot;circle_with_x&quot;,&quot;iconColor&quot;:&quot;red&quot;}</formatProperties>
        <formatType>ICON</formatType>
        <order>2</order>
        <visibilityRule>
            <criteria>
                <leftValue>{!Record.API_Sub_Status__c}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>Failed</rightValue>
            </criteria>
        </visibilityRule>
    </uiFormatSpecifications>
    <uiFormatSpecifications>
        <formatProperties>{&quot;icon&quot;:&quot;circle_with_check&quot;,&quot;iconColor&quot;:&quot;green&quot;}</formatProperties>
        <formatType>ICON</formatType>
        <order>3</order>
        <visibilityRule>
            <criteria>
                <leftValue>{!Record.API_Sub_Status__c}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>&apos;Success&apos;</rightValue>
            </criteria>
        </visibilityRule>
    </uiFormatSpecifications>
</UiFormatSpecificationSet>