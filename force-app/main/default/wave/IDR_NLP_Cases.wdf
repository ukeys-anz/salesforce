["{\"nodes\":{\"ComputeNLPCalcsToTrueFalse\":{\"action\":\"computeExpression\",\"parameters\":{\"computedFields\":[{\"label\":\"isEditedByNLP\",\"name\":\"isEditedByNLP\",\"saqlExpression\":\"case when 'Computed.EditedByNLPUser' == 1 then \\\"true\\\" else \\\"false\\\" end\",\"type\":\"Text\"},{\"label\":\"isShellCase\",\"name\":\"isShellCase\",\"saqlExpression\":\"case \\nwhen 'Record.Name' == \\\"General Inquiry CMOS\\\" \\nthen \\\"true\\\"\\nwhen 'Computed.OriginallyAShell' == 1 then \\\"true\\\" \\nelse \\\"false\\\" end\",\"type\":\"Text\"},{\"defaultValue\":\"null\",\"label\":\"IDR Subsequent Issue Text\",\"name\":\"IDR_Subsequent_Issue_Text\",\"precision\":255,\"saqlExpression\":\"case IDR_Subsequent_Issue__c\\n when  \\\"20\\\" then \\\"Request for financial assistance\\\"\\n when \\\"21\\\" then \\\"Failure to respond or process request for assistance\\\"\\n when \\\"22\\\" then \\\"Declines financial assistance\\\"\\n when \\\"23\\\" then \\\"Arrangement considered unsuitable\\\"\\n when \\\"24\\\" then \\\"Inappropriate or excessive contact\\\"\\n when \\\"25\\\" then \\\"Pledged or blocked account\\\"\\n when \\\"26\\\" then \\\"Disputed debt\\\"\\n when \\\"27\\\" then \\\"Collector/agent conduct\\\"\\n when \\\"28\\\" then \\\"Information/correspondence incorrect/not provided\\\"\\n when \\\"42\\\" then \\\"Default listing dispute\\\"\\n when \\\"38\\\" then \\\"Inappropriate lending/maladministration\\\"\\nwhen \\\"96\\\" then \\\"Delay to assess request for financial assistance \\\"\\n when \\\"97\\\" then \\\"Default notices\\\"\\n when \\\"98\\\" then \\\"Enforcement proceedings\\\"\\n \\nelse \\\"Unknown\\\"\\nend\",\"type\":\"Text\"},{\"defaultValue\":\"false\",\"label\":\"Stop Collection False Positive\",\"name\":\"isStopCollectionFalsePositive\",\"precision\":255,\"saqlExpression\":\"case when 'Performance.isStopCollectionFP' == 1 then \\\"true\\\"\\nelse \\\"false\\\"\\nend\",\"type\":\"Text\"},{\"defaultValue\":\"false\",\"label\":\"Stop Collection False Negative\",\"name\":\"isCollectionFalseNegative\",\"precision\":255,\"saqlExpression\":\"case when 'Performance.isStopCollectionFN' == 1 then \\\"true\\\"\\nelse \\\"false\\\"\\nend\",\"type\":\"Text\"}],\"mergeWithSource\":true},\"sources\":[\"appendPerformance_FP\"]},\"registerNLPCases\":{\"action\":\"register\",\"parameters\":{\"label\":\"NLPCases\",\"name\":\"NLP_Cases\",\"rowLevelSecurityFilter\":\"\"},\"sources\":[\"computerStopCollection\"]},\"digestPicklist\":{\"action\":\"sobjectDigest\",\"parameters\":{\"fields\":[{\"name\":\"DurableId\"},{\"name\":\"EntityParticleId\"},{\"name\":\"Id\"},{\"name\":\"Label\"},{\"name\":\"Value\"}],\"object\":\"PicklistValueInfo\"}},\"calcPerformanceMetrics\":{\"action\":\"computeRelative\",\"parameters\":{\"computedFields\":[{\"description\":\"Calculate False Positives \",\"expression\":{\"default\":\"0\",\"saqlExpression\":\"case \\nwhen (\\nprevious('User.Alias') == \\\"nlpinteg\\\" &&\\n'User.Alias' != \\\"nlpinteg\\\" && \\n'wasStopCollection' == \\\"true\\\" && \\n'isStopCollection' == \\\"false\\\") then 1\\nelse 0\\nend\",\"type\":\"Numeric\",\"scale\":10},\"label\":\"stopCollectionFP\",\"name\":\"stopCollectionFP\"},{\"description\":\"False Negative Stop Collection\",\"expression\":{\"default\":\"0\",\"saqlExpression\":\"case \\nwhen (\\nprevious('User.Alias') == \\\"nlpinteg\\\" &&\\n'User.Alias' != \\\"nlpinteg\\\" && \\n'wasStopCollection' == \\\"false\\\" &&\\n'isStopCollection' == \\\"true\\\"\\n) then 1\\nelse 0\\nend\",\"type\":\"Numeric\",\"scale\":10},\"label\":\"stopCollectionFN\",\"name\":\"stopCollectionFN\"},{\"expression\":{\"offset\":\"previous()\",\"sourceField\":\"User.Alias\",\"default\":\"null\"},\"label\":\"previousUser\",\"name\":\"previousUser\"}],\"orderBy\":[{\"direction\":\"asc\",\"name\":\"CreatedDate\"}],\"partitionBy\":[\"CaseId\"]},\"sources\":[\"calcStopCollection\"]},\"getHighFalseNegatives\":{\"action\":\"computeRelative\",\"parameters\":{\"computedFields\":[{\"expressi