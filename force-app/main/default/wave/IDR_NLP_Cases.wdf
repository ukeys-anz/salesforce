"type\":\"Numeric\",\"scale\":1},\"label\":\"Started as a Shell?\",\"name\":\"WasAShellCase\"},{\"expression\":{\"default\":\"0\",\"saqlExpression\":\"case when 'User.Alias' == \\\"nlpinteg\\\" then 1 else 0 end\",\"type\":\"Numeric\",\"scale\":1},\"label\":\"Updated By NLP User\",\"name\":\"UpdatedByNLPUser\"}],\"orderBy\":[{\"direction\":\"asc\",\"name\":\"CreatedDate\"}],\"partitionBy\":[\"CaseId\"]},\"sources\":[\"augmentUserInfo\"]},\"appendPerformance_FN\":{\"action\":\"augment\",\"parameters\":{\"leftKey\":[\"Id\"],\"operation\":\"LookupSingleValue\",\"relationship\":\"Performance\",\"rightKey\":[\"CaseId\"],\"rightSelect\":[\"isStopCollectionFN\"]},\"sources\":[\"appendPicklistValueType\",\"getHighFalseNegatives\"]},\"appendPerformance_FP\":{\"action\":\"augment\",\"parameters\":{\"leftKey\":[\"Id\"],\"operation\":\"LookupSingleValue\",\"relationship\":\"Performance\",\"rightKey\":[\"CaseId\"],\"rightSelect\":[\"stopCollectionFP\",\"isStopCollectionFP\"]},\"sources\":[\"appendPerformance_FN\",\"getHighestFalsePositives\"]},\"digestCaseHistory\":{\"action\":\"sobjectDigest\",\"parameters\":{\"fields\":[{\"name\":\"CaseId\"},{\"name\":\"Field\"},{\"name\":\"NewValue\"},{\"name\":\"OldValue\"},{\"name\":\"CreatedDate\"},{\"name\":\"CreatedById\"}],\"object\":\"CaseHistory\"}},\"filterTypeOnly\":{\"action\":\"filter\",\"parameters\":{\"saqlFilter\":\"'Field'==\\\"Type\\\"\"},\"sources\":[\"augmentUserInfo\"]},\"calcStopCollection\":{\"action\":\"computeExpression\",\"parameters\":{\"computedFields\":[{\"defaultValue\":\"false\",\"label\":\"Is Stop Collection (Case History)\",\"name\":\"isStopCollection\",\"precision\":255,\"saqlExpression\":\"case 'NewValue'\\nwhen \\\"4\\\" then \\\"true\\\"\\nwhen \\\"5\\\" then \\\"true\\\"\\nwhen \\\"17\\\" then \\\"true\\\"\\nwhen \\\"19\\\" then \\\"true\\\"\\nelse \\\"false\\\"\\nend\",\"type\":\"Text\"},{\"defaultValue\":\"false\",\"label\":\"wasStopCollection\",\"name\":\"wasStopCollection\",\"precision\":255,\"saqlExpression\":\"case 'OldValue'\\nwhen \\\"4\\\" then \\\"true\\\"\\nwhen \\\"5\\\" then \\\"true\\\"\\nwhen \\\"17\\\" then \\\"true\\\"\\nwhen \\\"19\\\" then \\\"true\\\"\\nelse \\\"false\\\"\\nend\",\"type\":\"Text\"}],\"mergeWithSource\":true},\"sources\":[\"filterTypeOnly\"]},\"digestRecordType\":{\"action\":\"sobjectDigest\",\"parameters\":{\"fields\":[{\"name\":\"Id\"},{\"name\":\"DeveloperName\"},{\"name\":\"Name\"}],\"object\":\"RecordType\"}},\"computerStopCollection\":{\"action\":\"computeExpression\",\"parameters\":{\"computedFields\":[{\"label\":\"isStopCollection\",\"name\":\"isStopCollection\",\"saqlExpression\":\"case when \\n'IDR_Subsequent_Issue_Text'  != \\\"Unknown\\\" then\\n(case 'Type'\\nwhen \\\"4\\\" then \\\"true\\\"\\nwhen \\\"5\\\" then \\\"true\\\"\\nwhen \\\"17\\\" then \\\"true\\\"\\nwhen \\\"19\\\" then \\\"true\\\"\\nelse \\\"false\\\" \\nend)\\nelse \\\"false\\\"\\nend\",\"type\":\"Text\"}],\"mergeWithSource\":true},\"sources\":[\"ComputeNLPCalcsToTrueFalse\"]}}}",null]