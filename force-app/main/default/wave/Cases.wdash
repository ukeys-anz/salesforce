    "Status_1": {
      "broadcastFacet": true,
      "groups": ["Order", "Status"],
      "label": "Status_1",
      "numbers": ["count"],
      "query": "q = load \"cases_duration\";\nq = filter q by {{cell(My_Records_Filter_1.selection, 0, \"SAQL\").asString()}};q = group q by 'Status';\nq = cogroup q by 'CaseStatusOrder';\nq = filter q by {{cell(My_Records_Filter_1.selection, 0, \"SAQL\").asString()}};\nq = foreach q generate 'CaseStatusOrder' as 'Order', 'Status' as 'Status', count() as 'count';\nq = order q by 'Order' asc;\nq = limit q 2000;",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "start": "[]",
      "strings": ["Order", "Status"],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "parameters": {
          "columnMap": {
            "trellis": [],
            "dimension": ["Status"],
            "plots": ["count"]
          },
          "showActionMenu": false,
          "legend": {
            "descOrder": false,
            "showHeader": false,
            "show": false,
            "customSize": "auto",
            "position": "bottom-center",
            "inside": false
          },
          "showMeasureTitle": true,
          "valueType": "compactNumber",
          "showTotal": true,
          "tooltip": {
            "showBinLabel": true,
            "measures": "",
            "showNullValues": true,
            "showPercentage": true,
            "showDimensions": true,
            "showMeasures": true,
            "customizeTooltip": false,
            "dimensions": ""
          },
          "visualizationType": "origami",
          "theme": "wave",
          "title": {
            "fontSize": 14,
            "subtitleFontSize": 11,
            "label": "",
            "align": "center",
            "subtitleLabel": ""
          },
          "trellis": {
            "flipLabels": false,
            "showGridLines": true,
            "size": [100, 100],
            "enable": false,
            "type": "x",
            "chartsPerLine": 4
          },
          "applyConditionalFormatting": true
        },
        "type": "chart"
      }
    },
