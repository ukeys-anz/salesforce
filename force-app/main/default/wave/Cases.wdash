    "My_Records_Filter_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "My Records Filter",
      "numbers": [],
      "query": "q0 = load \"cases_duration\";\nq0 = group q0 by 'OwnerId'; \nq0 = filter q0 by 'OwnerId' == \"!{User.Id}\";\nq0 = foreach q0 generate 'OwnerId' as 'OwnerId', \"My Cases\" as 'Record', \"'OwnerId' == \\\"\" + OwnerId + \"\\\"\"  as 'SAQL', count() as 'Count';\n\nq1 = load \"cases_duration\";\nq1 = group q1 by all;\nq1 = foreach q1 generate null as 'OwnerId', \"All\" as 'Record', \"true\" as 'SAQL', count() as 'Count';\n\nq = union q0, q1;\n",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "singlerequired",
      "strings": [],
