      "broadcastFacet": true,
      "groups": [],
      "label": "CreatedDate_Day_1",
      "numbers": [],
      "query": "q = load \"cases_duration\";\nq = filter q by {{cell(My_Records_Filter_1.selection,0,\"SAQL\").asObject()}};q = filter q by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"30 days ago\"..\"current day\"];\nq = group q by ('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day');\nq = foreach q generate 'CreatedDate_Year' + \"~~~\" + 'CreatedDate_Month' + \"~~~\" + 'CreatedDate_Day' as 'CreatedDate_Year~~~CreatedDate_Month~~~CreatedDate_Day', count() as 'count';\nq = order q by 'CreatedDate_Year~~~CreatedDate_Month~~~CreatedDate_Day' asc;\nq = limit q 2000;",
