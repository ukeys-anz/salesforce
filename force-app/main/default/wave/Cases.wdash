    "all_3": {
      "broadcastFacet": true,
      "groups": [],
      "label": "all_3",
      "numbers": ["Perc"],
      "query": "q = load \"cases_duration\";\nresult = group q by 'HasBeenTransferred';\nresult = foreach result generate q.'HasBeenTransferred' as 'HasBeenTransferred', count(q) as 'A', count(q) as 'C';\nresult = group result by 'HasBeenTransferred';\nresult = foreach result generate 'HasBeenTransferred', first(A) as 'A', first(C) as 'C', sum(A)/sum(sum(A)) over ([..] partition by all) as 'Perc';\n\nresult = filter result by HasBeenTransferred == \"false\";\nresult = foreach result generate 'Perc';\nresult = limit result 1;",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "strings": [],
