    "lens_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "lens_1",
      "numbers": [],
      "query": "\nq = load \"KYC_QA\";\nq0 = filter q by 'Fraud_ID_True_Document__c' == \"Yes\";\nq1 = filter q by 'Fraud_ID_True_Document__c' == \"No\";\nresult = cogroup q by all full, q0 by all full, q1 by all;\nvalid_identity = foreach result generate \"Valid Identity Document Provided\" as 'Question', count(q0) as 'Yes', count(q1) as 'No'; \n\n\nq = load \"KYC_QA\";\nq0 = filter q by 'Fraud_EV_Match__c' == \"Yes\";\nq1 = filter q by 'Fraud_EV_Match__c' == \"No\";\nresult = cogroup q by all full, q0 by all full, q1 by all;\nmatch = foreach result generate \"EV Information is a Match & Complete\" as 'Question', count(q0) as 'Yes', count(q1) as 'No'; \n\nq = load \"KYC_QA\";\nq0 = filter q by 'Fraud_ID_Legible__c' == \"Yes\";\nq1 = filter q by 'Fraud_ID_Legible__c' == \"No\";\nresult = cogroup q by all full, q0 by all full, q1 by all;\nidentity_legible = foreach result generate \"Identity Document is Legible\" as 'Question', count(q0) as 'Yes', count(q1) as 'No'; \n\nq = load \"KYC_QA\";\nq0 = filter q by 'Fraud_ID_Not_Picture__c' == \"Yes\";\nq1 = filter q by 'Fraud_ID_Not_Picture__c' == \"No\";\nresult = cogroup q by all full, q0 by all full, q1 by all;\nimage = foreach result generate \"Image is not a Picture of ID Document\" as 'Question', count(q0) as 'Yes', count(q1) as 'No'; \n\nq = load \"KYC_QA\";\nq0 = filter q by 'Fraud_Customer_Details__c' == \"Yes\";\nq1 = filter q by 'Fraud_Customer_Details__c' == \"No\";\nresult = cogroup q by all full, q0 by all full, q1 by all;\nkyc = foreach result generate \"KYC Information is a Match & Complete\" as 'Question', count(q0) as 'Yes', count(q1) as 'No'; \n\nq = load \"KYC_QA\";\nq0 = filter q by 'Fraud_Customer_Photo_Modified__c' == \"Yes\";\nq1 = filter q by 'Fraud_Customer_Photo_Modified__c' == \"No\";\nresult = cogroup q by all full, q0 by all full, q1 by all;\nnot_modified = foreach result generate \"Customer's Photo is Not Modified\" as 'Question', count(q0) as 'Yes', count(q1) as 'No'; \n\nq = load \"KYC_QA\";\nq0 = filter q by 'Fraud_Middle_Name__c' == \"Yes\";\nq1 = filter q by 'Fraud_Middle_Name__c' == \"No\";\nresult = cogroup q by all full, q0 by all full, q1 by all;\nmiddle_name = foreach result generate \"Middle Name Matches\" as 'Question', count(q0) as 'Yes', count(q1) as 'No'; \n\nq = load \"KYC_QA\";\nq0 = filter q by 'Fraud_Middle_Initial__c' == \"Yes\";\nq1 = filter q by 'Fraud_Middle_Initial__c' == \"No\";\nresult = cogroup q by all full, q0 by all full, q1 by all;\nmiddle_name_i = foreach result generate \"Middle Name Initial\" as 'Question', count(q0) as 'Yes', count(q1) as 'No'; \n\n\n\nq = load \"KYC_QA\";\nq0 = filter q by 'Fraud_Security_Features__c' == \"Yes\";\nq1 = filter q by 'Fraud_Security_Features__c' == \"No\";\nresult = cogroup q by all full, q0 by all full, q1 by all;\nsecurity = foreach result generate \"Security Features Visible\" as 'Question', coalesce(count(q0),0) as 'Yes', coalesce(count(q1),0) as 'No'; \n\n\nq = load \"KYC_QA\";\nq0 = filter q by 'Fraud_PO_Box__c' == \"Yes\";\nq1 = filter q by 'Fraud_PO_Box__c' == \"No\";\nresult = cogroup q by all full, q0 by all full, q1 by all;\nresidential = foreach result generate \"Residential Address is Not a PO Box\" as 'Question', count(q0) as 'Yes', count(q1) as 'No'; \n\nq = load \"KYC_QA\";\nq0 = filter q by 'Fraud_Citizenship_Updated__c' == \"Yes\";\nq1 = filter q by 'Fraud_Citizenship_Updated__c' == \"No\";\nresult = cogroup q by all full, q0 by all full, q1 by all;\nsource = foreach result generate \"Citizenship updated in source systems\" as 'Question', count(q0) as 'Yes', count(q1) as 'No'; \n\nq = load \"KYC_QA\";\nq0 = filter q by 'Fraud_Address_Valid__c' == \"Yes\";\nq1 = filter q by 'Fraud_Address_Valid__c' == \"No\";\nresult = cogroup q by all full, q0 by all full, q1 by all;\nresi_valid = foreach result generate \"Residential address is valid\" as 'Question', count(q0) as 'Yes', count(q1) as 'No'; \n\nq = load \"KYC_QA\";\nq0 = filter q by 'Fraud_Selfie_Comparison_Match__c' == \"Yes\";\nq1 = filter q by 'Fraud_Selfie_Comparison_Match__c' == \"No\";\nresult = cogroup q by all full, q0 by all full, q1 by all;\nselfie = foreach result generate \"Selfie Comparison Match\" as 'Question', count(q0) as 'Yes', count(q1) as 'No'; \n\n\nq = union valid_identity, match, identity_legible, image, kyc, not_modified, middle_name, middle_name_i, security, residential, source, resi_valid, selfie;\n",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "parameters": {
          "autoFitMode": "fit",
          "showValues": true,
          "legend": {
            "descOrder": false,
            "showHeader": true,
            "show": false,
            "customSize": "auto",
            "position": "right-top",
            "inside": false
          },
          "showMeasureTitle": true,
          "tooltip": {
            "content": {
              "legend": {
                "showBinLabel": true,
                "measures": [],
                "showNullValues": true,
                "customizeLegend": false,
                "showPercentage": true,
                "showDimensions": true,
                "showMeasures": true,
                "dimensions": []
              }
            }
          },
          "visualizationType": "pyramid",
          "title": {
            "fontSize": 14,
            "subtitleFontSize": 11,
            "label": "",
            "align": "left",
            "subtitleLabel": ""
          },
          "trellis": {
            "flipLabels": false,
            "showGridLines": true,
            "size": [100, 100],
            "enable": false,
            "type": "x",
            "chartsPerLine": 4
          },
          "showMeasure": false,
          "showActionMenu": true,
          "measureAxis2": {
            "sqrtScale": false,
            "title": "No",
            "customDomain": { "showDomain": false }
          },
          "measureAxis1": {
            "sqrtScale": false,
            "title": "Yes",
            "customDomain": { "showDomain": false }
          },
          "theme": "wave",
          "rightColor": "#e16032",
          "leftColor": "#52b7d8",
          "dimensionAxis": { "customSize": 40, "showAxis": true },
          "applyConditionalFormatting": true
        },
        "type": "chart"
      }
    },
    "lens_2": {
      "broadcastFacet": true,
      "groups": [],
      "label": "lens_2",
      "numbers": [],
      "query": "q = load \"KYC_QA\";\nq_base = filter q by IsClosed == \"false\";\n\nq_count = filter q_base by 'CaseAge' == 0;\nresult = cogroup q by all full, q_count by all;\nq0 = foreach result generate \"0\" as 'Days', count(q_count) as 'Cases';\n\nq_count = filter q_base by 'CaseAge' == 1;\nresult = cogroup q by all full, q_count by all;\nq1 = foreach result generate \"1\" as 'Days', count(q_count) as 'Cases';\n\nq_count = filter q_base by 'CaseAge' == 2;\nresult = cogroup q by all full, q_count by all;\nq2 = foreach result generate \"2\" as 'Days', count(q_count) as 'Cases';\n\nq_count = filter q_base by 'CaseAge' == 3;\nresult = cogroup q by all full, q_count by all;\nq3 = foreach result generate \"3\" as 'Days', count(q_count) as 'Cases';\n\nq_count = filter q_base by 'CaseAge' == 4;\nresult = cogroup q by all full, q_count by all;\nq4 = foreach result generate \"4\" as 'Days', count(q_count) as 'Cases';\n\nq_count = filter q_base by 'CaseAge' == 5;\nresult = cogroup q by all full, q_count by all;\nq5 = foreach result generate \"5\" as 'Days', count(q_count) as 'Cases';\n\nq_count = filter q_base by 'CaseAge' == 6;\nresult = cogroup q by all full, q_count by all;\nq6 = foreach result generate \"6\" as 'Days', count(q_count) as 'Cases';\n\n\nq_count = filter q_base by 'CaseAge' == 7;\nresult = cogroup q by all full, q_count by all;\nq7 = foreach result generate \"7\" as 'Days', count(q_count) as 'Cases';\n\nq_count = filter q_base by 'CaseAge' > 8;\nresult = cogroup q by all full, q_count by all;\nq8 = foreach result generate \"8+\" as 'Days', count(q_count) as 'Cases';\n\n\nr = union q0, q1, q2, q3, q4, q5, q6, q7, q8;\n\nr = foreach r generate 'Days' as 'CaseAge', Cases as 'Cases';",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
