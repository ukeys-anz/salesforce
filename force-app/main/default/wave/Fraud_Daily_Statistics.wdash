    "lens_1": {
      "broadcastFacet": true,
      "groups": [],
      "numbers": [],
      "query": "q = load \"FraudX\";\nq = foreach q generate 'CaseNumber' as 'Case Number', \n'Record.Name' as 'Case Type',\n'CreatedDate' as 'Case Created Date', \n'Account.OCV_ID__c' as 'OCV ID', \n'Type' as 'Compromise Type',\n(case 'Origin'\n      when \"Falcon\" then 1    \n      when \"Fraud Staff\" then 1 \n      else 0\nend) as 'Detection Status',\n'Origin' as 'Detection Method',  \n'Fraud_Total_Scam_Value__c' as 'Total Scam Value', \n'Fraud_Total_Fraud_Value__c' as 'Total Fraud Value', \n'Fraud_Total_Falcon_Recalled__c' as 'Total Falcon Recalled', \n'Fraud_Total_Recovered__c' as 'Total Recovered', \n'Fraud_Total_Customer_Loss__c' as 'Total Customer Loss', \n'Fraud_Total_Customer_Exposure__c' as 'Total Customer Exposure', \n'Fraud_Total_Fraud_Received__c' as 'Total Fraud Received', \n'Fraud_Total_Recipient_Loss__c' as 'Total Recipient Loss', \n'Fraud_Loss_Reason_Code__c' as 'Loss Reason Code',\n'Fraud_Summary_of_Events__c' as 'Summary of Event', \n'ClosedDate' as 'Case Closed Date';\nq = filter q by 'Case Type' in [\"Fraud\",\"Scam\",\"Recipient/Mule\"];\nq = order q by 'Case Created Date' desc;",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
