{"dataSourceLinks":[],"filters":[],"gridLayouts":[{"name":"Default","numColumns":48,"pages":[{"label":"Fraud Summary","name":"7333e75c-9951-4ec8-9209-853678809a05","navigationHidden":false,"widgets":[{"colspan":41,"column":6,"name":"table_1","row":3,"rowspan":4,"widgetStyle":{"borderEdges":[]}},{"colspan":5,"column":1,"name":"text_1","row":4,"rowspan":1,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":5,"column":1,"name":"text_2","row":5,"rowspan":1,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":5,"column":1,"name":"text_3","row":6,"rowspan":1,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":30,"column":9,"name":"text_4","row":0,"rowspan":2,"widgetStyle":{"backgroundColor":"rgb(242, 243, 131)","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":46,"column":1,"name":"container_1","row":2,"rowspan":5,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#091A3E","borderEdges":["all"],"borderRadius":4,"borderWidth":2}},{"colspan":18,"column":1,"name":"container_2","row":7,"rowspan":7,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#091A3E","borderEdges":["all"],"borderRadius":4,"borderWidth":2}},{"colspan":17,"column":1,"name":"chart_2","row":7,"rowspan":7,"widgetStyle":{"borderEdges":[]}}]}],"rowHeight":"normal","selectors":[],"style":{"alignmentX":"left","alignmentY":"top","backgroundColor":"#F2F6FA","cellSpacingX":4,"cellSpacingY":4,"fit":"original","gutterColor":"#C5D3E0"},"version":1.0}],"layouts":[],"steps":{"AgeBucket_1":{"broadcastFacet":true,"datasets":[{"name":"FraudX"}],"isGlobal":false,"label":"AgeBucket_1","query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"AgeBucket\"],\"filters\":[[\"Date Received\",[[1577836800000,1609113600000]],\">=<=\"]]}","version