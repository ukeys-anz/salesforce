    "lens_2": {
      "broadcastFacet": true,
      "groups": [],
      "label": "lens_2",
      "numbers": [],
      "query": "\nq = load \"FraudX\";\nq = filter q by 'CreatedDate_Year' == \"{{cell(static_2.selection, 0, \"Year\").asObject()}}\";\nq = filter q by 'CreatedDate_Month' == number_to_string({{cell(static_1.selection, 0, \"Month\").asObject()}}, \"0#\");\nq_B = filter q by 'Record.Name' == \"Scam\";\nresult = group q by all full, q_B by all;\nresult = foreach result generate count(q) as 'A', count(q_B) as 'B', sum(q_B.'Fraud_Total_Scam_Value__c') as 'E', sum(q_B.'Fraud_Total_Recovered__c') as 'F', sum(q_B.'Fraud_Total_Customer_Exposure__c') as 'Ex';\nresult = foreach result generate coalesce(A,0) as 'A', 'B', 'E', 'F', E - F as 'G', 'Ex';\nresult1 = limit result 10000;\n\n-- Previous Month\nq = load \"FraudX\";\nq = foreach q generate CreatedDate_Year, CreatedDate_Month, 'Record.Name' as 'Record.Name', Fraud_Total_Scam_Value__c, Fraud_Total_Recovered__c, Fraud_Total_Customer_Exposure__c,\ncase when {{cell(static_1.selection, 0, \"Month\").asObject()}} == 1 then 12 else ({{cell(static_1.selection, 0, \"Month\").asObject()}}-1) end as 'monthFilter',\ncase when {{cell(static_1.selection, 0, \"Month\").asObject()}} == 1 then ({{cell(static_2.selection, 0, \"Year\").asObject()}}-1) else ({{cell(static_2.selection, 0, \"Year\").asObject()}}) end as 'yearFilter';\nq = filter q by 'CreatedDate_Month' == number_to_string('monthFilter', \"0#\");\nq = filter q by 'CreatedDate_Year' == number_to_string('yearFilter', \"####\");\nq_B = filter q by 'Record.Name' == \"Scam\";\nresult = group q by all full, q_B by all;\nresult = foreach result generate count(q) as 'A', count(q_B) as 'B', sum(q.'Fraud_Total_Scam_Value__c') as 'E', sum(q.'Fraud_Total_Recovered__c') as 'F', sum(q.'Fraud_Total_Customer_Exposure__c') as 'Ex';\nresult = foreach result generate coalesce('A',0) as 'A', 'B', 'E', 'F', E - F as 'G', 'Ex';\nresult2 = limit result 2000;\n\n-- Rolling 12 months\n\nq = load \"FraudX\";\nq1 = foreach q generate \n({{cell(static_2.selection, 0, \"Year\").asObject()}}-1) + ({{cell(static_1.selection, 0, \"Month\").asObject()}}/100) as 'lowerFilterDate',\n(string_to_number('CreatedDate_Year') + (string_to_number('CreatedDate_Month')/100) ) as 'filterDate', \nCreatedDate_Year, CreatedDate_Month, CreatedDate_Day, Fraud_Total_Scam_Value__c, Fraud_Total_Recovered__c, Fraud_Total_Customer_Exposure__c,\n'Record.Name' as 'Record.Name';\nq1 = filter q1 by 'filterDate' >= lowerFilterDate;\nq1 = filter q1 by 'filterDate' <= {{cell(static_2.selection, 0, \"Year\").asObject()}} + ({{cell(static_1.selection, 0, \"Month\").asObject()}}/100);\nq_B = filter q1 by 'Record.Name' == \"Scam\";\nresult = group q1 by all full, q_B by all;\nresult = foreach result generate count(q1) as 'A', count(q_B) as 'B', sum(q1.'Fraud_Total_Scam_Value__c') as 'E', sum(q1.'Fraud_Total_Recovered__c') as 'F', sum(q1.'Fraud_Total_Customer_Exposure__c') as 'Ex';\nresult = foreach result generate number_to_string(('A'/12), \"#.##\") as 'A', round('B'/12) as 'B', round('E'/12) as 'E', round('F'/12) as 'F', E - F as 'G', round('Ex'/12) as 'Ex';\nresult3 = limit result 2000;\n\nq = union result1, result2, result3;\nq = foreach q generate 'A' as 'Total Cases Worked', 'B' as 'Scam Cases', number_to_string('E', \"$0.0,,\")+\"M\" as 'How much did customer\\'s send?', number_to_string('F', \"$0.0,,\")+\"M\" as 'How much did ANZ Recover?', number_to_string('G', \"$0.0,,\")+\"M\" as 'How much did customer\\'s lose?',  number_to_string('Ex', \"$0.0,,\")+\"M\" as 'Total Customer Exposure' ;",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "parameters": {
          "borderColor": "#e1e5ee",
          "borderWidth": 1,
          "cell": {
            "backgroundColor": "#f2f6fa",
            "fontColor": "#16325c",
            "fontSize": 16
          },
          "columnProperties": {},
          "columns": [],
          "customBulkActions": [],
          "evenRowColor": "#f2f6fa",
          "header": {
            "backgroundColor": "#e4ecf2",
            "fontColor": "#5c7a99",
            "fontSize": 12
          },
          "innerMajorBorderColor": "#a9b7c7",
          "innerMinorBorderColor": "#e1e5ee",
          "mode": "fittocontainer",
          "numberOfLines": 1,
          "oddRowColor": "#ffffff",
          "showActionMenu": false,
          "showRowIndexColumn": false,
          "totals": true,
          "verticalPadding": 12
        },
        "type": "table"
      }
    }
  },
