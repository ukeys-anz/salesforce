eceived__c_Year', 'IDR_Date_Received__c_Month', 'IDR_Date_Received__c_Day') in [\"current month\"..\"current month\"];\nq_E = filter q by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current month\"..\"current month\"];\nq_F = filter q by date('IDR_Date_Received__c_Year', 'IDR_Date_Received__c_Month', 'IDR_Date_Received__c_Day') in [\"current month\"..\"current month\"];\nresult = group q_A by all full, q_B by all full, q_C by all full, q_E by all full, q_F by all;\nresult = foreach result generate count(q_A) as 'A', count(q_B) as 'B', count(q_C) as 'C', sum(q_E.'Fraud_Total_Scam_Value__c') as 'E', sum(q_F.'Fraud_Total_Recovered__c') as 'F';\nresult = foreach result generate 'A', 'B', 'C', 'E', 'F', B+C as 'D', E - F as 'G';\nresult1 = limit result 2000;\n\n\n\nq = load \"FraudX\";\nq_A = filter q by date('IDR_Date_Received__c_Year', 'IDR_Date_Received__c_Month', 'IDR_Date_Received__c_Day') in [\"1 month ago\"..\"1 month ago\"];\nq_B = filter q by 'Record.Name' == \"Scam\" && date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"1 month ago\"..\"1 month ago\"];\nq_C = filter q by 'Record.Name' == \"Recipient/Mule\" && date('IDR_Date_Received__c_Year', 'IDR_Date_Received__c_Month', 'IDR_Date_Received__c_Day') in [\"1 month ago\"..\"1 month ago\"];\nq_E = filter q by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"1 month ago\"..\"1 month ago\"];\nq_F = filter q by date('IDR_Date_Received__c_Year', 'IDR_Date_Received__c_Month', 'IDR_Date_Received__c_Day') in [\"1 month ago\"..\"1 month ago\"];\nresult = group q_A by all full, q_B by all full, q_C by all full, q_E by all full, q_F by all;\nresult = foreach result generate count(q_A) as 'A', count(q_B) as 'B', count(q_C) as 'C', sum(q_E.'Fraud_Total_Scam_Value__c') as 'E', sum(q_F.'Fraud_Total_Recovered__c') as 'F';\nresult = foreach result generate 'A', 'B', 'C', 'E', 'F', B+C as 'D', E - F as 'G';\nresult2 = limit result 2000;\n\nq = load \"FraudX\";\nq_A = filter q by date('IDR_Date_Received__c_Year', 'IDR_Date_Received__c_Month', 'IDR_Date_Received__c_Day') in [\"current year\"..\"current day\"];\nq_B = filter q by 'Record.Name' == \"Scam\" && date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current year\"..\"current day\"];\nq_C = filter q by 'Record.Name' == \"Recipient/Mule\" && date('IDR_Date_Received__c_Year', 'IDR_Date_Received__c_Month', 'IDR_Date_Received__c_Day') in [\"current year\"..\"current day\"];\nq_E = filter q by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current year\"..\"current day\"];\nq_F = filter q by date('IDR_Date_Received__c_Year', 'IDR_Date_Received__c_Month', 'IDR_Date_Received__c_Day') in [\"current year\"..\"current day\"];\nresult = group q_A by all full, q_B by all full, q_C by all full, q_E by all full, q_F by all;\nresult = foreach result generate count(q_A) as 'A', count(q_B) as 'B', count(q_C) as 'C', sum(q_E.'Fraud_Total_Scam_Value__c') as 'E', sum(q_F.'Fraud_Total_Recovered__c') as 'F';\nresult = foreach result generate round('A'/12) as 'A', round('B'/12) as 'B', round('C'/12) as 'C', round('E'/12) as 'E', round('F'/12) as 'F', B+C as 'D', E - F as 'G';\nresult3 = limit result 2000;\n\nq = union result1, result2, result3;\nq = foreach q generate 'A' as 'Total Cases Worked', 'B' as 'Scam Only Cases', 'C' as 'Recipient Only Cases', 'D' as 'Scam & Recipient Cases', number_to_string('E', \"$0.0,,\")+\"M\" as 'How much did customer\\'s send?', number_to_string('F', \"$0.0,,\")+\"M\" as 'How much did ANZ Recover?', number_to_string('G', \"$0.0,,\")+\"M\" as 'How much did customer\\'s lose?' ;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2