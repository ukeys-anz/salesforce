    "lens_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "lens_1",
      "numbers": [],
      "query": "q = load \"CMOS_Historic_User_Data\";\n\nq = foreach q generate case when 'DaysSinceLogin' > {{cell(static_1.selection, 0, \"Days\").asObject()}} then \"true\" else \"false\" end as 'logged_in', 'LastLoginDate_sec_epoch', 'EmployeeNumber';\nq = group q by 'logged_in';\nq = foreach q generate logged_in, unique('EmployeeNumber') as 'Login';\n\nq = group q by 'logged_in';\nq = foreach q generate logged_in, sum('Login')/sum(sum('Login')) over ([..] partition by all) as 'B';\n\nq = filter q by logged_in == \"false\";\nq = foreach q generate 'B';\n\n",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
