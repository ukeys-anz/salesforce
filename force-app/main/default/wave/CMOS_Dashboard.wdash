    "IDR_Complaint_Remedy_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "Complaint Remedy %",
      "numbers": [],
      "query": "q = load \"CMOS_Cases\";\nq = filter q by {{row(min_max_dates_1.result, [0], [\"min_epoch\", \"max_epoch\"]).asDateRange(\"date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day')\")}};\nq = group q by 'Id';\nq = foreach q generate 'Id', first('Picklist.Remedy.Label') as 'Picklist.Remedy.Label';\nresult = group q by 'Picklist.Remedy.Label';\nresult = foreach result generate q.'Picklist.Remedy.Label' as 'Picklist.Remedy.Label', count(q) as 'A';\nresult = group result by 'Picklist.Remedy.Label';\nresult = foreach result generate 'Picklist.Remedy.Label', first(A) as 'A', sum(A)/sum(sum(A)) over ([..] partition by all) as 'Perc';\n\nresult = foreach result generate 'Picklist.Remedy.Label', A, Perc, round('Perc',3)*100 as '%';\n\n\nresult = limit result 2000;",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "parameters": {
          "autoFitMode": "keepLabels",
          "centerText": "{{cell(IDR_Complaint_Remedy_1.result, 0, \"%\").asString()}}%",
          "legend": {
