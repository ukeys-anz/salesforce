    "Creator_UserInfo_Fir_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "Creator_UserInfo_Fir_1",
      "numbers": [],
      "query": "q = load \"CMOS_Cases\";\nq = group q by ('Id', 'CaseNumber', 'Creator_UserInfo.LastName');\nq = foreach q generate 'Id', 'CaseNumber', 'Creator_UserInfo.LastName';\nq = limit q 100;",
