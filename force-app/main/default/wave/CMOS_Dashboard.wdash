  "layouts": [],
  "steps": {
    "HasBeenAutoEscalated_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "HasBeenAutoEscalated%",
      "numbers": [],
      "query": "-- Collect total Cases.\nq = load \"CMOS_Cases\";\nq = filter q by {{ column(Onboard_Team_Branch_2.selection, [\"Onboard.Team_Branch\"]).asEquality(\"IDR_Office__c\") }};\nq = filter q by {{row(min_max_dates_1.result, [0], [\"min_epoch\", \"max_epoch\"]).asDateRange(\"date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day')\")}};\nq1 = group q by Id;\nq1 = foreach q1 generate Id, 1 as 'C';\nq1 = group q1 by all;\ntotal = foreach q1 generate sum('C') as 'Total';\n\n\n--Filter cases that are not auto esclated\nesc = foreach q generate case when 'IDR_Escalation_Reason__c' is null \nthen \"None\" else 'IDR_Escalation_Reason__c' end\nas 'IDR_Escalation_Reason__c', 'Id' as 'Id';\nesc = group esc by ('IDR_Escalation_Reason__c');\nesc = foreach esc generate 'IDR_Escalation_Reason__c', count() as 'C';\nesc = filter esc by 'IDR_Escalation_Reason__c' like \"%auto%\";\nesc = foreach esc generate 'IDR_Escalation_Reason__c', sum('C') as 'Filter';\nesc = group esc by all;\nesc = foreach esc generate sum('Filter') as 'Filter';\n\n\n--Compare the total cases against the filtered cases\ncombine = union total, esc;\ncombine = group combine by all;\nresult = foreach combine generate case when coalesce((sum(Filter)/sum(Total)),0) == 0 then \"0%\" else  number_to_string( coalesce((sum(Filter)/sum(Total)),0) , \"#.00%\") end as 'perc';",
      "receiveFacetSource": {
        "mode": "exclude",
        "steps": ["Onboard_Team_Branch_2", "Onboard_Division_1"]
      },
      "selectMode": "single",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "parameters": {
          "autoFitMode": "keepLabels",
          "showValues": true,
          "bins": {
            "breakpoints": { "high": 100, "low": 0 },
            "bands": {
              "high": { "color": "#008000", "label": "" },
              "low": { "color": "#B22222", "label": "" },
              "medium": { "color": "#ffa500", "label": "" }
            }
          },
          "legend": {
            "descOrder": false,
            "showHeader": true,
            "show": true,
            "customSize": "auto",
            "position": "right-top",
            "inside": false
          },
          "axisMode": "multi",
          "tooltip": {
            "content": {
              "legend": {
                "showBinLabel": true,
                "measures": [],
                "showNullValues": true,
                "customizeLegend": false,
                "showPercentage": true,
                "showDimensions": true,
                "showMeasures": true,
                "dimensions": []
              }
            }
          },
          "visualizationType": "hbar",
          "title": {
            "fontSize": 14,
            "subtitleFontSize": 11,
            "label": "",
            "align": "center",
            "subtitleLabel": ""
          },
          "binValues": false,
          "trellis": {
            "flipLabels": false,
            "showGridLines": true,
            "size": [100, 100],
            "enable": false,
            "type": "x",
            "chartsPerLine": 4
          },
          "showActionMenu": true,
          "measureAxis2": {
            "sqrtScale": false,
            "showTitle": true,
            "showAxis": true,
            "title": "",
            "customDomain": { "showDomain": false }
          },
          "measureAxis1": {
            "sqrtScale": false,
            "showTitle": true,
            "showAxis": true,
            "title": "",
            "customDomain": { "showDomain": false }
          },
          "theme": "wave",
          "dimensionAxis": {
            "showTitle": true,
