    "Has_Been_Transferred_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "Has Been Transferred%",
      "numbers": [],
      "query": "q = load \"CMOS_Cases\";\nq = filter q by {{ column(Onboard_Team_Branch_2.selection, [\"Onboard.Team_Branch\"]).asEquality(\"IDR_Office__c\") }};\nresult = group q by ('Id', 'HasBeenTransferred');\nresult = foreach result generate q.'HasBeenTransferred' as 'HasBeenTransferred', count(q) as 'A', count(q) as 'C';\nresult = group result by 'HasBeenTransferred';\nresult = foreach result generate 'HasBeenTransferred', first(A) as 'A', first(C) as 'C', (sum(A)/sum(sum(A)) over ([..] partition by all)) as 'Perc';\n\n--Assume there will always be cases that have never been transferred\nresult = filter result by 'HasBeenTransferred' == \"false\";\nresult = foreach result generate result.'Perc' as 'D';\nresult = foreach result generate number_to_string(('D'), \"#0%\") as 'Result'\n",
