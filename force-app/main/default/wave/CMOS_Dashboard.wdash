      "label": "Clone of Has Been Escalated%",
      "numbers": [],
      "query": "q = load \"CMOS_Cases\";\nresult = group q by 'HasBeenTransferred';\nresult = foreach result generate q.'HasBeenTransferred' as 'HasBeenTransferred', count(q) as 'A', count(q) as 'C';\nresult = group result by 'HasBeenTransferred';\nresult = foreach result generate 'HasBeenTransferred', first(A) as 'A', first(C) as 'C', (sum(A)/sum(sum(A)) over ([..] partition by all)) as 'Perc';\n\nresult = foreach result generate (case when first('HasBeenTransferred') == \"true\" then 1 else result.'Perc' end) as 'D';\n\nresult = foreach result generate number_to_string('D', \"#%\") as 'Result'\n",
