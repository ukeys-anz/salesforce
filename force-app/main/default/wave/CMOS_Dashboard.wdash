    "IDR_Complaint_Remedy_1": {
      "broadcastFacet": true,
      "groups": ["Picklist.Remedy.Label"],
      "label": "Complaint Remedy %",
      "numbers": ["A", "Perc", "%"],
      "query": "q = load \"CMOS_Cases\";\nresult = group q by 'Picklist.Remedy.Label';\nresult = foreach result generate q.'Picklist.Remedy.Label' as 'Picklist.Remedy.Label', count(q) as 'A';\nresult = group result by 'Picklist.Remedy.Label';\nresult = foreach result generate 'Picklist.Remedy.Label', first(A) as 'A', sum(A)/sum(sum(A)) over ([..] partition by all) as 'Perc';\n\nresult = foreach result generate 'Picklist.Remedy.Label', A, Perc, round('Perc',3)*100 as '%';\n\n\nresult = limit result 2000;",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "strings": ["Picklist.Remedy.Label"],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "parameters": {
          "autoFitMode": "keepLabels",
          "centerText": "{{cell(IDR_Complaint_Remedy_1.result, 0, \"%\").asString()}}",
          "legend": {
            "descOrder": false,
            "showHeader": false,
            "show": true,
            "customSize": "auto",
            "position": "bottom-center",
            "inside": false
          },
          "showMeasureTitle": true,
          "tooltip": {
