    "Onboard_Region_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "Onboard_Region_1",
      "numbers": [],
      "query": "q = load \"CMOS_Historic_User_Data\";\nq = group q by ('EmployeeNumber', 'Onboard.Region');\n\nq = foreach q generate 'EmployeeNumber', 'Onboard.Region';\nq = group q by ('Onboard.Region');\nq = foreach q generate 'Onboard.Region' as 'Onboard.Region', count() as 'count';\nq = limit q 2000;",
