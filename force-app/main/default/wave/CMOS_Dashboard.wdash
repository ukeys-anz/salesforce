    "lens_3": {
      "broadcastFacet": true,
      "groups": [],
      "label": "lens_3",
      "numbers": [],
      "query": "q = load \"CMOS_Cases\";\nq = filter q by IsClosed == \"true\";\nq = filter q by {{row(min_max_dates_1.result, [0], [\"min_epoch\", \"max_epoch\"]).asDateRange(\"date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day')\")}};\nq = group q by Id;\nq = foreach q generate Id, ((( (min(ClosedDate_sec_epoch) - min(CreatedDate_sec_epoch)) / 60) /60 ) / 24) as 'avg_CaseDuration_Hours';\n\nq = group q by all;\nq = foreach q generate sum('avg_CaseDuration_Hours') / count() as 'avg_CaseDuration_Hours';\n\n\n--( max(ClosedDate_sec_epoch) - max(CreatedDate_sec_epoch) )/60/24 as 'avg_CaseDuration_Hours';\n\n",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
