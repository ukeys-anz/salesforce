    "Picklist_Type_Label_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "Picklist_Type_Label_1",
      "numbers": [],
      "query": "q = load \"CMOS_Cases\";\nq = filter q by {{row(min_max_dates_1.result, [0], [\"min_epoch\", \"max_epoch\"]).asDateRange(\"date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day')\")}};\nq = group q by ('Id', 'Picklist.Type.Label');\nq = foreach q generate 'Id', 'Picklist.Type.Label' as 'Picklist.Type.Label', count() as 'count';\n\nq = group q by 'Picklist.Type.Label';\nq = foreach q generate 'Picklist.Type.Label' as 'Picklist.Type.Label', count() as 'count';\nq = order q by 'Picklist.Type.Label' asc;\n",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "start": "[]",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
