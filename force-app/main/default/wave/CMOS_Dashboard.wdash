    "ResolvedFirstPointCo_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "ResolvedFirstPointContact%",
      "numbers": [],
      "query": "-- Collect total Cases.\nq = load \"CMOS_Cases\";\nq = filter q by {{row(min_max_dates_1.result, [0], [\"min_epoch\", \"max_epoch\"]).asDateRange(\"date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day')\")}};\nq = filter q by {{ column(Onboard_Team_Branch_2.selection, [\"Onboard.Team_Branch\"]).asEquality(\"IDR_Office__c\") }};\nq = filter q by 'IDR_Office__c' in all;\nq1 = group q by Id;\nq1 = foreach q1 generate Id, 1 as 'C';\nq1 = group q1 by all;\ntotal = foreach q1 generate sum('C') as 'Total';\n\n--Filter cases that are not auto esclated\nesc = foreach q generate case when 'IDR_Escalation_Reason__c' is null \nthen \"None\" else 'IDR_Escalation_Reason__c' end\nas 'IDR_Escalation_Reason__c', 'Id' as 'Id';\nesc = group esc by ('Id', 'IDR_Escalation_Reason__c');\nesc = foreach esc generate 'IDR_Escalation_Reason__c', count() as 'C';\nesc = group esc by 'IDR_Escalation_Reason__c';\nesc = filter esc by 'IDR_Escalation_Reason__c' != \"None\";\nesc = foreach esc generate 'IDR_Escalation_Reason__c', count() as 'C';\nesc = group esc by all;\nesc = foreach esc generate sum('C') as 'Filter';\n\n\n--Compare the total cases against the filtered cases\ncombine = union total, esc;\ncombine = group combine by all;\nresult = foreach combine generate \n1-(sum(sum(Filter)) over([..] partition by all) / sum(sum(Total)) over([..] partition by all) ) as 'percentile';\n\n\nresult = foreach result generate number_to_string(percentile, \"#%\") as 'perc';\n\n",
      "receiveFacetSource": {
        "mode": "exclude",
        "steps": ["Onboard_Team_Branch_2", "Onboard_Division_1"]
      },
      "selectMode": "single",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "parameters": {
          "autoFitMode": "keepLabels",
          "showValues": true,
          "bins": {
            "breakpoints": { "high": 100, "low": 0 },
            "bands": {
              "high": { "color": "#008000", "label": "" },
              "low": { "color": "#B22222", "label": "" },
