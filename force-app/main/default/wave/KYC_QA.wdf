["{\"nodes\":{\"sfdcDigest_Case\":{\"action\":\"sobjectDigest\",\"parameters\":{\"fields\":[{\"name\":\"Fraud_Customer_Details__c\"},{\"name\":\"Fraud_EV_Consent__c\"},{\"name\":\"Fraud_EV_Match__c\"},{\"name\":\"Fraud_EV_Rules_Met__c\"},{\"name\":\"Id\"},{\"name\":\"CaseNumber\"},{\"name\":\"Status\"},{\"name\":\"SLA_Status__c\"},{\"name\":\"Subject\"},{\"name\":\"Fraud_ID_True_Document__c\"},{\"name\":\"Fraud_ID_Legible__c\"},{\"name\":\"Fraud_PO_Box__c\"},{\"name\":\"Fraud_Customer_Photo_Modified__c\"},{\"name\":\"Fraud_ID_Not_Picture__c\"},{\"name\":\"Fraud_Middle_Name__c\"},{\"name\":\"Fraud_Security_Features__c\"},{\"name\":\"RecordTypeId\"},{\"name\":\"ClosedDate\"},{\"name\":\"IDR_Date_Received__c\"},{\"name\":\"CreatedDate\"}],\"object\":\"Case\"}},\"FilterOnlyKYCQA\":{\"action\":\"filter\",\"parameters\":{\"saqlFilter\":\"'Record.Name' in [\\\"KYC QA\\\"]\"},\"sources\":[\"JoinRecordName\"]},\"register_KYC QA\":{\"action\":\"register\",\"parameters\":{\"label\":\"KYC QA\",\"name\":\"KYC_QA\"},\"sources\":[\"TicketAge\"]},\"RecordType\":{\"action\":\"sobjectDigest\",\"parameters\":{\"fields\":[{\"name\":\"Id\"},{\"name\":\"Name\"}],\"object\":\"RecordType\"}},\"TicketAge\":{\"action\":\"computeExpression\",\"parameters\":{\"computedFields\":[{\"defaultValue\":\"0\",\"label\":\"CaseAge\",\"name\":\"CaseAge\",\"precision\":2,\"saqlExpression\":\"daysBetween(toDate('IDR_Date_Received__c', \\\"yyyy-MM-dd\\\") , now() )\",\"scale\":1,\"type\":\"Numeric\"}],\"mergeWithSource\":true},\"sources\":[\"FilterOnlyKYCQA\"]},\"JoinRecordName\":{\"action\":\"augment\",\"parameters\":{\"leftKey\":[\"RecordTypeId\"],\"operation\":\"LookupSingleValue\",\"relationship\":\"Record\",\"rightKey\":[\"Id\"],\"rightSelect\":[\"Name\"]},\"sources\":[\"sfdcDigest_Case\",\"RecordType\"]}}}",null]