["{\"nodes\":{\"CaseDigest\":{\"action\":\"sobjectDigest\",\"parameters\":{\"fields\":[{\"name\":\"CaseNumber\"},{\"name\":\"CaseNumber__c\"},{\"name\":\"ContactEmail\"},{\"name\":\"ContactId\"},{\"name\":\"CreatedById\"},{\"name\":\"CreatedDate\"},{\"name\":\"Fraud_Complicit_in_Fraud__c\"},{\"name\":\"Fraud_Customer_Event_Age__c\"},{\"name\":\"Fraud_Repeat_Victim__c\"},{\"name\":\"Fraud_Total_Customer_Loss__c\"},{\"name\":\"Fraud_Total_Falcon_Recalled__c\"},{\"name\":\"Fraud_Total_Fraud_Received__c\"},{\"name\":\"Fraud_Total_Fraud_Value__c\"},{\"name\":\"Fraud_Total_Recipient_Loss__c\"},{\"name\":\"Fraud_Total_Recovered__c\"},{\"name\":\"Fraud_Total_Reimbursed__c\"},{\"name\":\"Fraud_Total_Scam_Value__c\"},{\"name\":\"ClosedDate\"},{\"name\":\"Id\"},{\"name\":\"IsClosed\"},{\"name\":\"IsDeleted\"},{\"name\":\"IsEscalated\"},{\"name\":\"IsOwner__c\"},{\"name\":\"IsStopped\"},{\"name\":\"Origin\"},{\"name\":\"OwnerId\"},{\"name\":\"Priority\"},{\"name\":\"Reason\"},{\"name\":\"SLA_Status__c\"},{\"name\":\"SourceId\"},{\"name\":\"Subject\"},{\"name\":\"Sub_Type__c\"},{\"name\":\"Type\"},{\"name\":\"Product__c\"},{\"name\":\"ProductId\"},{\"name\":\"Status\"},{\"name\":\"IDR_Date_Received__c\"},{\"name\":\"RecordTypeId\"}],\"object\":\"Case\"}},\"CasesOutput\":{\"action\":\"register\",\"parameters\":{\"label\":\"Cases w/Duration\",\"name\":\"cases_duration\"},\"sources\":[\"ExcludeFraud\"]},\"CaseTypePickList\":{\"action\":\"sobjectDigest\",\"parameters\":{\"fields\":[{\"name\":\"DurableId\"},{\"name\":\"Label\"},{\"name\":\"Value\"},{\"name\":\"EntityParticleId\"}],\"object\":\"PicklistValueInfo\",\"passthroughFilter\":\"EntityParticleId = 'Case.Type'\",\"runtime\":{\"enablePKChunking\":false}}},\"Products\":{\"action\":\"sobjectDigest\",\"parameters\":{\"fields\":[{\"name\":\"ProductCode\"},{\"name\":\"Name\"},{\"name\":\"Id\"}],\"object\":\"Product2\"}},\"RecordType\":{\"action\":\"sobjectDigest\",\"parameters\":{\"fields\":[{\"name\":\"Name\"},{\"name\":\"Id\"}],\"object\":\"RecordType\"}},\"ExcludeFraud\":{\"action\":\"filter\",\"parameters\":{\"saqlFilter\":\"'Record.Name' not in [\\\"Fraud\\\", \\\"Identity\\\", \\\"Recipient/Mule\\\",\\\"Scam\\\"]\"},\"sources\":[\"AgedTicketsBucket\"]},\"JoinRecordType\":{\"action\":\"augment\",\"parameters\":{\"leftKey\":[\"RecordTypeId\"],\"operation\":\"LookupSingleValue\",\"relationship\":\"Record\",\"rightKey\":[\"Id\"],\"rightSelect\":[\"Name\"]},\"sources\":[\"MergeIssuePicklist\",\"RecordType\"]},\"AgedTicketsBucket\":{\"action\":\"computeExpression\",\"parameters\":{\"computedFields\":[{\"label\":\"AgedDates\",\"name\":\"AgedDates\",\"precision\":10,\"saqlExpression\":\"case\\nwhen daysBetween(toDate('IDR_Date_Received__c', \\\"yyyy-MM-dd\\\") , now() ) == 0 then \\\"0\\\"\\nwhen daysBetween(toDate('IDR_Date_Received__c', \\\"yyyy-MM-dd\\\") , now() ) == 1 then \\\"1\\\"\\nwhen daysBetween(toDate('IDR_Date_Received__c', \\\"yyyy-MM-dd\\\") , now() ) == 2 then \\\"2\\\"\\nwhen daysBetween(toDate('IDR_Date_Received__c', \\\"yyyy-MM-dd\\\") , now() ) == 3 then \\\"3\\\"\\nwhen daysBetween(toDate('IDR_Date_Received__c', \\\"yyyy-MM-dd\\\") , now() ) > 3 then \\\"4+\\\"\\nelse \\\"0\\\"\\nend\",\"type\":\"Text\"}],\"mergeWithSource\":true},\"sources\":[\"AddCaseStatusBucket\"]},\"MergeCaseProduct\":{\"action\":\"augment\",\"parameters\":{\"leftKey\":[\"ProductId\"],\"operation\":\"LookupSingleValue\",\"relationship\":\"Product\",\"rightKey\":[\"Id\"],\"rightSelect\":[\"Name\",\"Id\"]},\"sources\":[\"CaseDigest\",\"Products\"]},\"MergeIssuePicklist\":{\"action\":\"augment\",\"parameters\":{\"leftKey\":[\"Type\"],\"operation\":\"LookupSingleValue\",\"relationship\":\"Picklist.Type\",\"rightKey\":[\"Value\"],\"rightSelect\":[\"Label\"]},\"sources\":[\"MergeCaseProduct\",\"CaseTypePickList\"]},\"AddCaseStatusBucket\":{\"action\":\"computeExpression\",\"parameters\":{\"computedFields\":[{\"label\":\"Case Status Order\",\"name\":\"CaseStatusOrder\",\"saqlExpression\":\"case\\nwhen 'Status' == \\\"Open\\\" then \\\"1\\\"\\nwhen 'Status' == \\\"Re-opened\\\" then \\\"2\\\"\\nwhen 'Status' == \\\"Under Investigation\\\" then \\\"3\\\"\\nelse \\\"4\\\"\\nend\",\"type\":\"Text\"}],\"mergeWithSource\":true},\"sources\":[\"JoinRecordType\"]}}}",null]