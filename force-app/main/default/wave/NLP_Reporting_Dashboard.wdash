    "Prevalence___String_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "Prevalence % String",
      "numbers": [],
      "query": "q = load \"NLP_Cases\";\n-- Calc Positives\nP = filter q by 'isStopCollection' == \"true\";\nP = group P by isStopCollection;\nP = foreach P generate 'isStopCollection', count() as 'P';\n-- Calculates the True Negatives\nN = filter q by 'isStopCollection' == \"false\";\nN = group N by isStopCollection;\nN = foreach N generate 'isStopCollection', count() as 'N';\nresult = cogroup P by all full, N by all;\nresult = foreach result generate max(P.P) as 'P', max(N.N) as 'N';\nresult = foreach result generate number_to_string(P / (P + N), \"0.00%\") as 'Prevalence';",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "strings": [],
