    "IDR_StopCollectionsI_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "IDR_StopCollectionsI_1",
      "numbers": [],
      "query": "q = load \"NLP_Cases\";\nq = group q by 'isStopCollection';\nq = foreach q generate 'isStopCollection' as 'isStopCollection', count() as 'count';\nq = order q by 'isStopCollection' asc;\n",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
