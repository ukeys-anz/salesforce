  "steps": {
    "isStopCollectionFals_3": {
      "broadcastFacet": true,
      "datasets": [{ "name": "NLP_Cases" }],
      "isGlobal": false,
      "query": {
        "query": "{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"isStopCollectionFalsePositive\"]}",
        "version": -1.0
      },
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "type": "aggregateflex",
      "useGlobal": true,
      "visualizationParameters": {}
    },
    "PickList_Label_Sanke_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "PickList Label Sankey",
      "numbers": [],
      "query": "q = load \"NLP_Cases\";\nq = group q by 'isEditedByNLP';\nq = foreach q generate 'isEditedByNLP' as 'isEditedByNLP', count() as 'count';",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "parameters": {
          "autoFitMode": "keepLabels",
          "centerText": "",
          "showMeasureTitle": false,
          "legend": {
            "descOrder": false,
            "showHeader": true,
            "show": false,
            "customSize": "auto",
            "position": "right-top",
            "inside": false
          },
          "tooltip": {
            "showBinLabel": true,
            "measures": "",
            "showNullValues": true,
            "showPercentage": true,
            "showDimensions": true,
            "showMeasures": true,
            "customizeTooltip": false,
            "dimensions": ""
          },
          "visualizationType": "pie",
          "title": {
            "fontSize": 14,
            "subtitleFontSize": 11,
            "label": "Edited by NLP User",
            "align": "center",
            "subtitleLabel": ""
          },
          "trellis": {
            "flipLabels": false,
            "showGridLines": true,
            "size": [100, 100],
            "enable": false,
            "type": "x",
            "chartsPerLine": 4
          },
          "inner": 60,
          "columnMap": {
            "trellis": [],
            "dimension": ["isEditedByNLP"],
            "plots": ["count"]
          },
          "showActionMenu": true,
          "centerValueType": "none",
          "valueType": "percent",
          "theme": "wave",
          "applyConditionalFormatting": true
        },
        "type": "chart"
      }
    },
    "Picklist_Label_IDR_S_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "Picklist_Label_IDR_S_1",
      "numbers": [],
      "query": "q = load \"NLP_Cases\";\nq = filter q by 'Type' in [\"17\", \"19\", \"4\", \"5\"];\nq = filter q by 'isStopCollection' == \"true\";\nq = group q by ('Picklist.Label', 'IDR_Subsequent_Issue_Text');\nq = foreach q generate 'Picklist.Label' as 'Picklist.Label', 'IDR_Subsequent_Issue_Text' as 'IDR_Subsequent_Issue_Text', count() as 'count';\nq = order q by ('Picklist.Label' asc nulls last, 'IDR_Subsequent_Issue_Text' asc nulls last);\nq = limit q 2000;",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "parameters": {
          "autoFitMode": "keepLabels",
          "showDimensionTitle": false,
          "showValues": true,
          "bins": {
            "breakpoints": { "high": 100, "low": 0 },
            "bands": {
              "high": { "color": "#008000", "label": "" },
              "low": { "color": "#B22222", "label": "" },
              "medium": { "color": "#ffa500", "label": "" }
            }
          },
          "legend": {
            "descOrder": false,
            "showHeader": true,
            "show": true,
            "customSize": "auto",
            "position": "right-top",
            "inside": false
          },
          "axisMode": "multi",
          "tooltip": {
            "showBinLabel": true,
            "measures": ["count"],
            "showNullValues": false,
            "showPercentage": true,
            "showDimensions": false,
            "showMeasures": true,
            "customizeTooltip": true,
            "dimensions": ["Picklist.Label", "IDR_Subsequent_Issue_Text"]
          },
          "visualizationType": "sankey",
          "title": {
            "fontSize": 14,
            "subtitleFontSize": 11,
            "label": "",
            "align": "center",
            "subtitleLabel": ""
          },
          "binValues": false,
          "trellis": {
            "flipLabels": false,
            "showGridLines": true,
            "size": [100, 100],
            "enable": false,
            "type": "x",
            "chartsPerLine": 4
          },
          "showActionMenu": false,
          "showAbsoluteValues": true,
          "measureAxis2": {
            "sqrtScale": false,
            "showTitle": true,
            "showAxis": true,
            "title": "",
            "customDomain": { "showDomain": false }
          },
          "measureAxis1": {
