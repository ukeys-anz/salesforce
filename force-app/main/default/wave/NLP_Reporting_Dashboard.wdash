    "F1_Score___String_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "F1 Score % String",
      "numbers": [],
      "query": "q = load \"NLP_Cases\";\n--Calculate True Positives. This is done by checking if the Case is set to Stop Collection == true, minus the number of False Positives records;\nTP = filter q by ('isStopCollection' == \"true\");\nTP = group TP by isStopCollectionFalsePositive;\nTP = foreach TP generate 'isStopCollectionFalsePositive', count() as 'c';\nTP = foreach TP generate 'isStopCollectionFalsePositive', case when 'isStopCollectionFalsePositive' == \"true\" then -(c) else c end as 'c';\nTP = group TP by isStopCollectionFalsePositive;\nTP = foreach TP generate sum(sum(c)) over([..] partition by all) as 'TP';\n--Get False Positives\nFP = filter q by ('isStopCollectionFalsePositive' == \"true\");\nFP = group FP by isStopCollectionFalsePositive;\nFP = foreach FP generate isStopCollectionFalsePositive, count() as 'FP';\n--Get False Negatives\nFN = filter q by 'isCollectionFalseNegative' == \"true\";\nFN = group FN by isCollectionFalseNegative;\nFN = foreach FN generate count() as 'FN';\nresult = cogroup TP by all full, FN by all full, FP by all;\nresult = foreach result generate coalesce(max(FP.FP), 0) as 'FP', coalesce(max(FN.FN), 0) as 'FN', coalesce(max(TP.TP), 0) as 'TP';\nresult = foreach result generate number_to_string((2*TP) / (2*TP + FP + FN), \"0.00%\") as 'F1_Score';\n",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "parameters": {
          "autoFitMode": "keepLabels",
          "showValues": true,
          "bins": {
            "breakpoints": { "high": 100, "low": 0 },
            "bands": {
              "high": { "color": "#008000", "label": "" },
              "low": { "color": "#B22222", "label": "" },
              "medium": { "color": "#ffa500", "label": "" }
