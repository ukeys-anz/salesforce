          },
          "innerMajorBorderColor": "#3290ed",
          "innerMinorBorderColor": "#98c6f5",
          "mode": "fittocontainer",
          "numberOfLines": 1,
          "oddRowColor": "#ffffff",
          "showActionMenu": true,
          "showRowIndexColumn": false,
          "totals": true,
          "verticalPadding": 12
        },
        "type": "table"
      }
    },
