    "Clone_of_Overall_Hin_1": {
      "broadcastFacet": true,
      "datasets": [{ "name": "Quality_Assessment" }],
      "isGlobal": false,
      "label": "Clone of Overall Hindsight Test Results",
      "query": {
        "query": "{\"values\":[\"Name\",\"Score__c\"],\"filters\":[[\"RecordType.Name\",[\"Join\"],\"in\"],[\"Rating__c\",[\"Did Not Meet Expectations\",\"Exceeded Expectations\",\"Met Expectations\"],\"in\"]]}",
