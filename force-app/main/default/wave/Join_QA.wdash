    "year_Interaction_Dat_3": {
      "broadcastFacet": true,
      "groups": [],
      "label": "Month/Year Total",
      "numbers": [],
      "query": "q = load \"Quality_Assessment\";\nq = filter q by 'Interaction_Date_Time__c' in [\"1 year ago\"..\"current day\"];\nq = filter q by 'RecordType.Name' == \"Join\";\nq = group q by all;\nq = foreach q generate \"Total\" as 'Month/Year', \n    sum('Exceeded_Expectations') as 'Exceeded_Expectations', sum('Met_Expectations') as 'Met_Expectations', \n    sum('Did_Not_Meet') as 'Did_Not_Meet', avg('Score_p') as 'avg_Score_p';",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "parameters": {
          "borderColor": "#98c6f5",
          "borderWidth": 1,
          "cell": {
            "backgroundColor": "#ffffff",
            "fontColor": "#16325c",
            "fontSize": 12
          },
          "columnProperties": {},
          "columns": [],
          "customBulkActions": [],
          "evenRowColor": "#f4f6f9",
          "header": {
            "backgroundColor": "#1589ee",
            "fontColor": "#ffffff",
            "fontSize": 12
          },
          "innerMajorBorderColor": "#3290ed",
          "innerMinorBorderColor": "#98c6f5",
          "mode": "fittocontainer",
          "numberOfLines": 1,
          "oddRowColor": "#ffffff",
          "showActionMenu": true,
          "showRowIndexColumn": true,
          "totals": true,
          "verticalPadding": 12
        },
        "type": "table"
      }
    },
    "Summary_Table_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "Summary Table",
      "numbers": [],
      "query": "q = load \"Quality_Assessment\";\nq = filter q by 'RecordType.Name' == \"Join\";\nq = filter q by 'Interaction_Date_Time__c' in [\"12 months ago\"..\"current day\"];\nq = foreach q generate date_to_string('Interaction_Date_Time__c', \"yyyy-MM\") as 'Date_s', 'Did_Not_Meet', 'Met_Expectations', 'Exceeded_Expectations', 'Score_p';\nresult = group q by rollup('Date_s');\n\nresult = foreach result generate 'Date_s' as 'Date', sum(q.'Exceeded_Expectations') as 'Exceeded', sum(q.'Met_Expectations') as 'Met', sum(q.'Did_Not_Meet') as 'Did Not Meet', number_to_string(avg(q.'Score_p'), \"#.0#%\")  as 'Score__s';\n",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "parameters": {
          "borderColor": "#98c6f5",
          "borderWidth": 1,
          "cell": {
            "backgroundColor": "#ffffff",
            "fontColor": "#16325c",
            "fontSize": 12
          },
          "columnProperties": {},
          "columns": [],
