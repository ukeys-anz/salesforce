  "steps": {
    "Overall_Score_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "Overall Score",
      "numbers": [],
      "query": "q = load \"Quality_Assessment\";\nq = filter q by 'RecordType.Name' == \"Join\";\nresult = group q by ('Interaction_Date_Time__c_Year', 'Interaction_Date_Time__c_Month');\nresult = foreach result generate 'Interaction_Date_Time__c_Year' + \"/\" + 'Interaction_Date_Time__c_Month' as 'month_Interaction_Date_Time__c', avg(q.'Score__c') as 'A';\nresult = order result by ('month_Interaction_Date_Time__c' asc);\n",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "parameters": {
          "autoFitMode": "keepLabels",
          "showValues": true,
          "bins": {
            "breakpoints": { "high": 100, "low": 0 },
