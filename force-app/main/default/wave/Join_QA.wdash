      "numbers": [],
      "query": "q = load \"Quality_Assessment\";\nq = filter q by 'RecordType.Name' == \"Join\";\nq = filter q by 'Rating__c' in [\"Did Not Meet Expectations\", \"Exceeded Expectations\", \"Met Expectations\"];\nq = group q by ('Interaction_Date_Time__c_Year', 'Interaction_Date_Time__c_Month', 'Rating__c');\nq = foreach q generate 'Interaction_Date_Time__c_Year' as 'year_Interaction_Date_Time__c', 'Interaction_Date_Time__c_Month' as 'month_Interaction_Date_Time__c', 'Rating__c' as 'Rating__c', count() as 'count';\nq = order q by ('year_Interaction_Date_Time__c' asc, 'month_Interaction_Date_Time__c' asc, 'Rating__c' asc);\n",
