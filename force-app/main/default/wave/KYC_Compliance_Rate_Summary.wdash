      "groups": [],
      "label": "Defects Resolved  (All)",
      "numbers": [],
      "query": "q = load \"KYC_QA\";\nq = filter q by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_day_epoch') in [..\"1 month ago\"];\nq = filter q by Fraud_Defects_Rectified__c == \"Yes\" and IsClosed == \"true\";\nq = group q by all;\nq = foreach q generate count() as 'count';\n",
