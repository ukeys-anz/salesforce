      "label": "Compliance Over Time",
      "numbers": [],
      "query": "q = load \"KYC_QA\";\nq = filter q by {{row(Min_Date_Time_1.result, [0], [\"min_epoch_minus_6_month\", \"max_epoch\"]).asDateRange(\"date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day')\")}};\n result = foreach q generate 'Fraud_Defects_Rectified__c', ClosedDate_Month + \"~~~\" + ClosedDate_Year as 'Month~~~Year';\nresult = group result by ('Month~~~Year', 'Fraud_Defects_Rectified__c');\nresult = filter result by 'Month~~~Year' is not null;\nresult = foreach result generate 'Month~~~Year', 'Fraud_Defects_Rectified__c' as 'Fraud_Defects_Rectified__c', count() as 'A';\n\nresult = group result by ('Month~~~Year', 'Fraud_Defects_Rectified__c');\nresult = foreach result generate 'Month~~~Year', 'Fraud_Defects_Rectified__c', first(A) as 'A', sum(A)/sum(sum(A)) over ([..] partition by 'Month~~~Year') as 'perc';\nresult = foreach result generate 'Month~~~Year', case 'Fraud_Defects_Rectified__c' when \"Not Applicable\" then 'perc' else 0 end as 'Complaince Rate';\n\nresult = order result by 'Month~~~Year' desc;",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "start": "[]",
      "strings": [],
      "type": "saql",
      "useGlobal": false,
