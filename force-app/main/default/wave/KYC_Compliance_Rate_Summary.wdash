      "groups": [],
      "label": "QA completion SLA is Met Pie",
      "numbers": [],
      "query": "q = load \"KYC_QA\";\n q = filter q by CreatedDate_Month == \"{{cell(Min_Date_Time_1.result, 0, \"Month_Number\").asString()}}\" and CreatedDate_Year == \"{{cell(Min_Date_Time_1.result, 0, \"Year\").asString()}}\" ;\n q = foreach q generate 'Id',\ncase \nwhen Case_Hour_Duration__c is null then \"Red\"\nwhen (Case_Hour_Duration__c <= 16) then \"Green\"\nwhen (Case_Hour_Duration__c > 16 and Case_Hour_Duration__c <= 40) then \"Amber\"\nelse \"Red\" end as 'SLA';\n\nq = group q by 'SLA';\nq = foreach q generate 'SLA', count() as 'Count';\n",
