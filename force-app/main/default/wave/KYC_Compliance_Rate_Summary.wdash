    "Min_Date_Time_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "! Reporting Dates",
      "numbers": [],
      "query": "q = load \"KYC_QA\";\nq = group q by (ClosedDate_Month, ClosedDate_Year);\nq = foreach q generate case string_to_number(ClosedDate_Month)\nwhen 1 then \"January\"\nwhen 2 then \"February\"\nwhen 3 then \"March\"\nwhen 4 then \"April\" \nwhen 5 then \"May\" \nwhen 6 then \"June\"\nwhen 7 then \"July\"\nwhen 8 then \"August\"\nwhen 9 then \"September\"\nwhen 10 then \"October\"\nwhen 11 then \"November\"\nwhen 12 then \"December\"\nelse \"N/A\"\nend as 'Month',\n'ClosedDate_Year' as 'Year',\n'ClosedDate_Month' as 'Month_Number',\ntoString(toDate(min('ClosedDate_sec_epoch')),\"dd-MM-yyyy\") as 'max',\nmin('ClosedDate_sec_epoch')*1000 as 'min_epoch',\nmax('ClosedDate_sec_epoch')*1000 as 'max_epoch',\n\n-- Remove 6 months for the bottom graph and set it to the first day of that month.\ndate_to_epoch(toDate(\"01-\" + toString(toDate((min('ClosedDate_sec_epoch') - 60*60*24*180)), \"MM-yyyy\"), \"dd-MM-yyyy\"))*1000 as 'min_epoch_minus_6_month';",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "start": "[]",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "parameters": {
          "borderColor": "#e0e5ee",
          "borderWidth": 1,
          "cell": {
            "backgroundColor": "#ffffff",
            "fontColor": "#16325c",
            "fontSize": 12
          },
          "columnProperties": {},
          "columns": [],
          "customBulkActions": [],
          "header": {
            "backgroundColor": "#f4f6f9",
            "fontColor": "#16325c",
            "fontSize": 12
          },
          "innerMajorBorderColor": "#a8b7c7",
          "innerMinorBorderColor": "#e0e5ee",
          "maxColumnWidth": 300,
          "minColumnWidth": 40,
          "mode": "variable",
          "numberOfLines": 1,
          "showActionMenu": true,
          "totals": true,
          "verticalPadding": 8
        },
        "type": "table"
      }
    },
