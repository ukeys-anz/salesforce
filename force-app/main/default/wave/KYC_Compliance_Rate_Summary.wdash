  "steps": {
    "Compliance_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "Compliance Rate %",
      "numbers": [],
      "query": "q = load \"KYC_QA\";\nresult = group q by 'Fraud_Defects_Rectified__c';\nresult = foreach result generate q.'Fraud_Defects_Rectified__c' as 'Fraud_Defects_Rectified__c', count(q) as 'A';\nresult = group result by 'Fraud_Defects_Rectified__c';\n-- Get the percentile of each Rectified Result\nresult = foreach result generate 'Fraud_Defects_Rectified__c', first(A) as 'A', sum(A)/sum(sum(A)) over ([..] partition by all) as 'perc';\nresult = foreach result generate case 'Fraud_Defects_Rectified__c' when \"Not Applicable\" then 'perc' else 0 end as 'percentile';\nresult = group result by all;\n-- Convert to String %\nresult = foreach result generate case when first(percentile) == 0 then \"0%\" else number_to_string(sum(percentile), \"#.0%\") end as 'Perc';",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "parameters": {
          "borderColor": "#e0e5ee",
          "borderWidth": 1,
          "cell": {
            "backgroundColor": "#ffffff",
            "fontColor": "#16325c",
            "fontSize": 12
          },
          "columnProperties": {},
          "columns": [],
          "customBulkActions": [],
          "header": {
            "backgroundColor": "#f4f6f9",
            "fontColor": "#16325c",
            "fontSize": 12
          },
          "innerMajorBorderColor": "#a8b7c7",
          "innerMinorBorderColor": "#e0e5ee",
          "maxColumnWidth": 300,
          "minColumnWidth": 40,
          "mode": "variable",
          "numberOfLines": 1,
          "showActionMenu": true,
          "totals": true,
          "verticalPadding": 8
        },
        "type": "table"
      }
    },
    "SLA_Met__1": {
      "broadcastFacet": false,
      "groups": [],
      "label": "Compliance SLA Met? (Yes/No)",
      "numbers": [],
      "query": "q = load \"KYC_QA\";\nq = filter q by CreatedDate_Month == \"{{cell(Min_Date_Time_1.result, 0, \"Month_Number\").asString()}}\" and CreatedDate_Year == \"{{cell(Min_Date_Time_1.result, 0, \"Year\").asString()}}\" ;\n\nq = foreach q generate 'Id',\ncase \nwhen Case_Hour_Duration__c is null then \"Red\"\nwhen (Case_Hour_Duration__c <= 16) then \"Green\"\nwhen (Case_Hour_Duration__c > 16 and Case_Hour_Duration__c <= 40) then \"Amber\"\nelse \"Red\" end as 'SLA';\n\nq = group q by 'SLA';\nq = foreach q generate 'SLA', count() as 'A';\n\nq = group q by 'SLA';\nq = foreach q generate 'SLA', first(A) as 'A', sum(A)/sum(sum(A)) over ([..] partition by all) as 'perc';\n\n-- Test for all conditions and return the first one.\nq = foreach q generate last('SLA') as 'SLA', 'perc',\ncase when \n('SLA' == \"Green\" and perc > 80) then \"Yes\"\nwhen \n('SLA' == \"Amber\" and perc < 20) then \"Yes\"\nelse \"No\"\nend as 'SLA Met';\n\nq = order q by 'SLA Met' desc; \nq = limit q 1;\n",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "strings": [],
      "type": "saql",
      "useGlobal": false,
      "visualizationParameters": {
        "parameters": {
          "autoFitMode": "keepLabels",
          "showValues": true,
          "bins": {
            "breakpoints": { "high": 100, "low": 0 },
            "bands": {
              "high": { "color": "#008000", "label": "" },
              "low": { "color": "#B22222", "label": "" },
              "medium": { "color": "#ffa500", "label": "" }
            }
          },
          "legend": {
            "descOrder": false,
            "showHeader": true,
            "show": true,
            "customSize": "auto",
            "position": "right-top",
            "inside": false
          },
          "axisMode": "multi",
          "tooltip": {
            "content": {
              "legend": {
                "showBinLabel": true,
                "measures": [],
                "showNullValues": true,
                "customizeLegend": false,
                "showPercentage": true,
                "showDimensions": true,
                "showMeasures": true,
                "dimensions": []
              }
            }
          },
          "visualizationType": "hbar",
          "title": {
            "fontSize": 14,
            "subtitleFontSize": 11,
            "label": "",
            "align": "center",
            "subtitleLabel": ""
