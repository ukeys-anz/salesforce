    "Assessments_by_Role_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "Assessments by Role",
      "numbers": [],
      "query": "q = load \"Quality_Assessment\";\nq = filter q by 'RecordType.Name' == \"Get Help\";\nq = filter q by 'Owner.User.Name' in [\"Coach\", \"Support Coach\"];\nq = group q by 'Owner.User.Name';\nq = foreach q generate 'Owner.User.Name' as 'Role', count() as '# of Assessments';\nq = order q by 'Role' asc;\n",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "start": "[]",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "parameters": {
          "borderColor": "#98c6f5",
          "borderWidth": 1,
          "cell": {
            "backgroundColor": "#ffffff",
            "fontColor": "#16325c",
            "fontSize": 12
          },
          "columnProperties": {},
          "columns": [],
          "customBulkActions": [],
          "header": {
            "backgroundColor": "#1589ee",
            "fontColor": "#ffffff",
            "fontSize": 12
          },
          "innerMajorBorderColor": "#3290ed",
          "innerMinorBorderColor": "#98c6f5",
          "maxColumnWidth": 300,
          "minColumnWidth": 40,
          "mode": "variable",
          "numberOfLines": 1,
          "showActionMenu": true,
          "showRowIndexColumn": true,
          "totals": true,
          "verticalPadding": 8
        },
        "type": "table"
      }
    },
    "lens_3": {
      "broadcastFacet": true,
      "groups": [],
      "label": "lens_3",
      "numbers": [],
      "query": "q = load \"Quality_Assessment\";\nq = filter q by 'RecordType.Name' == \"Get Help\";\nq = group q by all;\nq = foreach q generate avg('Score__c') as 'avg_Score__c';\n\nq = foreach q generate \n(\n    case \n    when avg(avg_Score__c) > 89.9 then \"Outstanding\"\n    when avg(avg_Score__c) > 84.9 then \"Effective\"\n    when avg(avg_Score__c) > 70 then \"Almost there\"\n    else\n    \"Not there yet\"\n    end\n) as 'Rating';\nq = limit q 2000;",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "parameters": {
          "borderColor": "#e0e5ee",
          "borderWidth": 1,
          "cell": {
            "backgroundColor": "#ffffff",
            "fontColor": "#16325c",
            "fontSize": 12
          },
          "columnProperties": {},
          "columns": [],
          "customBulkActions": [],
          "header": {
            "backgroundColor": "#f4f6f9",
            "fontColor": "#16325c",
            "fontSize": 12
          },
          "innerMajorBorderColor": "#a8b7c7",
          "innerMinorBorderColor": "#e0e5ee",
          "maxColumnWidth": 300,
          "minColumnWidth": 40,
          "mode": "variable",
          "numberOfLines": 1,
          "showActionMenu": true,
          "showRowIndexColumn": false,
          "totals": true,
          "verticalPadding": 8
        },
        "type": "table"
      }
    },
