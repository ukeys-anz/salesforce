      "numbers": [],
      "query": "q = load \"Quality_Assessment\";\nq = filter q by 'RecordType.Name' == \"Get Help\";\nq = foreach q generate 'User.Name' as 'Coach'\n, 'User.UserRole.Name' as 'Skill'\n, 'User.FirstName' as 'Specialist'\n, 'Name' as 'QAN'\n, 'Case.CaseNumber' as 'Case Id'\n, 'Interaction_Type__c' as 'Interaction Type'\n, 'Interaction_Date_Time__c' as 'Segment Date'\n, 'Case.Status' as 'Case Status'\n, 'Status__c' as 'Assessment Status'\n, 'Advice_Outcome__c' as 'Outcome'\n, 'Compliance_Outcome__c' as 'Compliance'\n, 'Score__c' as 'Score';",
