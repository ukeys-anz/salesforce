          "innerMinorBorderColor": "#e0e5ee",
          "maxColumnWidth": 300,
          "minColumnWidth": 40,
          "mode": "variable",
          "numberOfLines": 1,
          "showActionMenu": true,
          "showRowIndexColumn": true,
          "totals": true,
          "verticalPadding": 8
        },
        "type": "table"
      }
    },
