    "QA_Evaluations_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "QA Evaluations",
      "numbers": [],
      "query": "q = load \"Quality_Assessment\";\nq = filter q by 'RecordType.Name' == \"Get Help\";\nq = foreach q generate 'Owner.Name' as 'Coach', 'Owner.User.Name' as 'Skill', 'Owner.FirstName' as 'Specialist', 'Name' as 'QAN', 'Case.CaseNumber' as 'Case Id', 'Interaction_Type__c' as 'Interaction Type', 'Interaction_Date_Time__c' as 'Segment Date', 'Case.Status' as 'Case Status', 'Status__c' as 'Assessment Status', 'Advice_Outcome__c' as 'Advice Outcome', 'Compliance_Outcome__c' as 'Compliance Outcome', 'Rating__c' as 'Rating', 'Score__c' as 'Score';\n--User.UserRole.Name' as 'Skill', ",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "parameters": {
          "borderColor": "#e0e5ee",
          "borderWidth": 1,
          "cell": {
            "backgroundColor": "#ffffff",
            "fontColor": "#16325c",
            "fontSize": 12
          },
          "columnProperties": {},
          "columns": [],
          "customBulkActions": [],
          "header": {
            "backgroundColor": "#f4f6f9",
            "fontColor": "#16325c",
            "fontSize": 12
          },
          "innerMajorBorderColor": "#a8b7c7",
          "innerMinorBorderColor": "#e0e5ee",
          "mode": "fittocontainer",
          "numberOfLines": 1,
          "showActionMenu": true,
          "showRowIndexColumn": true,
          "totals": true,
          "verticalPadding": 8
        },
        "type": "table"
      }
    },
    "Average_Score_by_Rat_1": {
      "broadcastFacet": true,
      "groups": [],
      "label": "Average Score by Rating",
      "numbers": [],
      "query": "q = load \"Quality_Assessment\";\nq = filter q by 'RecordType.Name' == \"Get Help\";\nq = group q by 'Rating__c';\nq = foreach q generate 'Rating__c' as 'Rating__c', number_to_string(avg('Score__c')/100, \"00.00%\") as 'Average Score';\nq = order q by 'Rating__c' asc;\n",
      "receiveFacetSource": { "mode": "all", "steps": [] },
      "selectMode": "single",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "parameters": {
          "borderColor": "#e0e5ee",
          "borderWidth": 1,
          "cell": {
            "backgroundColor": "#ffffff",
            "fontColor": "#16325c",
            "fontSize": 12
          },
          "columnProperties": {},
          "columns": [],
          "customBulkActions": [],
          "header": {
