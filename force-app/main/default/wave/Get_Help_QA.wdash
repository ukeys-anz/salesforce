      "numbers": [],
      "query": "q = load \"Quality_Assessment\";\nq = filter q by 'RecordType.Name' == \"Get Help\";\nq = group q by all;\nq = foreach q generate\n(\n   case\n   when avg(Score__c) > 89.9 then \"Outstanding\"\n   when avg(Score__c) > 84.9 then \"Effective\"\n   when avg(Score__c) > 69.9 then \"Almost there\"\n   else\n   \"Not there yet\"\n   end\n) as 'Rating';",
