<?xml version="1.0" encoding="UTF-8"?>
<EscalationRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <escalationRule>
        <fullName>Case Escalation</fullName>
        <active>true</active>
        <ruleEntry>
            <businessHours>Case Business Hours</businessHours>
            <businessHoursSource>Static</businessHoursSource>
            <escalationAction>
                <assignedTo>CRC_Team</assignedTo>
                <assignedToType>Queue</assignedToType>
                <minutesToEscalation>4320</minutesToEscalation>
                <notifyCaseOwner>false</notifyCaseOwner>
            </escalationAction>
            <escalationStartTime>CaseCreation</escalationStartTime>
            <formula>AND(
	OR(
		RecordType.DeveloperName = &apos;Customer_Complaint&apos;,
		RecordType.DeveloperName = &apos;Non_Customer_Complaint&apos;
	),
	IsEscalated = False,
	IsClosed = False,
	ISPICKVAL(Status, &apos;Open&apos;),
	Owner:User.Business_Role__c &lt;&gt; &apos;Customer Resolution&apos;		
)</formula>
        </ruleEntry>
        <ruleEntry>
            <businessHours>Case Business Hours</businessHours>
            <businessHoursSource>Static</businessHoursSource>
            <escalationAction>
                <assignedTo>CRC_Team</assignedTo>
                <assignedToType>Queue</assignedToType>
                <minutesToEscalation>7200</minutesToEscalation>
                <notifyCaseOwner>false</notifyCaseOwner>
            </escalationAction>
            <escalationStartTime>CaseCreation</escalationStartTime>
            <formula>AND(
	OR(
		RecordType.DeveloperName = &apos;Customer_Complaint&apos;,
		RecordType.DeveloperName = &apos;Non_Customer_Complaint&apos;
	),
	IsEscalated = False,
	IsClosed = False,
	OR(
		ISPICKVAL(Status, &apos;Open&apos;),
		ISPICKVAL(Status, &apos;Under Investigation&apos;)
	),
	Owner:User.Business_Role__c &lt;&gt; &apos;Customer Resolution&apos;		
)</formula>
        </ruleEntry>
    </escalationRule>
</EscalationRules>
