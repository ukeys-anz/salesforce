/**
 * @author Boobalakrishnan Duraisamy
 * @since 05/2023
 * @description To unit test CCRM FinServ__AccountAccountRelation__c actions
 */
@isTest
public with sharing class CCRMAccountAccountRelationActionsTest {
  @testSetup
  static void makeData() {
    Faker faker = new Faker('AU');
    System.runAs(CCRMTestDataFactory.getOCVIntegrationUser()) {
      List<Account> accountList = new List<Account>();
      for (Integer i = 0; i < Integer.valueOf(Label.Test_Bulk_Size); i++) {
        accountList.add(
          new Account(
            Name = faker.randomString(6),
            OCV_Id__c = faker.randomString(10),
            External_Id__c = faker.randomString(10),
            RecordTypeId = CCRMConstants.ACCOUNT_ORGANISATION_BUSINESS_RT_ID
          )
        );
      }
      insert accountList;

      FinServ__ReciprocalRole__c nonReciprocalRole = new FinServ__ReciprocalRole__c(
        RecordTypeId = CCRMConstants.RECIPROCAL_ACCOUNT_ROLE_RT_ID,
        Name = 'Also Known As',
        FinServ__InverseRole__c = 'Also Known As',
        OCV_Role__c = 'Also Known As',
        FinServ__CreateInverseRole__c = false
      );
      insert nonReciprocalRole;

      FinServ__ReciprocalRole__c reciprocalRole = new FinServ__ReciprocalRole__c(
        RecordTypeId = CCRMConstants.RECIPROCAL_ACCOUNT_ROLE_RT_ID,
        Name = 'Husband',
        FinServ__InverseRole__c = 'Wife',
        OCV_Role__c = 'Husband',
        FinServ__CreateInverseRole__c = true
      );
      insert reciprocalRole;

      FinServ__ReciprocalRole__c reciprocalInverseRole = new FinServ__ReciprocalRole__c(
        RecordTypeId = CCRMConstants.RECIPROCAL_ACCOUNT_ROLE_RT_ID,
        Name = 'Wife',
        FinServ__InverseRole__c = 'Husband',
        OCV_Role__c = 'Wife',
        FinServ__CreateInverseRole__c = false,
        FinServ__InverseRelationship__c = reciprocalRole.Id
      );
      insert reciprocalInverseRole;

      reciprocalRole.FinServ__InverseRelationship__c = reciprocalInverseRole.Id;
      update reciprocalRole;
    }
  }
  @isTest
  static void nonReciprocalExternalIdTest() {
    //GIVEN list of person accounts
    List<Account> accounts = [
      SELECT Id, External_Id__c, Name
      FROM Account
      WHERE RecordTypeId = :CCRMConstants.ACCOUNT_ORGANISATION_BUSINESS_RT_ID
    ];

    FinServ__AccountAccountRelation__c accountToAccount;
    System.runAs(CCRMTestDataFactory.getOCVIntegrationUser()) {
      //WHEN mulesoft inserts non reciprocal account to account relationship
      accountToAccount = new FinServ__AccountAccountRelation__c(
        FinServ__Account__c = accounts[0].Id,
        FinServ__RelatedAccount__c = accounts[1].Id,
        External_Id__c = accounts[0].External_Id__c +
          '_' +
          accounts[1].External_Id__c +
          '_' +
          'AlsoKnownAs',
        OCV_Role__c = 'Also Known As'
      );
      insert accountToAccount;
    }
    FinServ__AccountAccountRelation__c autoGeneratedRecord = [
      SELECT Id, External_ID__c, FinServ__Role__r.Name
      FROM FinServ__AccountAccountRelation__c
      WHERE Id != :accountToAccount.Id
    ];

    //THEN the external ID is populated based on the combination of person account External ID and Reciprocal role name.
    Assert.areEqual(
      accounts[1].External_Id__c +
        '_' +
        accounts[0].External_Id__c +
        '_' +
        autoGeneratedRecord.FinServ__Role__r.Name.replace(' ', ''),
      autoGeneratedRecord.External_Id__c,
      'Account To Account External ID should be a combination of External ids and role name'
    );

    //WHEN a relationship is end-dated
    System.runAs(CCRMTestDataFactory.getOCVIntegrationUser()) {
      Test.startTest();
      update new FinServ__AccountAccountRelation__c(
        Id = accountToAccount.Id,
        FinServ__EndDate__c = System.today(),
        FinServ__Active__c = false
      );
      Test.stopTest();
    }

    //THEN the both the relationship and its inverse relationship are deleted
    Assert.areEqual(
      0,
      [
        SELECT COUNT()
        FROM FinServ__AccountAccountRelation__c
        WHERE Id = :accountToAccount.Id OR Id = :autoGeneratedRecord.Id
      ],
      'Both the relationship and its inverse relationship should have been deleted'
    );
  }

  @isTest
  static void reciprocalExternalIdTest() {
    //GIVEN list of person accounts
    List<Account> accounts = [
      SELECT Id, External_Id__c, Name
      FROM Account
      WHERE RecordTypeId = :CCRMConstants.ACCOUNT_ORGANISATION_BUSINESS_RT_ID
    ];

    FinServ__AccountAccountRelation__c accountToAccount;
    System.runAs(CCRMTestDataFactory.getOCVIntegrationUser()) {
      Test.startTest();

      //WHEN mulesoft inserts reciprocal account to account relationship
      accountToAccount = new FinServ__AccountAccountRelation__c(
        FinServ__Account__c = accounts[0].Id,
        FinServ__RelatedAccount__c = accounts[1].Id,
        External_Id__c = accounts[0].External_Id__c +
          '_' +
          accounts[1].External_Id__c +
          '_' +
          'Husband',
        OCV_Role__c = 'Husband'
      );
      insert accountToAccount;
      Test.stopTest();
    }
    FinServ__AccountAccountRelation__c autoGeneratedRecord = [
      SELECT Id, External_ID__c, FinServ__Role__r.Name
      FROM FinServ__AccountAccountRelation__c
      WHERE Id != :accountToAccount.Id
    ];

    //THEN the external ID is populated based on the combination of person account External ID and Reciprocal role name.
    Assert.areEqual(
      accounts[1].External_Id__c +
        '_' +
        accounts[0].External_Id__c +
        '_' +
        autoGeneratedRecord.FinServ__Role__r.Name,
      autoGeneratedRecord.External_ID__c,
      'Account To Account External ID should be a combination of external ids and role name'
    );
  }

  @isTest
  static void invalidOCVRoleIdTest() {
    //GIVEN list of person accounts
    List<Account> accounts = [
      SELECT Id, External_Id__c, Name
      FROM Account
      WHERE RecordTypeId = :CCRMConstants.ACCOUNT_ORGANISATION_BUSINESS_RT_ID
    ];

    System.runAs(CCRMTestDataFactory.getOCVIntegrationUser()) {
      Test.startTest();
      try {
        //WHEN mulesoft inserts non reciprocal account to account relationship with invalid OCV Role id
        FinServ__AccountAccountRelation__c accountToAccount = new FinServ__AccountAccountRelation__c(
          FinServ__Account__c = accounts[0].Id,
          FinServ__RelatedAccount__c = accounts[1].Id,
          External_Id__c = accounts[0].External_Id__c +
            '_' +
            accounts[1].External_Id__c +
            '_' +
            'InvalidId',
          OCV_Role__c = 'Invalid Id'
        );
        insert accountToAccount;
      } catch (DmlException e) {
        //THEN the invalid ocv role id error is thrown
        Assert.areEqual(
          true,
          e.getMessage().contains(CCRMConstants.INVALID_OCV_ROLE_ERROR_MESSAGE),
          'Exception should be thrown when OCV Role is invalid (no corresponding Reciprocal Role record)'
        );
      }
      Test.stopTest();
    }
  }
}
