/**
 * @author Boobalakrishnan Duraisamy
 * @since 05/2023
 * @description To unit test CCRM FinServ__ContactContactRelation__c actions
 */
@isTest
public with sharing class CCRMContactToContactActionsTest {
  @testSetup
  static void makeData() {
    Faker faker = new Faker('AU');
    User ocvIntegrationUser = CCRMTestDataFactory.createOCVIntegrationUser();
    System.runAs(ocvIntegrationUser) {
      List<Account> accountList = new List<Account>();
      for (Integer i = 0; i < Integer.valueOf(Label.Test_Bulk_Size); i++) {
        accountList.add(
          new Account(
            FirstName = 'John',
            LastName = faker.randomString(6),
            OCV_Id__c = faker.randomString(10),
            External_Id__c = faker.randomString(10),
            RecordTypeId = GetHelpConstants.ACCOUNT_PERSON_ACCOUNT_RT_ID
          )
        );
      }
      insert accountList;

      FinServ__ReciprocalRole__c nonReciprocalRole = new FinServ__ReciprocalRole__c(
        RecordTypeId = CCRMConstants.RECIPROCAL_CONTACT_ROLE_RT_ID,
        Name = 'Also Known As',
        FinServ__InverseRole__c = 'Also Known As',
        OCV_Role__c = 'Also Known As',
        FinServ__CreateInverseRole__c = false
      );
      insert nonReciprocalRole;

      FinServ__ReciprocalRole__c reciprocalRole = new FinServ__ReciprocalRole__c(
        RecordTypeId = CCRMConstants.RECIPROCAL_CONTACT_ROLE_RT_ID,
        Name = 'Husband',
        FinServ__InverseRole__c = 'Wife',
        OCV_Role__c = 'Husband',
        FinServ__CreateInverseRole__c = true
      );
      insert reciprocalRole;

      FinServ__ReciprocalRole__c reciprocalInverseRole = new FinServ__ReciprocalRole__c(
        RecordTypeId = CCRMConstants.RECIPROCAL_CONTACT_ROLE_RT_ID,
        Name = 'Wife',
        FinServ__InverseRole__c = 'Husband',
        OCV_Role__c = 'Wife',
        FinServ__CreateInverseRole__c = false,
        FinServ__InverseRelationship__c = reciprocalRole.Id
      );
      insert reciprocalInverseRole;

      reciprocalRole.FinServ__InverseRelationship__c = reciprocalInverseRole.Id;
      update reciprocalRole;
    }
  }
  @isTest
  static void nonReciprocalExternalIdTest() {
    User ocvIntegrationUser = [
      SELECT Id
      FROM User
      WHERE FirstName = 'IntegrationUserOCV'
      ORDER BY LastModifiedDate DESC
      LIMIT 1
    ];
    //GIVEN list of person accounts
    List<Account> personAccounts = [
      SELECT Id, External_Id__c, Name, PersonContactId
      FROM Account
      WHERE RecordTypeId = :GetHelpConstants.ACCOUNT_PERSON_ACCOUNT_RT_ID
    ];

    FinServ__ContactContactRelation__c contactToContact;
    System.runAs(ocvIntegrationUser) {
      Test.startTest();

      //WHEN mulesoft inserts non reciprocal contact to contact relationship
      contactToContact = new FinServ__ContactContactRelation__c(
        FinServ__Contact__c = personAccounts[0].PersonContactId,
        FinServ__RelatedContact__c = personAccounts[1].PersonContactId,
        External_Id__c = personAccounts[0].External_Id__c +
          '_' +
          personAccounts[1].External_Id__c +
          '_' +
          'AlsoKnownAs',
        OCV_Role__c = 'Also Known As'
      );
      insert contactToContact;
      Test.stopTest();
    }
    FinServ__ContactContactRelation__c autoGeneratedRecord = [
      SELECT Id, External_ID__c, FinServ__Role__r.Name
      FROM FinServ__ContactContactRelation__c
      WHERE Id != :contactToContact.Id
    ];

    //THEN the external ID is populated based on the combination of person contact External ID and Reciprocal role name.
    Assert.areEqual(
      personAccounts[1].External_Id__c +
      '_' +
      personAccounts[0].External_Id__c +
      '_' +
      autoGeneratedRecord.FinServ__Role__r.Name.replace(' ', ''),
      autoGeneratedRecord.External_Id__c,
      'Contact To Contact External ID should be a combination of External ids and role name'
    );
  }
  @isTest
  static void reciprocalExternalIdTest() {
    User ocvIntegrationUser = [
      SELECT Id
      FROM User
      WHERE FirstName = 'IntegrationUserOCV'
      ORDER BY Name DESC
      LIMIT 1
    ];
    //GIVEN list of person accounts
    List<Account> personAccounts = [
      SELECT Id, External_Id__c, Name, PersonContactId
      FROM Account
      WHERE RecordTypeId = :GetHelpConstants.ACCOUNT_PERSON_ACCOUNT_RT_ID
    ];

    FinServ__ContactContactRelation__c contactToContact;
    System.runAs(ocvIntegrationUser) {
      Test.startTest();

      //WHEN mulesoft inserts reciprocal contact to contact relationship
      contactToContact = new FinServ__ContactContactRelation__c(
        FinServ__Contact__c = personAccounts[0].PersonContactId,
        FinServ__RelatedContact__c = personAccounts[1].PersonContactId,
        External_Id__c = personAccounts[0].External_Id__c +
          '_' +
          personAccounts[1].External_Id__c +
          '_' +
          'Husband',
        OCV_Role__c = 'Husband'
      );
      insert contactToContact;
      Test.stopTest();
    }
    FinServ__ContactContactRelation__c autoGeneratedRecord = [
      SELECT Id, External_ID__c, FinServ__Role__r.Name
      FROM FinServ__ContactContactRelation__c
      WHERE Id != :contactToContact.Id
    ];

    //THEN the external ID is populated based on the combination of person contact External ID and Reciprocal role name.
    Assert.areEqual(
      personAccounts[0].External_Id__c +
      '_' +
      personAccounts[1].External_Id__c +
      '_' +
      autoGeneratedRecord.FinServ__Role__r.Name,
      autoGeneratedRecord.External_ID__c,
      'Contact To Contact External ID should be a combination of external ids and role name'
    );
  }

  @isTest
  static void invalidOCVRoleIdTest() {
    User ocvIntegrationUser = [
      SELECT Id
      FROM User
      WHERE FirstName = 'IntegrationUserOCV'
      ORDER BY LastModifiedDate DESC
      LIMIT 1
    ];
    //GIVEN list of person accounts
    List<Account> personAccounts = [
      SELECT Id, External_Id__c, Name, PersonContactId
      FROM Account
      WHERE RecordTypeId = :GetHelpConstants.ACCOUNT_PERSON_ACCOUNT_RT_ID
    ];

    System.runAs(ocvIntegrationUser) {
      Test.startTest();
      try {
        //WHEN mulesoft inserts non reciprocal contact to contact relationship with invalid OCV Role id
        FinServ__ContactContactRelation__c contactToContact = new FinServ__ContactContactRelation__c(
          FinServ__Contact__c = personAccounts[0].PersonContactId,
          FinServ__RelatedContact__c = personAccounts[1].PersonContactId,
          External_Id__c = personAccounts[0].External_Id__c +
            '_' +
            personAccounts[1].External_Id__c +
            '_' +
            'AlsoKnownAs',
          OCV_Role__c = 'InvalidId'
        );
        insert contactToContact;
      } catch (DmlException e) {
        //THEN the invalid ocv role id error is thrown
        Assert.areEqual(
          true,
          e.getMessage().contains(CCRMConstants.INVALID_OCV_ROLE_ERROR_MESSAGE)
        );
      }
      Test.stopTest();
    }
  }
}
