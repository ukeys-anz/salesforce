<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <description>Generic JSON Configuration Layout</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__UrlAddressable</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage, lightning__RecordPage, lightning__HomePage">
            <property name="ApexController" type="String" description="Apex Class that extends GenericClass"/>
            <property name="SchemaConfig" type="String" description="Static Resource Name for Schema Config"/>
            <property name="recordId" type="String" description="Debug with a specified record"/>
            <property name="CSSStyleFile" type="String" description="CSS file reference from GenericComponentAssets Archive" default=""/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>