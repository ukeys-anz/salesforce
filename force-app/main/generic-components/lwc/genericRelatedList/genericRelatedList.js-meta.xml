<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage, lightning__RecordPage, lightning__HomePage">
            <property name="ApexController" type="String" description="Apex Class that extends GenericClass" />
            <property name="SchemaConfig" type="String" description="Static Resource Name for Schema Config" />
            <property name="RelatedListTitle" type="String" description="Title to display above related list" />
            <property name="titleIcon" type="String" description="Icon to display with title"/>
            <property name="TargetKey" type="String" description="Target Key of data set to extract value must be node's path"/>
            <property name="recordId" type="String" description="Debug with a specified record"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>